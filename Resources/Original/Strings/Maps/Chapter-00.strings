"01-00-000" = "5";

"Title-00" = "没有记录";

"Condition-Lose" = "";
"Condition-Win" = "";

"00-01-001-Id" = "1";
"00-01-001" = "儿臣索尔，觐见斧王陛下。";
"00-01-002-Id" = "99";
"00-01-002" = "你来啦！起来起来，这里没有别人，不用多礼。";
"00-01-003-Id" = "1";
"00-01-003" = "多谢父王。";
"00-01-004-Id" = "99";
"00-01-004" = "到这里来，让父王好好看看你。这阵子国务繁忙，我们父子两个也很久没聚聚了。";
"00-01-005-Id" = "98";
"00-01-005" = "是啊，我们一家人，难得这样在一起。";
"00-01-006-Id" = "1";
"00-01-006" = "是。";

"00-02-001-Id" = "99";
"00-02-001" = "索尔，时间过得真快，你已经长得这么高了。大臣和将领们对你的武艺和能力也赞赏有加，我想，也该是决定王位继承人的时候了。";
"00-02-002-Id" = "1";
"00-02-002" = "是的，父王，想必是由皇弟迪恩接任王位，儿臣不胜欢喜。";
"00-02-003-Id" = "99";
"00-02-003" = "错了，索尔，朕希望能由你来接任特罗蒂亚的王位。";
"00-02-004-Id" = "1";
"00-02-004" = "啊？儿。。儿臣我来接任王位？";
"00-02-005-Id" = "99";
"00-02-005" = "是的，索尔。你对朕的决定有什么疑问吗？";
"00-02-006-Id" = "1";
"00-02-006" = "儿臣不敢。但。。。。。。但是，父王，儿臣并未继承特罗蒂亚王家的血脉，照理来说，儿臣以为应该由皇弟迪恩来继承王位。。。。";
"00-02-007-Id" = "9";
"00-02-007" = "索尔，这是一个属于强者的时代。只有强者才能掌握军队、统治国家，维持世界的和平和人民的福祉。特罗蒂亚需要一个强有力的统治者。我相信你能接替我继承王位————而且也只有你才能继承王位。";
"00-02-008-Id" = "1";
"00-02-008" = "可是，皇弟他。。。";
"00-02-009-Id" = "99";
"00-02-009" = "迪恩他和你不一样。迪恩是个聪明的孩子，可以成为贤明的君主，但是他长得太文弱了，无法穿着重甲、统帅大军在战场上奔驰。我还记得当我还是个孩子时所发生的事情，所以为了特罗蒂亚王族，为了特罗蒂亚王国的人民，我希望你能成为王位继承人。";
"00-02-010-Id" = "98";
"00-02-010" = "是的。索尔，这些年来，我们把你当成自己亲身的孩子抚养长大，这件事也是经过慎重考虑之后才决定的，希望你能够答应。";
"00-02-011-Id" = "1";
"00-02-011" = "儿臣。。儿臣。。。";
"00-02-012-Id" = "99";
"00-02-012" = "我就知道你会一时无法接受，这样吧，三天之后，你再给我考虑的结果，当然了，我希望能够听到肯定的答复。你先回去休息吧。";
"00-02-013-Id" = "1";
"00-02-013" = "。。是的。儿臣告退。。";

"00-03-001-Id" = "3";
"00-03-001" = "哈！找你找了半天，居然是躲在这里打瞌睡，真是一点都不像你的作风。";
"00-03-002-Id" = "1";
"00-03-002" = "。。。。";
"00-03-003-Id" = "3";
"00-03-003" = "怎么啦？你今天好像有点不太对劲？";
"00-03-004-Id" = "1";
"00-03-004" = "。。。唉！";
"00-03-005-Id" = "3";
"00-03-005" = "嘿！待会儿是不是要打雷了。你居然在叹气！我看我们得好好谈一谈了！";

"00-04-001-Id" = "3";
"00-04-001" = "索尔，到底是发生什么事了？";
"00-04-002-Id" = "1";
"00-04-002" = "。。其实也没什么啦。";
"00-04-003-Id" = "3";
"00-04-003" = "少装啦！这世界上能让你叹气的事绝对不会超过十件。说来听听吧！";
"00-04-004-Id" = "1";
"00-04-004" = "。。父王叫我继承王位。";
"00-04-005-Id" = "3";
"00-04-005" = "嘎？";
"00-04-006-Id" = "1";
"00-04-006" = "没听清楚吗？父王要我继承王位。";
"00-04-007-Id" = "3";
"00-04-007" = "嘎？。。这。。这有什么好叹气的？特罗蒂亚的准王位继承人。。。。这要好好庆祝一下才是啊！";
"00-04-008-Id" = "1";
"00-04-008" = "笨蛋！枉费我们从小一起长大，你竟然一点都不了解我！";
"00-04-009-Id" = "3";
"00-04-009" = "啊？这怎么说呢？";
"00-04-010-Id" = "1";
"00-04-010" = "我怎么会喜欢国王一职！整天待在王城里哪里也不能去还得管理繁琐的政务、应付啰嗦的大臣和官员。。。。哪有什么乐趣！";
"00-04-011-Id" = "3";
"00-04-011" = "以你的个性来说。。这样讲也没错。";
"00-04-012-Id" = "1";
"00-04-012" = "我从小想做的事，就是到外地去做几次轰轰烈烈的冒险，绝对不是枯坐在王位上终老一生！我只是父王的养子，和特罗蒂亚没有血缘关系，所以我一直以为会由皇弟迪恩继承王位，我就可以落得轻松，哪知。。唉！";
"00-04-013-Id" = "3";
"00-04-013" = "这就没办法啦。你已经被迫答应了吗？";
"00-04-014-Id" = "1";
"00-04-014" = "父王要我三天后给他答复，但是我能说不吗？这和答应了有什么两样！";
"00-04-015-Id" = "3";
"00-04-015" = "说的也是。。只可惜这件事我帮不上什么忙。";
"00-04-016-Id" = "1";
"00-04-016" = "唉！如果你想帮忙的话，现在就陪我到后山去练剑，痛快的打上一场之后，也许我会觉得好过一点。";
"00-04-017-Id" = "3";
"00-04-017" = "这是小事一桩！我们现在就走吧！";

"00-05-001-Id" = "1";
"00-05-001" = "亚雷斯，赶快再来比一场！昨天输给你，我越想越觉得不甘。";
"00-05-002-Id" = "3";
"00-05-002" = "赢了就是赢了，何况你已经打赢我十几场，让我一场有什么关系！";
"00-05-003-Id" = "1";
"00-05-003" = "这可不一样！我老爸说过，剑技要不断磨练才会进步。。。。";
"00-05-004-Id" = "3";
"00-05-004" = "拜托，今天休息吧！风和日丽的日子，躺在草地上晒晒太阳，不是也很惬意？";
"00-05-005-Id" = "1";
"00-05-005" = "好吧，既然如此，我回去找侍卫们练习也可以！";
"00-05-006-Id" = "3";
"00-05-006" = "咦，那是什么东西？";
"00-05-007-Id" = "1";
"00-05-007" = "怎么了？";

"00-06-001-Id" = "1";
"00-06-001" = "好像是有人昏倒在地呢！";
"00-06-002-Id" = "3";
"00-06-002" = "是啊，旁边那个大家伙又是什么？";

"00-07-001-Id" = "4";
"00-07-001" = "不要再接近！#否则我将照规定采取防卫行动！";
"00-07-002-Id" = "3";
"00-07-002" = "搞什么嘛！";
"00-07-003-Id" = "2";
"00-07-003" = "嗯，好痛。。。";
"00-07-004-Id" = "3";
"00-07-004" = "是女孩子呢！";
"00-07-005-Id" = "1";
"00-07-005" = "我去看看";

"00-08-001-Id" = "1";
"00-08-001" = "小。。小姐，你没事吧！";
"00-08-002-Id" = "2";
"00-08-002" = "你。。你是谁？#这里是哪里？";
"00-08-003-Id" = "1";
"00-08-003" = "这里是特罗蒂亚，我叫索尔。请问小姐你的芳名？";
"00-08-004-Id" = "2";
"00-08-004" = "我叫。。我叫。。悠妮吧。#我怎么会来到这里的？";
"00-08-005-Id" = "1";
"00-08-005" = "悠妮？好名字。悠妮小姐，你怎么会记不得怎么来到这里的？";
"00-08-006-Id" = "2";
"00-08-006" = ".。。。真的想不起来了，只记得。。只记得我好像是从很远很远的地方来的。盖亚？";

"00-09-001-Id" = "4";
"00-09-001" = "是的，主人。有何吩咐？";
"00-09-002-Id" = "2";
"00-09-002" = "我们。。是从哪里来的？";

"00-10-001-Id" = "4";
"00-10-001" = "据我的惯性导航系统显示，是在那个方位。";
"00-10-002-Id" = "3";
"00-10-002" = "啊！我知道了，你们是从马拉大陆来的，我听老爸说过，那的确是个很遥远的地方。";
"00-10-003-Id" = "1";
"00-10-003" = "悠妮，你是从那个马。。马拉大陆来的吗？";
"00-10-004-Id" = "2";
"00-10-004" = "我记不得了，只记得。。好可怕的噩梦，好可怕。。不！不要！";
"00-10-005-Id" = "1";
"00-10-005" = "悠。。。悠妮小姐！";
"00-10-006-Id" = "2";
"00-10-006" = "我好怕。。带我回家。。带我回家，好吗？求求你。。。。";
"00-10-007-Id" = "1";
"00-10-007" = "。。好！好！别怕，有我在。。放心，我一定带你回家！";
"00-10-008-Id" = "3";
"00-10-008" = "哎呦喂！这小子该不会是想要。。。";

"00-11-001-Id" = "3";
"00-11-001" = "喂！你真的要去？你疯了！#听说那里是与特罗蒂亚完全不一样的地方，为了一个女孩子去做这种冒险，未免太。。";
"00-11-002-Id" = "1";
"00-11-002" = "我一定要去！亚雷斯，你知不知道怎么去？";
"00-11-003-Id" = "3";
"00-11-003" = "这？好。。好吧，我回去问问老爹，我想他应该会知道。。。。";
"00-11-004-Id" = "1";
"00-11-004" = "好极了，我们整理一些轻便行李，我再向父王禀告一下，就可以出发了。";
"00-11-005-Id" = "3";
"00-11-005" = "我也去好了！谁叫我们是从小打架打到大的朋友？总不能就这样让你一个人到马拉大陆去！";
"00-11-006-Id" = "1";
"00-11-006" = "亚雷斯，谢谢你！";
"00-11-007-Id" = "3";
"00-11-007" = "不用谢了，你先带悠妮小姐回去休养吧！陛下那边和借船的事我来办就好了。";


