    m_Localized: "ASR-06\uFF0C\u770B\u6765\u4F60\u7684\u7CFB\u7EDF\u679C\u7136\u6545\u969C\u4E86\uFF01\u5728\u4E0A\u4E00\u6B21\u7684\u610F\u5916\u4E2D\u3002\u3002\u4F60\u4E00\u76F4\u6CA1\u6709\u8BD5\u7740\u53BB\u81EA\u6211\u4FEE\u590D\u5417\uFF1F"
