  m_Name: ChapterStrings-16_zh-Hant
  m_EditorClassIdentifier: Unity.Localization::UnityEngine.Localization.Tables.StringTable
  m_LocaleId:
    m_Code: zh-Hant
  m_SharedData: {fileID: 11400000, guid: ddc757a48c7fc4640967d6ffd00144b8, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 246509568
    m_Localized: "\u5514\uFF0C\u597D\u51B7\uFF01#\u4F4F\u60EF\u4E86\u7F57\u7279\u5E1D\u4E9A\u7684\u6E29\u6696\u6C14\u5019\uFF0C\u8FD8\u771F\u6709\u70B9\u4E0D\u4E60\u60EF\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 267481088
    m_Localized: "\u4E0D\u77E5\u9053\u6211\u7684\u670B\u53CB\u662F\u5426\u5DF2\u7ECF\u62B5\u8FBE\u6B64\u5730\uFF0C\u7167\u7406\u8BF4\u5E94\u8BE5\u4F1A\u6709\u70B9\u5FB4\u53EC\u3002\u3002\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 267481089
    m_Localized: "\u563F\uFF0C\u5728\u8FD9\u79CD\u5730\u65B9\u7279\u522B\u5BB9\u6613\u770B\u5230\u8FDC\u5904\u3002\u3002\u3002\u3002#\u54A6\uFF0C\u90A3\u53EF\u4E0D\u662F\u6709\u4EBA\u5728\u6253\u67B6\u5417\uFF1F"
    m_Metadata:
      m_Items: []
  - m_Id: 267481090
    m_Localized: "\u554A\uFF0C\u90A3\u4E0D\u5C31\u662F\u3002\u3002\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 267481091
    m_Localized: "\u585E\u53EF\u90A6\u52D2\uFF1F\u4F60\u6765\u7684\u6B63\u597D\uFF0C\u6211\u9047\u4E0A\u4E86\u4E00\u70B9\u5C0F\u9EBB\u70E6\u3002\u3002\u3002\u3002\u8FD9\u4E9B\u662F\u4F60\u65B0\u4EA4\u7684\u670B\u53CB\u5417\uFF1F"
    m_Metadata:
      m_Items: []
  - m_Id: 267481092
    m_Localized: "\u662F\u7684\uFF0C\u6709\u4E00\u4E9B\u5FD7\u540C\u9053\u5408\u7684\u6218\u53CB\uFF0C\u4ED6\u4EEC\u4E00\u8DEF\u8D76\u8FC7\u6765\u5E2E\u5FD9\u7684\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 271675392
    m_Localized: "\u597D\u6781\u4E86\uFF0C\u90A3\u4E48\u8FD9\u4E00\u56DE\u6211\u53EF\u4EE5\u5C11\u8D39\u70B9\u5DE5\u592B\uFF0C\u53EB\u4F60\u7684\u670B\u53CB\u4EEC\u5FEB\u70B9\uFF0C\u8D76\u5FEB\u89E3\u51B3\u8FD9\u573A\u4ED7\uFF0C\u6211\u4EEC\u8FD8\u6709\u5F88\u591A\u4E8B\u8981\u529E\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 271675393
    m_Localized: "\u585E\u53EF\u90A6\u52D2\uFF0C\u8FD9\u4F4D\u5973\u58EB\u5C31\u662F\u4F60\u6240\u8BF4\u7684\u670B\u53CB\u5417\uFF1F"
    m_Metadata:
      m_Items: []
  - m_Id: 271675394
    m_Localized: "\u662F\u7684\uFF0C\u5979\u5C31\u662F\u5251\u5723\u5BC6\u8482\uFF0C\u591A\u5E74\u6765\u4E00\u76F4\u5728\u5C71\u4E2D\u9690\u5C45\uFF0C\u953B\u70BC\u66F4\u9AD8\u5F3A\u7684\u5251\u6280\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 271675395
    m_Localized: "\u662F\u5979\u554A\uFF01\u6211\u8BB0\u5F97\u591A\u5E74\u524D\u5979\u5728\u7687\u5BAB\u7981\u536B\u56E2\u4E2D\u662F\u6211\u7684\u524D\u8F88\uFF0C\u540E\u6765\u597D\u8C61\u56E0\u4E3A\u9189\u5FC3\u4E8E\u5251\u672F\uFF0C\u5C31\u8F9E\u8D77\u9A91\u58EB\u56E2\u7684\u804C\u52A1\uFF0C\u90A3\u65F6\u5927\u5BB6\u90FD\u5F88\u60CB\u60DC\u5462\uFF01"
    m_Metadata:
      m_Items: []
  - m_Id: 271675396
    m_Localized: "\u50CF\u5979\u8FD9\u6837\u7684\u5389\u5BB3\u4EBA\u7269\uFF0C\u4E3A\u4F55\u4F1A\u7A81\u7136\u5728\u6B64\u51FA\u73B0\uFF1F"
    m_Metadata:
      m_Items: []
  - m_Id: 271675397
    m_Localized: "\u5979\u4F3C\u4E4E\u662F\u53D7\u53CB\u4EBA\u6240\u6258\uFF0C\u524D\u6765\u8C03\u67E5\u4E00\u4E9B\u4E8B\u60C5\u3002\u6211\u548C\u5979\u5728\u8DEF\u4E0A\u7ED3\u8BC6\uFF0C\u5979\u5F97\u77E5\u6211\u8981\u56DE\u53BB\u786E\u8BA4\u517D\u4EBA\u7684\u4FB5\u653B\u884C\u52A8\uFF0C\u5C31\u6258\u6211\u56DE\u6765\u901A\u77E5\u5979\u7ED3\u679C\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 271675398
    m_Localized: "\u8FD9\u6837\u8BF4\u8D77\u6765\uFF0C\u83AB\u975E\u5979\u548C\u7EA6\u62FF\u4E5F\u6709\u4EC0\u4E48\u5173\u8FDE\u3002\u3002\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 271675399
    m_Localized: "\u7B97\u4E86\u5427\uFF01#\u8FD9\u5973\u4EBA\u4E00\u526F\u5927\u59D0\u6837\uFF0C\u521A\u89C1\u9762\u5C31\u5BF9\u4EBA\u53D1\u53F7\u65BD\u4EE4\uFF0C\u770B\u4E86\u5C31\u4E0D\u987A\u773C\uFF01#\u6211\u624D\u4E0D\u7BA1\u5979\u662F\u4EC0\u4E48\u5251\u5723\u5462\uFF01"
    m_Metadata:
      m_Items: []
  - m_Id: 271675400
    m_Localized: "\u7D22\u5C14\uFF0C\u90A3\u6211\u4EEC\u5C31\u8868\u73B0\u7ED9\u5979\u770B\u554A\uFF01#\u8BA9\u5979\u77E5\u9053\u6211\u4EEC\u7F57\u7279\u5E1D\u4E9A\u7684\u5251\u58EB\u4E5F\u4E0D\u662F\u6CDB\u6CDB\u4E4B\u8F88\uFF01"
    m_Metadata:
      m_Items: []
  - m_Id: 271675401
    m_Localized: "\u8BF4\u7684\u5BF9\uFF01\u4ECA\u5929\u8981\u5927\u5E72\u4E00\u573A\uFF01\u4E0A\u554A\uFF01"
    m_Metadata:
      m_Items: []
  - m_Id: 271675402
    m_Localized: "\u5404\u4F4D\uFF0C\u6F02\u4EAE\u7684\u4E00\u4ED7\uFF01#\u771F\u662F\u628A\u56E2\u961F\u5408\u4F5C\u7684\u7CBE\u795E\u53D1\u6325\u5230\u4E86\u6781\u81F4\uFF0C\u6211\u4E2A\u4EBA\u975E\u5E38\u4F69\u670D\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 271675403
    m_Localized: "\u9601\u4E0B\u7684\u5251\u6280\u4E5F\u6781\u4E3A\u9AD8\u8D85\uFF0C\u771F\u662F\u8BA9\u6211\u4EEC\u5F00\u4E86\u773C\u754C\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 271675404
    m_Localized: "\u8C22\u8C22\u3002#\u90A3\u4E48\uFF0C\u6211\u60F3\u5404\u4F4D\u4F1A\u5230\u8FD9\u91CC\u6765\uFF0C\u76F8\u4FE1\u90FD\u548C\u6211\u6709\u7740\u76F8\u540C\u7684\u76EE\u7684\uFF0C\u73B0\u5728\u5DF2\u67E5\u660E\u654C\u65B9\u90E8\u961F\u6B63\u96C6\u7ED3\u5728\u5317\u65B9\u7684\u827E\u65AF\u5C9B\u4E0A\uFF0C\u63A5\u4E0B\u6765\u5C31\u7531\u6211\u5E26\u9886\u5404\u4F4D\u524D\u53BB\uFF0C\u5C06\u654C\u4EBA\u4E00\u4E3E\u6B7C\u706D\u3002#\u6211\u60F3\u5404\u4F4D\u90FD\u6CA1\u6709\u610F\u89C1\u5427\uFF1F"
    m_Metadata:
      m_Items: []
  - m_Id: 271675405
    m_Localized: "\u6211\u6709\u610F\u89C1\uFF01"
    m_Metadata:
      m_Items: []
  - m_Id: 271675406
    m_Localized: "\u7D22\u3002\u3002\u7D22\u5C14\uFF1F#\u4F60\u600E\u4E48\u4E86\uFF1F"
    m_Metadata:
      m_Items: []
  - m_Id: 271675407
    m_Localized: "\u4F60\u6709\u4EC0\u4E48\u610F\u89C1\uFF0C\u5C31\u8BF4\u51FA\u6765\u542C\u542C\u770B\u5427\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 271675408
    m_Localized: "\u65E2\u7136\u662F\u6211\u4EEC\u6218\u6280\u9AD8\u8D85\uFF0C\u6211\u4EEC\u4E3A\u4EC0\u4E48\u8981\u7531\u4F60\u6765\u5E26\u9886\uFF1F#\u5E94\u8BE5\u662F\u4F60\u52A0\u5165\u6211\u4EEC\uFF0C\u7136\u540E\u5411\u5BFC\u6211\u4EEC\u5230\u827E\u65AF\u5C9B\u53BB\u624D\u5BF9\uFF0C\u4E0D\u662F\u5417\uFF1F"
    m_Metadata:
      m_Items: []
  - m_Id: 271675409
    m_Localized: "\u7D22\u5C14\u5927\u54E5\uFF0C\u5BC6\u8482\u9601\u4E0B\u4E5F\u7B97\u662F\u5251\u58EB\u4E2D\u7684\u524D\u8F88\uFF0C\u4F60\u4E5F\u591A\u5C11\u656C\u8001\u5C0A\u8D24\u4E00\u4E0B\u561B\u3002\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 271675410
    m_Localized: "\u54FC\uFF0C\u6211\u624D\u4E0D\u670D\uFF01#\u4F1A\u6253\u67B6\u7684\u624D\u7B97\u9AD8\u624B\uFF0C\u6211\u4ECE\u5C0F\u5C31\u8FD9\u4E48\u8BA4\u4E3A\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 271675411
    m_Localized: "\u5488\u5488\u3002\u3002#\u5C0F\u5B50\uFF0C\u4F60\u5E74\u7EAA\u8FD9\u4E48\u8F7B\u5C31\u6709\u5982\u6B64\u7684\u80C6\u8BC6\u548C\u6B66\u827A\uFF0C\u6211\u5F88\u6B23\u8D4F\u3002\u3002\u3002\u3002#\u4E5F\u597D\uFF0C\u6211\u4E00\u4E2A\u4EBA\u8FC7\u4E86\u8FD9\u4E48\u591A\u5E74\uFF0C\u4E5F\u597D\u4E45\u6CA1\u6709\u5C1D\u8FC7\u88AB\u4EBA\u5E26\u9886\u7684\u6ECB\u5473\u4E86\uFF0C\u6211\u5C31\u52A0\u5165\u4F60\u4EEC\u5427\uFF01#\u5251\u5723\u5BC6\u8482\uFF0C\u4EE5\u540E\u8BF7\u5404\u4F4D\u591A\u591A\u6307\u6559\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 271675412
    m_Localized: "\u8FD9\u5C31\u662F\u738B\u8005\u7684\u9738\u6C14\u554A\uFF01#\u4E0D\u6127\u662F\u7D22\u5C14,\u5149\u8FD9\u4E00\u70B9\u6211\u5C31\u6BD4\u4E0D\u4E0A\u4ED6\u4E86\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 271675413
    m_Localized: "\u90A3\u4E48\uFF0C\u5BC6\u8482\u9601\u4E0B\uFF0C\u8FD9\u5C31\u8BF7\u4F60\u5E26\u9886\u6211\u4EEC\u5230\u827E\u65AF\u5C9B\u53BB\u5427\uFF01"
    m_Metadata:
      m_Items: []
  - m_Id: 271675414
    m_Localized: "\u54FC\uFF0C\u6211\u624D\u6211\u624D\u4E0D\u5728\u4E4E\u8FD9\u4E9B\u4E8B\u5462\uFF01#\u6211\u4EEC\u5FEB\u4E0A\u8DEF\u5427\uFF01"
    m_Metadata:
      m_Items: []
  - m_Id: 271675415
    m_Localized: "\u6069\uFF0C\u4E00\u573A\u4E0D\u9519\u7684\u4ED7\u4F46\u662F\u8017\u7684\u65F6\u95F4\u592A\u4E45\u4E86\u3002\u3002\u3002\u3002#\u585E\u53EF\u90A6\u52D2,\u6709\u5173\u517D\u4EBA\u7684\u60C5\u51B5\u6211\u5DF2\u7ECF\u660E\u767D\u4E86\uFF0C\u7B49\u4E00\u4E0B\u6211\u9A6C\u4E0A\u8981\u8D76\u5230\u827E\u65AF\u5C9B\u53BB\uFF0C\u5982\u679C\u4F60\u7684\u670B\u53CB\u4E5F\u60F3\u51D1\u51D1\u70ED\u95F9\u7684\u8BDD\uFF0C\u5C31\u7531\u4F60\u5E26\u4ED6\u4EEC\u53BB\u5427\uFF0C\u6211\u5E94\u8BE5\u544A\u8BC9\u8FC7\u4F60\u827E\u65AF\u5C9B\u7684\u4F4D\u7F6E\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 271675416
    m_Localized: "\u662F\u7684\uFF0C\u6211\u786E\u5B9E\u8BB0\u5F97\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 271675417
    m_Localized: "\u827E\u65AF\u5C9B\u7684\u60C5\u52BF\u975E\u6BD4\u5BFB\u5E38\uFF0C\u53EB\u4ED6\u4EEC\u91CF\u529B\u800C\u4E3A\uFF0C\u4E0D\u8981\u628A\u5C0F\u547D\u9001\u6389\u4E86\u3002#\u6211\u8D70\u4E86\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 271675418
    m_Localized: "\u54FC\uFF0C\u8FD9\u5973\u4EBA\u771F\u662F\u591F\u56A3\u5F20\u4E86\uFF01#\u6211\u3002\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 271675419
    m_Localized: "\u5509\uFF0C\u7D22\u5C14\uFF0C\u6211\u4EEC\u6280\u4E0D\u5982\u4EBA\uFF0C\u4F60\u8FD8\u60F3\u600E\u4E48\u6837\uFF1F"
    m_Metadata:
      m_Items: []
  - m_Id: 271675420
    m_Localized: "\u6211\u4EEC\u8FD8\u662F\u5148\u8D76\u5230\u827E\u65AF\u5C9B\u4E0A\u89C2\u5BDF\u4E00\u4E0B\u60C5\u52BF\uFF0C\u6216\u8BB8\u8FD8\u6709\u6211\u4EEC\u53EF\u4EE5\u5E2E\u5FD9\u7684\u5730\u65B9\u3002\u3002\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 271675421
    m_Localized: "\u4E5F\u53EA\u597D\u8FD9\u6837\u4E86\uFF01#\u7D22\u5C14\uFF0C\u522B\u65E0\u7CBE\u6253\u91C7\u7684\uFF0C\u6211\u4EEC\u8D70\u5427\uFF01"
    m_Metadata:
      m_Items: []
  - m_Id: 271675422
    m_Localized: "\u53EF\u6076\uFF0C\u6211\u624D\u4E0D\u80AF\u8BA4\u8F93\u5462\uFF01#\u7B49\u7740\u77A7\uFF01"
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
