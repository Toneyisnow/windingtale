    m_Localized: "\u4E0D\u5BF9\uFF0C\u585E\u62C9\u6751\u53EF\u80FD\u51FA\u4E8B\u4E86\uFF01\u6211\u4EEC\u8D76\u5FEB\u8D76\u8FC7\u53BB\u770B\u770B\uFF01"
