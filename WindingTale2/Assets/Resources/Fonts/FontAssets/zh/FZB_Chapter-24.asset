    characterSetSelectionMode: 8
    characterSequence: "\u7B2C\u4E8C\u5341\u56DB\u7AE0  \u5728\u5929\u7A7A\u7684\u5F7C\u65B9\r\n\u7D22\u5C14\u6B7B\u4EA1\r\n\u654C\u5168\u706D\r\n1\r\n\u554A\uFF0C\u65E0\u804A\u5F97\u8981\u547D\u3002\u3002\u5230\u5E95\u8FD8\u8981\u98DE\u591A\u4E45\u554A\uFF01\r\n21\r\n\u771F\u795E\u6C14\uFF0C\u6211\u4EEC\u4E00\u5929\u5185\u5C31\u98DE\u8FC7\u4E86\u5927\u9646\u897F\u5317\u90E8\u3002\u3002\u4ECE\u65B9\u5411\u770B\u6765\uFF0C\u73B0\u5728\u5E94\u8BE5\u662F\u5728\u524D\u5F80\u8FB9\u754C\u7684\u5C71\u8109\u5427\uFF01\r\n25\r\n\u4F60\u662F\u8BF4\u300C\u6076\u9B54\u4E4B\u5C71\u300D\u5417\uFF1F\u90A3\u4E00\u5E26\u5168\u662F\u672A\u7184\u706D\u7684\u706B\u5C71\u554A\uFF01\u542C\u8BF4\u90A3\u91CC\u4E5F\u662F\u6076\u9B54\u65CF\u7684\u6839\u636E\u5730\u3002\u3002\u96BE\u9053\u6076\u9B54\u65CF\u548C\u8FD9\u4EF6\u4E8B\u6709\u5173\uFF1F\r\n19\r\n\u90A3\u5012\u4E0D\u5947\u602A\uFF0C\u6076\u9B54\u65CF\u672C\u6765\u5C31\u6816\u606F\u5728\u9ED1\u6697\u548C\u5730\u72F1\u822C\u7684\u708E\u70ED\u4E2D\uFF0C\u548C\u5176\u4ED6\u79CD\u65CF\u5411\u4E0D\u5F80\u6765\uFF0C\u8C01\u6653\u5F97\u5B83\u4EEC\u6697\u5730\u91CC\u4F1A\u641E\u51FA\u4E9B\u4EC0\u4E48\uFF01\r\n16\r\n\u77A7\uFF0C\u6709\u4EBA\u6765\u8FCE\u63A5\u6211\u4EEC\u4E86\uFF01\r\n101\r\n\u90A3\u3002\u3002\u90A3\u662F\u4EC0\u4E48\uFF1F\u98DE\u884C\u7684\u5927\u5CA9\u77F3\uFF0C\u4E0A\u9762\u6709\u4EBA\uFF1F\r\n102\r\n\u7B28\uFF01\u90A3\u65F6\u9B54\u6CD5\u9A71\u52A8\u7684\u98DE\u884C\u88C5\u7F6E\uFF0C\u90A3\u4E9B\u4EBA\u662F\u4E58\u5750\u5728\u4E0A\u9762\u7684\u4E58\u5BA2\uFF01\r\n101\r\n\u4ED6\u4EEC\u60F3\u5E72\u4EC0\u4E48\uFF1F\u60F3\u7A81\u7834\u8FD9\u91CC\u7684\u7A7A\u57DF\u524D\u5F80\u706B\u7130\u4E4B\u8C37\u5417\uFF1F\r\n102\r\n\u965B\u4E0B\u5429\u5490\u8FC7\u6211\u4EEC\uFF0C\u7EDD\u4A0D\u53EF\u8BA9\u4EFB\u4F55\u4EBA\u4ECE\u7A7A\u4E2D\u6216\u5730\u4E0B\u7ECF\u8FC7\u6B64\u5730\u7684\uFF01\r\n101\r\n\u6240\u4EE5\u73B0\u5728\u6211\u4EEC\u8981\u5BB0\u4E86\u90A3\u4E9B\u5BB6\u4F19\uFF01\u4E0A\u5427\uFF01\r\n19\r\n\u54C7\uFF01\u5BF9\u65B9\u6765\u610F\u4E0D\u5584\u5462\uFF01\u597D\u8C61\u60F3\u8981\u52A8\u624B\u4E86\uFF01\r\n3\r\n\u8981\u5728\u8FD9\u79CD\u5730\u65B9\u6253\u5417\uFF1F\u597D\u8C61\u5BF9\u6211\u4EEC\u5F88\u4E0D\u5229\u5427\uFF01\r\n27\r\n\u6211\u4EEC\u7684\u4F19\u4F34\u4E2D\u8FD8\u6709\u51E0\u4E2A\u4F1A\u98DE\u7684\uFF0C\u52C9\u5F3A\u53EF\u4EE5\u7275\u5236\u654C\u65B9\u7684\u653B\u52BF\uFF0C\u4F60\u4EEC\u53EA\u8981\u5728\u5730\u4E0A\u786E\u5B9E\u6D88\u706D\u654C\u4EBA\u5C31\u53EF\u4EE5\u4E86\uFF01\r\n1\r\n\u5BF9\u65B9\u4E0D\u8FC7\u662F\u4F1A\u98DE\u800C\u5DF2\uFF0C\u6709\u4EC0\u4E48\u597D\u6015\u7684\uFF01\u6211\u4EEC\u5148\u6253\u4E86\u518D\u8BF4\uFF01\r\n21\r\n\u654C\u519B\u4F3C\u4E4E\u662F\u8D1F\u8D23\u9547\u5B88\u7740\u4E00\u5E26\u7684\u7A7A\u57DF\uFF0C\u4EE5\u9632\u6B62\u4ED6\u4EBA\u4FB5\u5165\u3002\u3002\u770B\u6765\u6076\u9B54\u4E4B\u5C71\u4E00\u5B9A\u6709\u4EC0\u4E48\u4E8B\u53D1\u751F\uFF0C\u5927\u5AB6\u8981\u6709\u5FC3\u7406\u51C6\u5907\uFF0C\u51C6\u5907\u9762\u961F\u975E\u5E38\u6684\u72B6\u51B5\u3002\u3002\r\n25\r\n\u7EA6\u62FF\u8001\u5934\uFF0C\u6211\u4EEC\u7684\u9AD8\u5EA6\u597D\u8C61\u5F00\u59CB\u4E0B\u964D\u4E86\u8036\r\n27\r\n\u7684\u786E\uFF0C\u800C\u4E14\u8D8A\u6765\u8D8A\u5FEB\u4E86\u3002\u3002\u3002\u3002
      \r\n6\r\n\u54C7\u554A\u554A\u554A\uFF01\u7D22\u5C14\uFF0C\u6211\u597D\u6015\uFF01\r\n1\r\n\u5E0C\u8389\u4E9A\uFF0C\u6293\u7D27\u6211\uFF01\u60A0\u59AE\uFF0C\u4F60\u4E5F\u8FC7\u6765\uFF01
      \r\n2\r\n\u597D\u3002\u3002\u3002\r\n11\r\n\u3002\u3002\u3002\u3002\uFF01\u554A\uFF0C\u4E9A\u96F7\u65AF\uFF0C\u6211\u5934\u597D\u660F\u3002\u3002\u3002\u3002\r\n3\r\n\u4E0D\u8981\u7D27\u5427\uFF1F\u6765\uFF0C\u6293\u7D27\u6211\uFF01\r\n11\r\n\u8C22\u8C22\uFF0C\u4E9A\u96F7\u65AF\uFF0C\u4F60\u771F\u597D\u3002\u3002\u3002\u3002\r\n25\r\n\u7EA6\u62FF\u8001\u5934\u554A\uFF0C\u6211\u5C31\u8BF4\u561B\uFF0C\u73B0\u5728\u7684\u5973\u5B69\u5B50\u8981\u6BD4\u4EE5\u524D\u5927\u80C6\u591A\u4E86\uFF0C\u8FDE\u73B0\u5728\u8FD9\u79CD\u70B6\u51B5\u90FD\u53EF\u4EE5\u62FF\u6765\u4F5C\u8C03\u60C5\u7684\u673A\u4F1A\uFF0C\u770B\u6765\u6211\u4EEC\u90FD\u843D\u4F0D\u55BD\uFF01\r\n21\r\n\u5E0C\u5C14\u6CD5\uFF0C\u5982\u679C\u4F60\u4E0D\u60F3\u88AB\u4ED6\u4EEC\u4E00\u811A\u8E39\u4E0B\u8FD9\u98DE\u884C\u5CA9\u7684\u8BDD\uFF0C\u6211\u5EFA\u8BAE\u4F60\u5728\u6211\u4EEC\u7740\u9646\u524D\u6700\u597D\u4FDD\u6301\u5B89\u9759\u3002\u3002\u3002\u3002\r\n"
