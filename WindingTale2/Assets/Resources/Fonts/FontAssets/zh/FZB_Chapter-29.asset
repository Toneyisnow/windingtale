    characterSequence: "\u7B2C\u4E8C\u5341\u4E5D\u7AE0\u3000\u65E0\u8FB9\u7684\u9ED1\u6697\u4E4B\u4E2D\r\n\u7D22\u5C14\u6216\u60A0\u59AE\u6B7B\u4EA1\r\n\u89E3\u9664\u9632\u5FA1\u7CFB\u7EDF\r\n1\r\n\u597D\u7D2F\uFF0C\u62D0\u4E86\u534A\u5929\u8DEF\uFF0C\u5934\u90FD\u5FEB\u6655\u4E86\u3002\u3002\u3002\u3002\r\n2\r\n\u6CA1\u529E\u6CD5\uFF0C\u4E3A\u4E86\u5C11\u6253\u4E00\u4E9B\u65E0\u8C13\u7684\u4ED7\u4EE5\u4FDD\u7559\u5927\u5BB6\u7684\u5B9E\u529B\uFF0C\u5C3D\u91CF\u907F\u5F00\u5176\u5B83\u7684\u5B88\u536B\u961F\u662F\u5FC5\u987B\u7684\u3002\r\n21\r\n\u5514\uFF01\u8FD9\u5730\u65B9\u8574\u6DB5\u7740\u6781\u5F3A\u5927\u7684\u80FD\u91CF\uFF0C\u5176\u5A01\u529B\u4E4B\u5F3A\u662F\u6211\u524D\u6240\u672A\u89C1\u7684\u3002\u3002\r\n2\r\n\u662F\u7684\uFF0C\u8FD9\u91CC\u5C31\u662F\u9EC4\u91D1\u57CE\u7684\u6838\u5FC3\uFF0C\u6B21\u5143\u53CD\u5E94\u7089\u3002\u8FD9\u53CD\u5E94\u7089\u4E0D\u4F46\u4EA7\u751F\u6574\u4E2A\u8981\u585E\u6240\u9700\u7684\u52A8\u529B\uFF0C\u4EE5\u67D0\u79CD\u65B9\u6CD5\u5C06\u5B83\u7684\u53CD\u5E94\u9006\u8F6C\uFF0C\u4E5F\u53EF\u4EE5\u8BA9\u5B83\u6210\u4E3A\u6050\u6016\u7684\u6700\u7EC8\u5175\u5668\u3002\u3002\u3002\u3002\r\n9\r\n\u90A3\u6211\u4EEC\u73B0\u5728\u8BE5\u600E\u4E48\u529E\uFF1F\u7834\u574F\u5B83\u5417\uFF1F\r\n2\r\n\u4E0D\uFF01\u5E76\u4E0D\u9700\u8981\u7834\u574F\u5B83\uFF0C\u5728\u8FD9\u6838\u5FC3\u533A\u7684\u5317\u65B9\uFF0C\u5C31\u662F\u8981\u585E\u7684\u4E2D\u67A2\u63A7\u5236\u7CFB\u7EDF\uFF0C\u53EA\u8981\u6709\u8FD9\u5929\u7A7A\u4E4B\u94A5\uFF0C\u6211\u5C31\u53EF\u4EE5\u63A5\u7BA1\u8981\u585E\u7684\u4E2D\u67A2\u7CFB\u7EDF\uFF0C\u7ECF\u7531\u6211\u7684\u7EC8\u7AEF\u8FDE\u63A5\u5185\u90E8\u7684\u7F51\u7EDC\u6765\u63A7\u5236\u6574\u4E2A\u8981\u585E\u3002\r\n1\r\n\u60A0\u59AE\uFF0C\u60F3\u4E0D\u5230\u4F60\u6709\u8FD9\u79CD\u80FD\u529B\uFF0C\u6211\u597D\u4F69\u670D\u4F60\uFF01\r\n2\r\n\u662F\u5417\uFF1F\u60F3\u8981\u6709\u8FD9\u79CD\u80FD\u529B\uFF0C\u53EF\u662F\u8981\u4ED8\u51FA\u53EF\u6015\u7684\u4EE3\u4EF7\u7684\u3002\u3002\u4E0D\u591A\u8BF4\u4E86\uFF0C\u6211\u4EEC\u8FD9\u5C31\u8FC7\u53BB\u5427\u3002\r\n163\r\n\u54D4\uFF0C\u76EE\u6807\u53D1\u73B0\u5E76\u786E\u8BA4\uFF01\u6267\u884C\u4F5C\u6218\u6307\u4EE4\uFF01\u95F4\u63A5\u5750\u6807\u4F20\u8F93\u5B8C\u6210\uFF0C\u9632\u536B\u7528\u969C\u58C1\u542F\u52A8\uFF01\u5404\u5355\u4F4D\uFF0C\u6B7C\u706D\u6240\u6709\u654C\u76EE\u6807\uFF01\u4E0D\u9700\u987E\u8651ASR-07\uFF01\r\n3\r\n\u54FC\uFF0C\u6709\u57CB\u4F0F\uFF01\r\n1\r\n\u5730\u5F62\u5DEE\u4E86\u4E00\u70B9\u662F\u771F\u7684\uFF0C\u4F46\u8981\u6218\u80DC\u5E94\u8BE5\u8FD8\u4E0D\u662F\u96BE\u4E8B\u3002\r\n2\r\n\u8FD9\u91CC\u73B0\u5728\u8FD8\u5B8C\u5168\u5728\u654C\u65B9\u7684\u63A7\u5236\u4E0B\uFF0C\u6211\u4EEC\u5343\u4E07\u4E0D\u80FD\u6389\u4EE5\u8F7B\u5FC3\u3002\u5927\u5BB6\u8BBE\u6CD5\u62A4\u9001\u6211\u5230\u524D\u9762\u7684\u63A7\u5236\u76D8\u53BB\u5C31\u53EF\u4EE5\u4E86\uFF0C\u53EA\u8981\u8BA9\u6211\u6709\u673A\u4F1A\u628A\u300C\u5929\u7A7A\u4E4B\u94A5\u300D\u5B89\u88C5\u597D\uFF0C\u6211\u5C31\u80FD\u8BA9\u8FD9\u4E9B\u9632\u536B\u90E8\u961F\u5168\u90E8\u53D8\u6210\u5E9F\u94C1\u3002\r\n1\r\n\u6CA1\u95EE\u9898\uFF0C\u5305\u5728\u6211\u8EAB\u4E0A\uFF01\r\n3\r\n\u6211\u4EEC\u8D76\u5FEB\u52A8\u624B\u5427\uFF0C\u53EF\u522B\u8BA9\u654C\u4EBA\u62A2\u4E86\u5148\u673A\uFF01\r\n2\r\n\u5C31\u662F\u8FD9\u91CC\u4E86\uFF01\u7CFB\u7EDF\u8BC6\u522B\u7801\u3002\u30020370425188\u3002\u3002\u554A\uFF0C\u8FD9\u662F\u3002\u3002\r\n1\r\n\u60A0\u59AE\uFF0C\u600E\u6837\uFF1F\r\n2\r\n\u4E2D\u67A2\u64A4\u6D88\u6700\u9AD8\u7EA7\u7CFB\u7EDF\u9632\u536B\u9700\u8981\u4E00\u4E9B\u65F6\u95F4\uFF0C\u6211\u60F3\u8FD8\u8981\u518D\u7B49\u4E00\u4F1A\u513F\uFF01\r\n1\r\n\u6CA1\u5173\u7CFB\uFF01\u5012\u662F\u4F60\u81EA\u5DF1\u53EF\u8981\u591A\u5C0F\u5FC3\u4E9B\uFF01\r\n2\r\n\u597D\u7684\uFF01\r\n2\r\n\u5947\u602A\uFF0C\u7EC8\u7AEF\u7ADF\u7136\u6297\u62D2\u6211\u7684\u547D\u4EE4\uFF0C\u6709\u4EBA\u5BF9\u9632\u536B\u7CFB\u7EDF\u52A8\u4E86\u624B\u811A\uFF01\r\n1\r\n\u60A0\u59AE\uFF0C\u600E\u6837\u4E86\uFF1F\r\n2\r\n\u7CDF\u7CD5\uFF0C\u7CFB\u7EDF\u8FDB\u5165\u4E86\u6700\u7EC8\u9632\u536B\u72B6\u6001\uFF01\u8FD9\u3002\u3002\r\n301\r\n\u8B66\u544A\uFF01\u4E2D\u67A2\u90E8\u6709\u654C\u4EBA\u4FB5\u5165\uFF01\r\n302\r\n\u6700\u7EC8\u9632\u536B\u72B6\u6001\u542F\u52A8\uFF01\r\n303\r\n\u5BF9\u5916\u7CFB\u7EDF\u8FDE\u7ED3\u95ED\u9501\uFF01\u81EA\u6211\u9632\u536B\u88C5\u7F6E\u542F\u52A8\uFF01\r\n1\r\n\u60A0\u59AE\uFF0C\u5C0F\u5FC3\uFF01\u90A3\u4E09\u6761\u9F99\u662F\u3002\u3002\u3002\u3002\r\n2\r\n\u4E8B\u5230\u5982\u4ECA\uFF0C\u4E5F\u53EA\u80FD\u8FD9\u6837\u505A\u4E86\u3002\u3002\u5927\u5BB6\u542C\u7740\uFF0C\u8FD9\u4E09\u6761\u5DE8\u9F99\u5F62\u72B6\u7684\u4E1C\u897F\u662F\u9EC4\u91D1\u57CE\u7684\u9632\u536B\u4E2D\u67A2\uFF0C\u7531\u4E8E\u654C\u4EBA\u7684\u5E72\u6270\uFF0C\u6211\u4EEC\u73B0\u5728\u5DF2\u7ECF\u65E0\u6CD5\u63A7\u5236\u9632\u536B\u4E2D\u67A2\uFF0C\u5FC5\u987B\u96C6\u5408\u5927\u5BB6\u7684\u529B\u91CF\u6765\u628A\u5B83\u4EEC\u5F7B\u5E95\u6467\u6BC1\uFF01\r\n5\r\n\u600E\u4E48\u6467\u6BC1\uFF1F\u7528\u6B66\u5668\u780D\u70C2\u5417\uFF1F\r\n2\r\n\u662F\u7684\uFF0C\u76F4\u63A5\u653B\u51FB\u5B83\u4EEC\u5C31\u884C\u4E86\uFF01\u4E0D\u8FC7\u5B83\u4EEC\u90FD\u6709\u9632\u536B\u88C5\u7F6E\u9632\u62A4\uFF0C\u9632\u536B\u88C5\u7F6E\u7684\u5A01\u529B\u6781\u4E3A\u5F3A\u5927\uFF0C\u5343\u4E07\u4E0D\u53EF\u5927\u610F\uFF01\r\n3\r\n\u77E5\u9053\u4E86\uFF01\u5927\u5BB6\u4E0A\u5427\uFF01\r\n1\r\n\u6210\u4E86\uFF01\r\n2\r\n\u597D\u6781\u4E86\uFF0C\u9632\u536B\u4E2D\u67A2\u5DF2\u7ECF\u5B8C\u5168\u505C\u6B62\uFF0C\u867D\u7136\u6211\u4EEC\u5931\u53BB\u4E86\u6307\u6325\u5176\u4ED6\u9632\u536B\u90E8\u961F\u7684\u80FD\u529B\uFF0C\u4F46\u5F80\u540E\u654C\u4EBA\u4E5F\u65E0\u6CD5\u518D\u5229\u7528\u9632\u536B\u90E8\u961F\u6765\u963B\u6B62\u6211\u4EEC\u3002#\u591A\u8C22\u5927\u5BB6\u7684\u5E2E\u5FD9\uFF0C\u73B0\u5728\u53EA\u8981\u518D\u63A5\u7BA1\u5269\u4E0B\u7684\u7CFB\u7EDF\uFF0C\u4FBF\u53EF\u4EE5\u9632\u6B62\u5BF9\u65B9\u4F7F\u7528\u6700\u7EC8\u6B66\u5668\u3002\r\n3\r\n\u597D\u6781\u4E86\uFF0C\u90A3\u6211\u4EEC\u63A5\u4E0B\u6765\u8981\u600E\u4E48\u505A\uFF1F\r\n2\r\n\u627E\u51FA\u6700\u540E\u7684\u654C\u4EBA\uFF0C\u6211\u76F8\u4FE1\u4ED6\u662F\u8FD9\u4E00\u5207\u4E8B\u4EF6\u7684\u80CC\u540E\u4E3B\u4F7F\u8005\uFF0C\u4ED6\u662F\u3002\u3002\r\n999\r\n\u662F\u6307\u6211\u5417\uFF1F\r\n2\r\n\u662F\u3002\u3002\u662F\u4F60\uFF01\u771F\u7684\u662F\u4F60\uFF01\r\n999\r\nASR-07\uFF0C\u4F60\u7684\u7CFB\u7EDF\u771F\u7684\u53D7\u635F\u8FD9\u4E48\u91CD\u5417\uFF1F\u5C45\u7136\u8BA4\u654C\u4E3A\u53CB\uFF0C\u5B9E\u5728\u4EE4\u6211\u65E0\u6CD5\u7406\u89E3\u3002\u3002\u4E0D\u8FC7\uFF0C\u8FD8\u662F\u5F88\u611F\u8C22\u4F60\u5E2E\u6211\u9001\u56DE\u8FD9\u5355\u5143\u8BA1\u7B97\u6676\u7247\uFF0C\u6709\u4E86\u5B83\uFF0C\u4E00\u76F4\u5904\u5728\u4E2D\u6B62\u72B6\u51B5\u7684\u300C\u9ED1\u6697\u4E4B\u7130\u300D\u8BA1\u5212\u5C31\u53EF\u4EE5\u7EE7\u7EED\u4E0B\u53BB\u4E86\u3002\u3002\u3002\u3002\r\n2\r\n\u4E3A\u4F55\u4F60\u59CB\u7EC8\u4E0D\u80AF\u653E\u5F03\u8FD9\u4E2A\u75AF\u72C2\u7684\u8BA1\u5212\uFF1F\r\n999\r\n\u8FD9\u4E9B\u5730\u4E0A\u7684\u877C\u8681\uFF0C\u6709\u4EC0\u4E48\u7559\u5B58\u7684\u5FC5\u8981\uFF01\u6211\u4EEC\u5F53\u521D\u63A5\u5230\u7684\u547D\u4EE4\u4E0D\u5C31\u662F\u6BC1\u706D\u4ED6\u4EEC\u5417\uFF1F\r\n2\r\n\u4F46\u6211\u4EEC\u6700\u540E\u63A5\u5230\u4E86\u4E2D\u6B62\u547D\u4EE4\uFF01\u300C\u9ED1\u6697\u4E4B\u7130\u300D\u4F5C\u6218\u5DF2\u7ECF\u4E2D\u6B62\u4E86\uFF01\r\n999\r\n\u662F\u4E2D\u6B62\uFF0C\u4E0D\u662F\u53D6\u6D88\uFF01#\u90A3\u4E9B\u5BB6\u4F19\u547D\u4EE4\u6211\u4EEC\u8FDB\u884C\u6700\u7EC8\u8BA1\u5212\uFF0C\u628A\u6211\u4EEC\u7559\u5728\u8FD9\u4E2A\u8BE5\u6B7B\u7684\u661F\u7403\u4E0A\uFF0C\u7136\u540E\u81EA\u5DF1\u5C31\u9003\u5230\u5916\u592A\u7A7A\u53BB\u4E86\uFF01#\u60F3\u60F3\u6211\u4EEC\u5DF2\u7ECF\u7B49\u4E86\u591A\u4E45\uFF01\u5DF2\u7ECF\u591A\u4E45\u4E86\uFF01\r\n2\r\nASR-06\uFF0C\u770B\u6765\u4F60\u7684\u7CFB\u7EDF\u679C\u7136\u6545\u969C\u4E86\uFF01\u5728\u4E0A\u4E00\u6B21\u7684\u610F\u5916\u4E2D\u3002\u3002\u4F60\u4E00\u76F4\u6CA1\u6709\u8BD5\u7740\u53BB\u81EA\u6211\u4FEE\u590D\u5417\uFF1F\r\n999\r\n\u6CA1\u6709\u5FC5\u8981\uFF01\u6211\u7684\u4F7F\u547D\u5C31\u662F\u6267\u884C\u4F5C\u6218\u8BA1\u5212\u3002\u73B0\u5728\u6211\u7EC8\u4E8E\u53EF\u4EE5\u5F00\u59CB\u5C65\u884C\u6211\u7684\u804C\u52A1\u4E86\u3002\u3002\u3002\u3002\r\n2\r\n\u4E0D\u53EF\u80FD\u7684\uFF0C\u6211\u5DF2\u6210\u529F\u7684\u548C\u6700\u9AD8\u547D\u4EE4\u7CFB\u7EDF\u8FDE\u63A5\uFF0C\u73B0\u5728\u6574\u4E2A\u8981\u585E\u7684\u4E2D\u67A2\u90FD\u5728\u6211\u7684\u63A7\u5236\u4E4B\u4E0B\uFF01\r\n999\r\n\u522B\u50BB\u4E86\uFF0C\u4F60\u5FD8\u4E86\u6211\u8EAB\u4E3A\u76D1\u89C6\u66A8\u6218\u6597\u7CFB\u7EDF\uFF0C\u5728\u4F7F\u7528\u6B66\u5668\u4E0A\u6709\u6700\u9AD8\u7684\u4F18\u5148\u6743\u9650\u5417\uFF1F\u5373\u4F7F\u4F60\u638C\u63E1\u6574\u4E2A\u7CFB\u7EDF\u4E2D\u67A2\uFF0C\u653B\u51FB\u7535\u8111\u4ECD\u7136\u4F1A\u63A5\u53D7\u6211\u7684\u547D\u4EE4\u3002\u3002\u3002\u3002\r\n2\r\n\u4F60\u3002\u3002\u3002\u3002\r\n999\r\n\u9ED1\u6697\u4E4B\u7130\u7CFB\u7EDF\u4E09\u5341\u79D2\u540E\u542F\u52A8\uFF0C\u76EE\u6807\u9A6C\u62C9\u5927\u9646\uFF01\u54C7\u54C8\u54C8\u54C8\uFF0C\u6211\u7B49\u8FD9\u4E00\u523B\u597D\u4E45\u4E86\uFF01\r\n2\r\n\u3002\u3002\u597D\uFF0C\u65E2\u7136\u5982\u6B64\uFF0C\u6211\u53EA\u6709\u7528\u6700\u540E\u4E00\u7740\u4E86\uFF01\u3002\u3002\u3002\u3002\r\n999\r\n\u4F60\u60F3\u5E72\u4EC0\u4E48\uFF1F\u4F60\u963B\u6B62\u4E0D\u4E86\u6211\u7684\u3002\u3002\u3002\u3002\u4E0D\uFF0C\u4E0D\uFF0C\u4F60\u4E0D\u80FD\u8FD9\u6837\u505A\uFF01\r\n2\r\n\u4F60\u542F\u52A8\u4E86\u9ED1\u6697\u4E4B\u7130\uFF0C\u6211\u5C31\u8BA9\u53CD\u5E94\u7089\u9006\u8F6C\uFF01#\u7B49\u5230\u80FD\u91CF\u79EF\u84C4\u7A81\u7834\u4E9A\u7A7A\u95F4\u969C\u58C1\u7684\u8D1F\u8377\u91CF\uFF0C\u5F15\u53D1\u7A7A\u95F4\u626D\u66F2\u6211\u4EEC\u5C31\u4E00\u8D77\u548C\u8FD9\u9EC4\u91D1\u57CE\u5728\u8D85\u7A7A\u95F4\u4E2D\u6C38\u6052\u7684\u6F02\u6D41\u5427\uFF01\r\n999\r\n\u3002\u3002\u4F60\u8FD9\u6837\u505A\uFF0C\u8FD9\u4E9B\u4EBA\u4E5F\u96BE\u9003\u4E00\u52AB\uFF01\r\n2\r\n\u82E5\u8BA9\u4F60\u542F\u52A8\u4E86\u300C\u9ED1\u6697\u4E4B\u7130\u300D\uFF0C\u4F1A\u6709\u66F4\u591A\u65E0\u8F9C\u7684\u4EBA\u56E0\u6B64\u4E27\u547D\uFF01\u4E3A\u4E86\u4FDD\u62A4\u8FD9\u4E2A\u5927\u5BB6\u6240\u73CD\u60DC\u7231\u62A4\u7684\u4E16\u754C\uFF0C\u76F8\u4FE1\u3002\u3002\u76F8\u4FE1\u5927\u5BB6\u4E0D\u4F1A\u602A\u6211\u7684\uFF01\r\n21\r\n\u60A0\u59AE\uFF0C\u505A\u7684\u597D\uFF01\u65E0\u8BBA\u5982\u4F55\uFF0C\u6211\u4EEC\u90FD\u4E0D\u80FD\u548C\u90AA\u6076\u4E4B\u5F92\u59A5\u534F\uFF01\r\n16\r\n\u6211\u4EEC\u8FD9\u4E9B\u8001\u5934\u5B50\u65E9\u5C31\u90FD\u5DF2\u7ECF\u6D3B\u7684\u817B\u4E86\uFF0C\u53EA\u53EF\u60DC\u4E86\u8FD9\u4E9B\u524D\u9014\u5927\u597D\u7684\u5E74\u8F7B\u4EBA\u4EEC\u3002\u3002\u3002\u3002\r\n3\r\n\u6211\u4EEC\u7684\u4F20\u5947\u4F1A\u7559\u5728\u7F57\u7279\u5E1D\u4E9A\u548C\u9A6C\u62C9\u5927\u9646\u7684\u5386\u53F2\u4E0A\u5427\uFF01\u8EAB\u4E3A\u4E00\u4E2A\u6B66\u58EB\uFF0C\u8FD9\u5C31\u662F\u6700\u9AD8\u7684\u56DE\u62A5\u4E86\uFF01\r\n2\r\n\u5BF9\u4E0D\u8D77\uFF0C\u5982\u679C\u3002\u3002\u5982\u679C\u4ECA\u5929\u6211\u6CA1\u6709\u628A\u5927\u5BB6\u5E26\u5230\u8FD9\u9EC4\u91D1\u57CE\u4E0A\u6765\uFF0C\u6216\u8BB8\u5C31\u4E0D\u4F1A\u8FD9\u6837\u4E86\u3002\u3002\r\n1\r\n\u60A0\u59AE\uFF0C\u6211\u81EA\u59CB\u81F3\u7EC8\u90FD\u76F8\u4FE1\u4F60\u7684\u6289\u62E9\uFF0C\u4ECA\u5929\u4F1A\u6709\u8FD9\u79CD\u7ED3\u679C\u5168\u662F\u8FD9\u5BB6\u4F19\u7684\u9519\uFF0C\u4E0D\u7BA1\u600E\u6837\uFF0C\u6211\u8981\u5148\u5288\u4ED6\u4E24\u5251\u518D\u8BF4\uFF01\r\n999\r\n\u7B28\u86CB\uFF0C\u6765\u9001\u6B7B\u5427\uFF01\r\n999\r\n\u53CD\u3001\u53CD\u5E94\u7089\u8D85\u8FC7\u8D1F\u8377\u4E86\uFF01\u3002\u3002\r\n002\r\n\u4E0D\u3002\u3002\u3002\u6211\u4E0D\u80FD\u8F93\u7ED9\u90A3\u5BB6\u4F19\u3002\u3002\u7D22\u5C14\u3002\u3002\u7D22\u3002\u3002\u3002\r\n"
