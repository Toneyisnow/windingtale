    atlasWidth: 4096
    atlasHeight: 4096
    characterSetSelectionMode: 8
    characterSequence: "\u7B2C\u4E8C\u5341\u4E09\u7AE0  \u5411\u5929\u7A7A\u4E4B\u65C5\r\n\u7D22\u5C14\u6216\u5E0C\u5C14\u6CD5\u6B7B\u4EA1\r\n\u51FB\u6BC1\u673A\u7532\u961F\u957F\r\n1\r\n\u547C\uFF01\u96BE\u8FC7\u6B7B\u4E86\u3002\u3002\u54A6\uFF01\u8FD9\u91CC\u662F\u654C\u4EBA\u7684\u6839\u636E\u5730\u5417\uFF1F\u4E3A\u4F55\u770B\u8D77\u6765\u4E00\u70B9\u90FD\u4E0D\u50CF\uFF1F\r\n21\r\n\u5728\u4F20\u9001\u9B54\u6CD5\u542F\u52A8\u540E\uFF0C\u6211\u611F\u89C9\u5230\u6709\u6781\u5F3A\u7684\u9B54\u529B\u4ECE\u4E2D\u5E72\u6270\uFF0C\u4F20\u9001\u9B54\u6CD5\u7684\u4F5C\u7528\u56E0\u6B64\u53D1\u751F\u4E86\u9519\u4E71\u3002\u3002\u5E0C\u5C14\u6CD5\uFF0C\u6211\u8BF4\u5F97\u6CA1\u9519\u5427\uFF1F\r\n25\r\n\u662F\u7684\uFF0C\u4F20\u9001\u8FC7\u7A0B\u53D7\u5230\u8FD9\u79CD\u5E72\u6270\uFF0C\u6211\u4EEC\u6CA1\u6709\u5168\u90E8\u5D4C\u5230\u5CA9\u58C1\u91CC\u53BB\u5C31\u8BE5\u5E86\u5E78\u4E0D\u5DF2\u4E86\u3002\u4E0D\u8FC7\u8FD9\u91CC\u5E94\u8BE5\u79BB\u539F\u6765\u7684\u76EE\u7684\u5730\u4E0D\u8FDC\uFF0C\u8FD9\u4E2A\u6211\u5927\u6982\u53EF\u4EE5\u786E\u5B9A\u3002\u3002\u3002\r\n1\r\n\u53EF\u6076\uFF0C\u539F\u6765\u53C8\u662F\u654C\u4EBA\u641E\u7684\u9B3C\uFF01\r\n28\r\n\u54A6\uFF01\u4EC0\u4E48\u65F6\u5019\u591A\u4E86\u597D\u5927\u4E00\u7968\u4EBA\u51FA\u6765\uFF1F\u4ED6\u4EEC\u662F\u600E\u4E48\u6765\u5230\u8FD9\u91CC\u7684\uFF0C\u6211\u4EEC\u5C45\u7136\u6BEB\u65E0\u77E5\u89C9\uFF1F\r\n29\r\n\u4EC0\u4E48\uFF1F\u662F\u654C\u4EBA\u5417\uFF1F\r\n28\r\n\u770B\u8D77\u6765\u4E0D\u50CF\uFF0C\u8FD8\u662F\u5148\u8FC7\u53BB\u6253\u4E2A\u7167\u9762\u518D\u8BF4\uFF01\r\n6\r\n\u54CE\u5440\uFF0C\u6709\u4EBA\u6BD4\u6211\u4EEC\u5148\u6765\u4E86\u5462\uFF01\r\n22\r\n\u654C\u4EBA\u8FD9\u4E48\u5FEB\u5C31\u6765\u4E86\u5417\uFF1F\r\n16\r\n\u4E0D\u50CF\uFF0C\u5BF9\u65B9\u53EA\u6709\u4E24\u4E2A\u4EBA\u800C\u5DF2\u3002\u3002\u597D\u8C61\u60F3\u548C\u6211\u4EEC\u8C08\u8BDD\u7684\u6837\u5B50\u3002\r\n28\r\n\u4E0D\u77E5\u5404\u4F4D\u4E3A\u4F55\u8DCB\u6D89\u5343\u91CC\uFF0C\u6765\u5230\u8FD9\u6C99\u6F20\u4E4B\u4E2D\u7684\u5E9F\u589F\uFF1F\u662F\u548C\u6211\u4EEC\u4E00\u6837\u4E3A\u4E86\u7814\u7A76\u9057\u8FF9\u800C\u6765\u7684\u5417\uFF1F\r\n1\r\n\u554A\uFF01\u4F60\u4E0D\u662F\u5361\u91CC\u65AF\u53D4\u53D4\u5417\uFF1F\r\n28\r\n\u4F60\u8BF4\u4EC0\u4E48\uFF1F\u4F60\u600E\u4E48\u77E5\u9053\u6211\u53EB\u5361\u91CC\u65AF\uFF1F\r\n1\r\n\u5361\u91CC\u65AF\u53D4\u53D4\uFF0C\u6211\u662F\u7D22\u5C14\u554A\uFF01\u5C0F\u65F6\u4FAF\u4F60\u7ECF\u5E38\u5E26\u6211\u4EEC\u53BB\u73A9\uFF0C\u8FD8\u6559\u6211\u6B66\u672F\u7684\u3002\u3002\u3002\u3002\r\n3\r\n\u4F60\u8FD9\u4E48\u4E00\u8BF4\uFF0C\u6211\u4E5F\u60F3\u8D77\u6765\u4E86\uFF01\u4ED6\u7684\u786E\u662F\u66FE\u7ECF\u6559\u8FC7\u6211\u4EEC\u6B66\u672F\u7684\u5361\u91CC\u65AF\u53D4\u53D4\uFF01\r\n28\r\n\u4F60\u662F\u7D22\u5C14\u738B\u5B50\u5417\uFF1F\u90A3\u4F60\u5C31\u662F\u5DF4\u62C9\u591A\u7684\u513F\u5B50\u4E9A\u96F7\u65AF\u4E86\uFF01\u6211\u8BB0\u5F97\u4F60\u4EEC\u4ECE\u5C0F\u5C31\u5728\u4E00\u8D77\u7684\u3002\r\n3\r\n\u7B54\u5BF9\u5566\u5361\u91CC\u65AF\u53D4\u53D4\uFF0C\u4F60\u679C\u7136\u8FD8\u8BB0\u5F97\u6211\u4EEC\uFF01\u771F\u662F\u597D\u4E45\u4E0D\u89C1\u4E86\u3002\r\n1\r\n\u542C\u7236\u8BF4\u60A8\u5230\u6D77\u5916\u6765\u63A2\u9669\uFF0C\u6211\u4EEC\u90FD\u795E\u5F80\u4E0D\u5DF2\u5462\uFF01\u771F\u6CA1\u60F3\u5230\u4F1A\u5728\u8FD9\u91CC\u9047\u89C1\u60A8\u3002\r\n28\r\n\u65F6\u95F4\u8FC7\u7684\u771F\u5FEB\uFF0C\u4F60\u4EEC\u90FD\u957F\u5927\u5566\uFF01\u96F7\u7279\u738B\u5B50\uFF0C\u965B\u4E0B\u8FD9\u4E9B\u65E5\u5B50\u8FD8\u597D\u5417\uFF1F\r\n1\r\n\u7236\u738B\u6BCD\u540E\u90FD\u5F88\u5B89\u5065\uFF0C\u4E0D\u8FC7\u8001\u5ACC\u751F\u6D3B\u5E73\u6DE1\u4E86\u4E9B\uFF0C\u5927\u6982\u662F\u7B49\u7740\u542C\u5361\u91CC\u65AF\u53D4\u53D4\u60A8\u7684\u5192\u9669\u6545\u4E8B\u5427\uFF01\r\n21\r\n\u54EA\uFF01\u53C8\u9047\u89C1\u4E86\u4E00\u4E2A\u719F\u4EBA\uFF0C\u8FD9\u53EF\u4E0D\u662F\u7F57\u5F97\u66FC\u5417\uFF1F\u4F60\u4E00\u4E2A\u597D\u597D\u7684\u8FB9\u9632\u5C06\u519B\u4E0D\u505A\uFF0C\u53C8\u8DD1\u6765\u8FD9\u91CC\u8003\u53E4\u5566\uFF1F\r\n29\r\n\u679C\u7136\u662F\u7EA6\u62FF\u4F60\u8FD9\u628A\u8001\u9AA8\u5934\uFF0C\u4E16\u754C\u4E0A\u5C31\u4F60\u6700\u6E05\u695A\u6211\u7684\u4E60\u6027\u3002\u4F60\u600E\u4E48\u4E5F\u820D\u5F97\u8DD1\u5230\u8FD9\u8352\u5C71\u91CE\u5916\u6765\u4E86\uFF1F\r\n21\r\n\u6211\u5012\u5FD8\u4E86\u95EE\u4F60\uFF0C\u8FD9\u91CC\u5230\u5E95\u662F\u54EA\u91CC\uFF1F\u6211\u4EEC\u662F\u88AB\u9B54\u6CD5\u4F20\u9001\u6765\u7684\u3002\r\n29\r\n\u5466\uFF0C\u8FD9\u8D9F\u8DEF\u53EF\u771F\u8FDC\u4E86\uFF01\u8FD9\u91CC\u662F\u5927\u9646\u897F\u5317\u65B9\u7684\u6C99\u6F20\u4E2D\u592E\u7684\u4E00\u4E2A\u7EFF\u6D32\uFF0C\u6211\u4E00\u76F4\u5BF9\u8FD9\u7EFF\u6D32\u4E2D\u7684\u5E9F\u589F\u611F\u5174\u8DA3\uFF0C\u6240\u4EE5\u548C\u8FD9\u670B\u53CB\u4E00\u8D77\u6765\u8C03\u67E5\u3002\r\n28\r\n\u4E0D\u7792\u5404\u4F4D\uFF0C\u6700\u8FD1\u6709\u4E00\u4F4D\u5B66\u8005\u5E2E\u6211\u89E3\u8BFB\u4E86\u4E00\u7BC7\u4E0A\u53E4\u7ECF\u5178\u7684\u8BB0\u8F7D\uFF0C\u6211\u6B63\u5728\u8FFD\u67E5\u5176\u4E2D\u4E00\u4E9B\u53E4\u7269\u7684\u4E0B\u843D\uFF0C\u6240\u4EE5\u78B0\u5DE7\u6765\u5230\u8FD9\u91CC\u3002\u3002\u3002\u3002\r\n199\r\n\u54D4\uFF0C\u53D1\u73B0\u5165\u4FB5\u8005\uFF01\u6307\u4EE4\uFF1A\u4FDD\u62A4\u98DE\u884C\u5CA9\uFF0C\u4EA4\u6218\u5E76\u6B7C\u706D\u5165\u4FB5\u8005\u3002\r\n101\r\n\u54D4\uFF0C\u6307\u4EE4\u786E\u8BA4\uFF01\u5F00\u59CB\u52A8\u4F5C\uFF01\r\n29\r\n\u563F\uFF0C\u90A3\u662F\u4EC0\u4E48\u602A\u4E1C\u897F\uFF1F\r\n28\r\n\u90A3\u662F\u5178\u7C4D\u4E2D\u6240\u8BB0\u8F7D\u7684\u53E4\u4EE3\u673A\u5175\uFF0C\u4ED6\u4EEC\u8D1F\u8D23\u4FDD\u62A4\u6240\u6709\u53E4\u4EE3\u4EBA\u6240\u7559\u4E0B\u6765\u7684\u5EFA\u7B51\u548C\u8BBE\u65BD\uFF0C\u4F1A\u5C06\u5165\u4FB5\u8005\u6740\u622E\u6B86\u5C3D\u3002\u3002\u3002\u3002\u73B0\u5728\u6CA1\u65F6\u95F4\u8BF4\u660E\u4E86\uFF0C\u51C6\u5907\u5E94\u4ED8\u8FD9\u4E9B\u5BB6\u4F19\u5427\uFF01\r\n1\r\n\u8BF4\u5230\u6253\u67B6\uFF0C\u6211\u7CBE\u795E\u5C31\u6765\u4E86\uFF01\u6211\u4EEC\u4E0A\uFF01\r\n199\r\n\u54D4\uFF0C\u6307\u4EE4\u7CFB\u7EDF\u5931\u6548\u3002\u3002\u4EFB\u52A1\u4E2D\u6B62\u3002\u3002\u6307\u4EE4\u4F20\u8F93\u5173\u95ED\u3002\u3002\u3002\r\n28\r\n\u4E0D\u6127\u662F\u53E4\u4EE3\u4EBA\u5EFA\u9020\u7684\u673A\u5175\uFF0C\u5E94\u4ED8\u8D77\u6765\u771F\u662F\u68D8\u624B\u7684\u5F88\u3002\u3002\u5E78\u597D\u5927\u5BB6\u90FD\u80FD\u72EC\u5F53\u4E00\u9762\uFF0C\u624D\u80FD\u987A\u5229\u6D88\u706D\u8FD9\u4E9B\u654C\u4EBA\u3002\r\n29\r\n\u5371\u673A\u5DF2\u8FC7\uFF0C\u73B0\u5728\u6211\u4EEC\u53EF\u4EE5\u4ED4\u7EC6\u7814\u7A76\u8FD9\u4E2A\u9057\u8FF9\u4E86\u3002\r\n3\r\n\u5361\u91CC\u65AF\u53D4\u53D4\uFF0C\u8FD9\u9057\u8FF9\u5230\u5E95\u6709\u4EC0\u4E48\u79D8\u5BC6\uFF0C\u4F60\u8FD8\u6CA1\u544A\u8BC9\u6211\u4EEC\u5462\uFF01\r\n28\r\n\u662F\u8FD9\u6837\u5417\uFF1F\u5176\u5B9E\u6211\u4C5F\u662F\u4ECE\u53E4\u7C4D\u4E0A\u770B\u6765\u7684\u3002\u636E\u8BF4\u773C\u524D\u8FD9\u4E2A\u5C0F\u4E18\u662F\u53E4\u4EE3\u4EBA\u6240\u9020\u7684\u98DE\u884C\u7528\u5177\uFF0C\u7ECF\u7531\u4E00\u652F\u4F20\u9001\u6CD5\u6756\u7684\u529B\u91CF\uFF0C\u53EF\u4EE5\u628A\u62E5\u6709\u300C\u5929\u7A7A\u4E4B\u94A5\u300D\u7684\u4EBA\u5E26\u5230\u9EC4\u91D1\u7684\u57CE\u5821\u4E0A\u53BB\u3002\r\n1\r\n\u5929\u7A7A\u4E4B\u94A5\uFF1F\u90A3\u4E0D\u5C31\u5728\u6211\u4EEC\u624B\u4E0A\u5417\uFF1F\r\n3\r\n\u300C\u4F20\u9001\u624B\u6756\u300D\u4E5F\u6709\u554A\uFF01\u6211\u4EEC\u5C31\u662F\u88AB\u5B83\u4F20\u9001\u5230\u8FD9\u91CC\u6765\u7684\u3002\r\n28\r\n\u771F\u7684\uFF1F\u90A3\u771F\u662F\u592A\u5DE7\u4E86\uFF01\r\n21\r\n\u6211\u4E00\u76F4\u8BA4\u4E3A\uFF0C\u6700\u8FD1\u5927\u9646\u4E0A\u7684\u5929\u5730\u5F02\u53D8\u548C\u795E\u79D8\u654C\u4EBA\u90FD\u548C\u8FD9\u300C\u9EC4\u91D1\u57CE\u300D\u6709\u5173\u3002\u5728\u53E4\u4EE3\u4F20\u8BF4\u4E2D\uFF0C\u9EC4\u91D1\u57CE\u603B\u548C\u6218\u4E89\uFF0C\u707E\u5384\u7B49\u8131\u4E0D\u4E86\u5173\u7CFB\uFF0C\u6240\u4EE5\u6211\u4EEC\u4E00\u76F4\u90FD\u5728\u8FFD\u67E5\u8FD9\u5176\u4E2D\u7684\u5173\u8054\u3002\r\n28\r\n\u8FD9\u786E\u662F\u6709\u52A0\u4EE5\u67E5\u660E\u7684\u5FC5\u8981\u3002\u7D22\u5C14\u6BBF\u4E0B\uFF0C\u65E2\u7136\u8FD9\u4E24\u4EF6\u4E1C\u897F\u90FD\u5DF2\u5230\u624B\uFF0C\u53EF\u4EE5\u8BA9\u6211\u548C\u4F60\u4EEC\u4E00\u8D77\u53BB\u770B\u770B\u5417\uFF1F\r\n1\r\n\u5F53\u7136\u53EF\u4EE5\uFF01\u6709\u5361\u91CC\u65AF\u53D4\u53D4\u540C\u884C\uFF0C\u4EC0\u4E48\u5BF9\u624B\u90FD\u4E0D\u8DB3\u4E3A\u60E7\u4E86\uFF01\r\n3\r\n\u662F\u5440\uFF01\r\n21\r\n\u6211\u542C\u8FC7\u8FD9\u4E1C\u897F\uFF0C\u636E\u8BF4\u5B83\u662F\u901A\u5F80\u9EC4\u91D1\u57CE\u5821\u7684\u552F\u4E00\u65B9\u6CD5\u3002\r\n28\r\n\u6211\u4EEC\u5E76\u672A\u9884\u6599\u5230\u4F1A\u6709\u654C\u4EBA\u51FA\u73B0\uFF0C\u8FD9\u56DE\u7B97\u662F\u76F8\u5F53\u7684\u60CA\u9669\u3002\u3002\u4E0D\u8FC7\uFF0C\u6211\u60F3\u6211\u8FD8\u662F\u5148\u56DE\u57CE\u4F11\u517B\u4E00\u4E0B\u597D\u4E86\uFF0C\u5C06\u519B\u6BBF\u4E0B\uFF0C\u8FD9\u91CC\u5C31\u5148\u4EA4\u7ED9\u4F60\u4E86\u3002\r\n1\r\n\u5361\u91CC\u65AF\u53D4\u53D4\uFF0C\u4F60\u8981\u591A\u4FDD\u91CD\u5594\uFF01\r\n28\r\n\u7D22\u5C14\u6BBF\u4E0B\uFF0C\u60A8\u548C\u4E9A\u96F7\u65AF\u4E5F\u8981\u591A\u5C0F\u5FC3\uFF01\u4E0D\u8FC7\u4EE5\u4F60\u4EEC\u7684\u8868\u73B0\u770B\u6765\uFF0C\u6211\u60F3\u6211\u662F\u53EF\u4EE5\u653E\u5FC3\u4E86\u3002\u6211\u4EEC\u540E\u4F1A\u6709\u671F\uFF01\r\n21\r\n\u7F57\u5F97\u66FC\uFF0C\u90A3\u4F60\u6253\u7B97\u600E\u4E48\u529E\u5462\uFF1F\u6211\u5F88\u5E0C\u671B\u80FD\u6709\u50CF\u4F60\u8FD9\u6837\u7684\u6B66\u58EB\u52A0\u5165\uFF0C\u8FD9\u5BF9\u6211\u4EEC\u7684\u6218\u6597\u529B\u6709\u5F88\u5927\u7684\u63D0\u5347\u3002\r\n29\r\n\u6211\u3002\u3002\u5509\uFF0C\u6211\u60F3\u3002\u3002\u6211\u8FD8\u662F\u4E0D\u592A\u9002\u5408\u3002\u8001\u53CB\uFF0C\u6211\u4E5F\u8981\u56DE\u57CE\u4E86\uFF0C\u5E0C\u671B\u4F60\u4EEC\u6B64\u884C\u987A\u5229\uFF0C\u90FD\u80FD\u5E73\u5B89\u5F52\u6765\u3002\r\n18\r\n\u5509\uFF0C\u90FD\u662F\u56E0\u4E3A\u6211\u7684\u5173\u7CFB\u3002\u3002\u3002\u3002\r\n13\r\n\u524D\u8F88\uFF0C\u8FD9\u600E\u4E48\u8BF4\uFF1F\r\n18\r\n\u8FD9\u662F\u4E00\u4EF6\u5F88\u4E45\u4EE5\u524D\u7684\u5F80\u4E8B\u4E86\u3002\u3002\u3002\u3002\u90A3\u65F6\u7F57\u5F97\u66FC\u5C06\u519B\u8FD8\u5728\u7981\u536B\u519B\u7EDF\u9886\u4EFB\u5185\uFF0C\u800C\u6211\u624D\u5212\u6210\u4E3A\u7981\u536B\u519B\u9A91\u58EB\u4E0D\u4E45\u3002\u3002\u3002\r\n13\r\n\u554A\uFF01\u6211\u60F3\u8D77\u6765\u4E86\uFF01\u90A3\u65F6\u524D\u8F88\u4F60\u5411\u5C06\u519B\u4ED6\u3002\u3002\u3002\r\n18\r\n\u662F\u7684\uFF0C\u90A3\u65F6\u592A\u5E74\u8F7B\u7684\u6211\u88AB\u611F\u60C5\u51B2\u660F\u4E86\u5934\uFF0C\u5728\u5927\u5EAD\u5E7F\u4F17\u9762\u524D\u5411\u5C06\u519B\u8868\u660E\u7231\u610F\u3002\u4F46\u662F\u5C06\u519B\u7684\u592B\u4EBA\u59AE\u8389\u516C\u4E3B\u662F\u965B\u4E0B\u6700\u5C0F\u7684\u59B9\u59B9\uFF0C\u6211\u8FD9\u4E48\u505A\u8BA9\u4ED6\u975E\u5E38\u4E3A\u96BE\uFF0C\u7ED3\u679C\u5C06\u519B\u5411\u965B\u4E0B\u8BF7\u8C03\u8FB9\u7586\uFF0C\u5C31\u53EA\u4E3A\u4E86\u907F\u5F00\u6211\u3002\u3002\u3002\u3002\r\n13\r\n\u539F\u6765\u662F\u8FD9\u6837\u3002\r\n18\r\n\u90A3\u65F6\u7684\u6211\u4F24\u5FC3\u6B32\u7EDD\uFF0C\u867D\u7136\u628A\u5168\u90E8\u5FC3\u601D\u7528\u5728\u5251\u672F\u4E0A\uFF0C\u4ECD\u7136\u5FD8\u4E0D\u4E86\u8FD9\u4EF6\u4E8B\uFF0C\u56E0\u6B64\u624D\u79BB\u5F00\u9A91\u58EB\u56E2\u5230\u6DF1\u5C71\u4E2D\u4FEE\u7EC3\u3002\u3002\u8FD9\u4E48\u591A\u5E74\u4EE5\u540E\uFF0C\u6211\u5DF2\u7ECF\u4E0D\u5728\u91CA\u6000\uFF0C\u4F46\u5C06\u519B\u8FD8\u8FD9\u4E48\u5728\u4E4E\uFF0C\u4F60\u4EEC\u5C31\u53EF\u4EE5\u77E5\u9053\u5F53\u5E74\u6211\u8BA9\u4ED6\u591A\u4E48\u56F0\u6270\u4E86\u3002\r\n1\r\n\u6CA1\u5173\u7CFB\uFF01\u5BC6\u8482\u524D\u8F88\uFF0C\u5C06\u519B\u7684\u4EFD\u5C31\u7B97\u662F\u7531\u4F60\u4EE3\u66FF\u4E86\uFF0C\u4ECA\u540E\u4F60\u4E0D\u4F46\u662F\u4E3A\u4E86\u5927\u5BB6\u800C\u6218\uFF0C\u4E5F\u662F\u4E3A\u4E86\u5C06\u519B\u800C\u6218\uFF0C\u8FC7\u53BB\u7684\u9057\u60BE\u548C\u611F\u4F24\uFF0C\u5C31\u8BA9\u5B83\u5728\u6218\u9635\u4E2D\u70DF\u6D88\u4E91\u6563\uFF01\r\n18\r\n\u3002\u3002\u7D22\u5C14\uFF0C\u8C22\u8C22\u4F60\u3002\u6211\u4F1A\u8BB0\u4F4F\u8FD9\u53E5\u8BDD\u7684\u3002\r\n29\r\n\u8001\u53CB\uFF0C\u6211\u5F88\u5E0C\u671B\u80FD\u4E0E\u4F60\u4EEC\u540C\u884C\uFF0C\u53EF\u662F\u6211\u662F\u53D7\u965B\u4E0B\u7684\u4EFB\u547D\uFF0C\u5728\u6B64\u62C5\u4EFB\u8FB9\u9632\u5C06\u519B\uFF0C\u9664\u975E\u6709\u965B\u4E0B\u7684\u8C15\u547D\uFF0C\u5426\u5219\u64C5\u79BB\u804C\u5B88\u89C6\u540C\u6297\u547D\u3002\r\n21\r\n\u662F\u8FD9\u6837\u5417\uFF1F\u3002\u3002\u771F\u662F\u9057\u61BE\uFF0C\u6211\u672C\u6765\u4EE5\u4E3A\u53EF\u4EE5\u518D\u770B\u5230\u4F60\u6614\u65E5\u7684\u82F1\u59FF\u5462\u3002\u3002\u3002\u3002\r\n29\r\n\u8FD9\u4E5F\u662F\u4EF6\u6CA1\u529E\u6CD5\u7684\u4E8B\u3002\u3002\u8001\u53CB\uFF0C\u4FDD\u91CD\uFF01\u6211\u5F97\u56DE\u57CE\u4E86\u3002\u613F\u4F60\u4EEC\u6B64\u884C\u987A\u5229\uFF0C\u5E73\u5B89\u5F52\u6765\u3002\r\n29\r\n\u662F\u5417\uFF1F\u96BE\u5F97\u542C\u4F60\u8FD9\u6837\u5938\u8D5E\u6211\uFF0C\u5982\u679C\u6211\u8FD9\u628A\u8001\u9AA8\u5934\u8FD8\u80FD\u6D3E\u5F97\u4E0A\u7528\u573A\uFF0C\u90A3\u5F53\u7136\u662F\u4E50\u610F\u4E4B\u81F3\u3002\u54C8\u54C8\u54C8\uFF01\r\n6\r\n\u592A\u597D\u4E86\uFF01\u6211\u77E5\u9053\u7F57\u5FB7\u66FC\u5C06\u519B\u7684\u6218\u6280\u4E00\u76F4\u90FD\u662F\u6CA1\u8BDD\u8BF4\u7684\uFF01\r\n29\r\n\u54A6\uFF0C\u4F60\u4E0D\u662F\u3002\u3002\u4F60\u4E0D\u662F\u5E0C\u8389\u4E9A\u516C\u4E3B\u5417\uFF1F\u4E3A\u4F55\u6BBF\u4E0B\u3002\u3002\u4F1A\u5728\u8FD9\u91CC\uFF1F\r\n6\r\n\u5C06\u519B\u4F60\u90FD\u53EF\u4EE5\u8DF7\u73ED\u6765\u8003\u53E4\u4E86\uFF0C\u6211\u600E\u4E48\u53EF\u4EE5\u5F85\u5728\u5BAB\u91CC\u53D1\u5446\u5462\uFF1F\r\n21\r\n\u597D\u4E86\uFF0C\u522B\u5927\u60CA\u5C0F\u602A\u4E86\uFF0C\u4E3A\u4E86\u89E3\u51B3\u8FD9\u4EF6\u4E8B\u60C5\uFF0C\u738B\u56FD\u7684\u5F3A\u8005\u52C7\u58EB\u51E0\u4E4E\u90FD\u5230\u9F50\u4E86\uFF0C\u6211\u4EEC\u5148\u60F3\u60F3\u63A5\u4E0B\u6765\u8981\u600E\u4E48\u529E\u5427\uFF01\r\n25\r\n\u3002\u3002\u6211\u8BD5\u4E86\u4E00\u4E0B\uFF0C\u8FD9\u5C0F\u4E18\u4E0A\u7684\u6CD5\u9635\u597D\u8C61\u5BF9\u8FD9\u6CD5\u6756\u4E0A\u7684\u9B54\u529B\u6709\u53CD\u