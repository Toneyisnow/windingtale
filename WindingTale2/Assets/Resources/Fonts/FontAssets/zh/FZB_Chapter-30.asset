    characterSetSelectionMode: 8
    characterSequence: "\u7B2C\u4E09\u5341\u7AE0\u3000\u4F20\u8BF4\u7684\u7EC8\u7AE0\r\n\u7D22\u5C14\u6216\u60A0\u59AE\u6B7B\u4EA1\r\n\u7A7A\u9B54\u795E\u6B7B\u4EA1\r\n3\r\n\u5514\u3002\u3002#\u6211\u4EEC\u8FD8\u6D3B\u7740\u5417\uFF1F\r\n21\r\n\u597D\u5F3A\u70C8\u7684\u9707\u52A8\uFF01#\u4E0D\u8FC7\u6211\u6CA1\u6709\u611F\u89C9\u5230\u4EC0\u4E48\u5F02\u72B6\u3002\u3002\u3002\u3002\r\n1\r\n\u563F\uFF0C\u8FD9\u662F\u600E\u4E48\u56DE\u4E8B\uFF1F\r\n999\r\n\u54FC\uFF0C\u6211\u4EEC\u7684\u547D\u771F\u5927\u3002\u3002#\u770B\u6765\u6B21\u53CD\u5E94\u7089\u5E76\u672A\u5B8C\u5168\u5931\u6548\uFF0C\u867D\u7136\u8D85\u8377\u7684\u78C1\u754C\u80FD\u91CF\u7206\u53D1\u9020\u6210\u4E86\u90E8\u5206\u7A7A\u95F4\u626D\u66F2\uFF0C\u4E0D\u8FC7\u8FD9\u53CD\u5E94\u662F\u6682\u65F6\u6027\u7684\uFF0C\u5F71\u54CD\u5E76\u4E0D\u5F88\u5927\u3002#\u54FC\u54FC\u54FC\u3002\u3002\u3002\u3002\r\n2\r\nASR-06\uFF0C\u6211\u4EEC\u624D\u521A\u6361\u56DE\u4E00\u6761\u547D\u96BE\u9053\u4F60\u8FD8\u3002\u3002\uFF1F\r\n999\r\nASR-07\uFF0C\u6211\u4F1F\u5927\u7684\u8BA1\u5212\u5DEE\u70B9\u6BC1\u5728\u4F60\u624B\u91CC\uFF0C\u8FD9\u6B21\u6211\u4E0D\u4F1A\u518D\u91CD\u8E48\u8986\u8F99\u4E86\uFF0C\u6211\u8981\u5148\u628A\u4F60\u548C\u8FD9\u5E2E\u877C\u8681\u5F7B\u5E95\u6D88\u706D\u6389\uFF0C\u518D\u91CD\u65B0\u5F00\u59CB\u6267\u884C\u8BA1\u5212\u3002\u3002\u3002\r\n1\r\n\u6B20\u63CD\u7684\u5BB6\u4F19\uFF0C\u5230\u73B0\u5728\u4F60\u5C45\u7136\u8FD8\u4E0D\u6B7B\u5FC3\uFF0C\u4F60\u771F\u7684\u628A\u6211\u7ED9\u641E\u706B\u4E86\u3002\u3002\u3002\u3002#\u4ECA\u5929\u975E\u5BB0\u4E86\u4F60\u4E0D\u53EF\uFF01\r\n3\r\n\u6765\u5427\uFF01#\u4F19\u4F34\u4EEC\uFF0C\u6211\u4EEC\u4E00\u8D77\u6D88\u706D\u8FD9\u4E2A\u4E07\u6076\u7684\u539F\u51F6\uFF01\r\n999\r\n\u5488\u5488\u5488\u3002\u3002\u3002\u3002\u3002\u3002#\u4E00\u7FA4\u4E0D\u77E5\u6B7B\u6D3B\u7684\u5BB6\u4F19\u3002\r\n999\r\n\u90FD\u51FA\u6765\u5427\uFF01\r\n3\r\n\u54A6\uFF01\u8FD9\u4E9B\u5BB6\u4F19\u4E0D\u662F\u65E9\u5C31\u88AB\u6211\u4EEC\u6446\u5E73\u4E86\uFF1F\u600E\u4E48\u53C8\u3002\u3002\r\n999\r\nASR-07\uFF0C\u4F60\u4E0D\u5728\u7684\u8FD9\u6BB5\u65F6\u95F4\u6211\u81F4\u529B\u4E8E\u53D1\u5C55\u751F\u5316\u5408\u6210\u4EBA\uFF0C\u8FD9\u56DB\u4E2A\u9B54\u795E\u5C31\u662F\u6211\u7684\u5F97\u610F\u6770\u4F5C\uFF01\u4ED6\u4EEC\u4E0D\u8FC7\u6211\u5236\u9020\u51FA\u6765\u7684\u751F\u547D\u4F53\uFF0C\u6240\u4EE5\u635F\u5931\u4E86\u968F\u65F6\u53EF\u4EE5\u518D\u9020\u3002\u3002#\u8FD9\u4E00\u6279\u662F\u6211\u6700\u65B0\u7684\u6539\u826F\u7248\u672C\uFF0C\u7EDD\u5BF9\u4E0D\u4F1A\u518D\u8F93\u7ED9\u4F60\u4EEC\uFF01\r\n2\r\n\u3002\u54FC\uFF0C\u7B49\u4E00\u4E0B\uFF01\r\n999\r\n\u4F60\u8FD8\u6709\u4EC0\u4E48\u9057\u8A00\u5417\uFF1F\r\n2\r\n\u8EAB\u4E3A\u8FD9\u4E2A\u8981\u585E\u7684\u4E24\u5927\u4E2D\u67A2\uFF0C\u6211\u4EEC\u672C\u6765\u5E94\u8BE5\u534F\u529B\u5171\u4E8B\u7684\uFF0C\u5F88\u9057\u61BE\u6211\u4EEC\u4ECA\u5929\u5FC5\u987B\u503E\u529B\u5BF9\u51B3\u3002\u3002\u3002#\u6240\u4EE5\u6211\u4E5F\u4E0D\u9700\u518D\u9690\u85CF\u4E86\uFF0C\u5C31\u8BA9\u4F60\u770B\u770B\u7B2C\u4E00\u7A7A\u4E2D\u8981\u585E\u66A8\u7BA1\u7406\u4E2D\u67A2\u771F\u6B63\u7684\u529B\u91CF\u5427\uFF01\r\n3\r\n\u54A6\uFF0C\u4E0A\u4E00\u573A\u4ED7\u4E2D\u8EAB\u4E0A\u53D7\u7684\u4F24\u90FD\u75CA\u6108\u4E86\uFF01\r\n21\r\n\u6069\uFF0C\u6211\u89C9\u7684\u8EAB\u4E0A\u91CD\u65B0\u5145\u6EE1\u4E86\u529B\u91CF\uFF01\r\n999\r\n\u54FC\u54FC\u3002\u3002#\u60F3\u4E0D\u5230\u4F60\u8FD8\u6709\u8FD9\u79CD\u80FD\u529B\uFF0C\u8FD9\u6837\u4E0D\u8FC7\u80FD\u8BA9\u8FD9\u4E9B\u877C\u8681\u6491\u4E45\u4E00\u70B9\u800C\u5DF2\u3002\u3002#\u80DC\u5229\u4ECD\u5C06\u4F1A\u5C5E\u4E8E\u6211\uFF01\r\n1\r\n\u5C11\u7F57\u55E6\u4E86\uFF0C\u8981\u6253\u67B6\u5C31\u8FC7\u6765\u554A\uFF01\r\n999\r\n\u5927\u5730\u7684\u4EE3\u8A00\u8005\uFF0C\u8BA9\u8FD9\u4E9B\u611A\u8005\u77E5\u9053\u521B\u9020\u8005\u7684\u5A01\u4E25\uFF01\r\n201\r\n\u5730\u9B54\u795E\u9886\u547D\uFF01\r\n999\r\n\u6C34\u4E0E\u51B0\u7684\u5973\u738B\uFF0C\u5C06\u8FD9\u4E9B\u5BB6\u4F19\u51B0\u5C01\u5728\u6C38\u6052\u7684\u6B7B\u4E4B\u7262\u72F1\u4E2D\uFF01\r\n202\r\n\u6C34\u9B54\u795E\u9886\u547D\uFF01\r\n999\r\n\u72C2\u98CE\u7684\u541F\u5531\u8005\uFF0C\u7528\u4F60\u7684\u5229\u5203\u5C06\u4ED6\u4EEC\u6495\u88C2\u6210\u8840\u8089\u7684\u98DE\u96FE\uFF01\r\n203\r\n\u98CE\u9B54\u795E\u9886\u547D\uFF01\r\n999\r\n\u70C8\u7130\u7684\u4E3B\u5BB0\uFF0C\u71C3\u8D77\u4F60\u7684\u5730\u72F1\u4E4B\u706B\uFF0C\u628A\u4ED6\u4EEC\u70E7\u5F97\u8FDE\u7070\u90FD\u4E0D\u5269\uFF01\r\n204\r\n\u706B\u9B54\u795E\u9886\u547D\uFF01\r\n999\r\n\u9057\u61BE\u7684\u5F88\uFF0C\u4E0D\u8BC6\u62AC\u4E3E\u7684\u4F60\u4EEC\u7ADF\u7136\u9009\u62E9\u63A5\u53D7\u4E2D\u672B\u7684\u5929\u7F5A\u3002\u3002\u80C6\u6562\u8FDD\u6297\u795E\u7684\u610F\u5FD7\u7684\u877C\u8681\u4EEC\u8FCE\u63A5\u4F60\u4EEC\u7684\u6700\u540E\u4E00\u523B\u5427\uFF01\r\n999\r\n\u8FD9\u600E\u4E48\u53EF\u80FD\u3002\u3002#\u6211\u662F\u81F3\u9AD8\u65E0\u4E0A\u7684\u521B\u9020\u8005\u548C\u652F\u914D\u8005\u3002\u3002#\u7ADF\u7136\u4F1A\u88AB\u8FD9\u4E9B\u5351\u5FAE\u7684\u877C\u8681\u7ED9\u6253\u5012\u3002\u3002\u3002\u3002\u4E0D\u3002\u3002\u3002\u3002\r\n2\r\n\u603B\u7B97\u7ED3\u675F\u4E86\u3002\u3002\u3002\u3002#\u8FD9\u4E2A\u5F88\u4E45\u4EE5\u524D\u5C31\u94F8\u6210\u7684\u9519\u8BEF\uFF0C\u7EC8\u4E8E\u5C31\u6B64\u6D88\u5931\u5728\u65F6\u95F4\u7684\u6D2A\u6D41\u4E4B\u4E2D\u4E86\u3002\u3002\u3002\u3002\r\n1\r\n\u3002\u3002\u6211\u4EEC\u7EC8\u4E8E\u6253\u8D62\u4E86\u8FD9\u573A\u4ED7\uFF01#\u60A0\u59AE\uFF0C\u771F\u662F\u592A\u597D\u4E86\uFF01\r\n21\r\n\u5F88\u9AD8\u5174\u6211\u4EEC\u7EC8\u4E8E\u89E3\u51B3\u4E86\u8FD9\u4EF6\u4E8B\u60C5\u3002\u3002\u3002#\u4E0D\u8FC7\uFF0C\u8EAB\u4E3A\u4E00\u4E2A\u5B66\u8005\uFF0C\u6211\u603B\u60F3\u77E5\u9053\u8FD9\u4E00\u5207\u7684\u6765\u9F99\u53BB\u8109\u3002\u3002#\u60A0\u59AE\u5C0F\u59D0\uFF0C\u4F60\u80FD\u7ED9\u6211\u4EEC\u4E00\u4E2A\u8BF4\u660E\u5417\uFF1F\r\n2\r\n\u3002\u3002\u3002\u3002\u3002\u3002\u6211\u5C31\u7B80\u77ED\u7684\u8BF4\u660E\u5427\u3002#\u8FD9\u4E2A\u7A7A\u4E2D\u8981\u585E\uFF0C\u4EE5\u53CA\u6211\u548C\u7A7A\u9B54\u795E\uFF0C\u90FD\u662F\u53E4\u4EE3\u4EBA\u6240\u5236\u9020\u7684\uFF0C\u6076\u9B54\u65CF\u4E5F\u662F\u53E4\u4EE3\u4EBA\u53D1\u5C55\u51FA\u6765\u7684\u6218\u6597\u7528\u751F\u7269\u3002\u3002\u3002\u3002\u3002#\u90A3\u65F6\u53E4\u4EE3\u4EBA\u6B63\u5728\u4E92\u76F8\u4E89\u6218\uFF0C\u4E3A\u4E86\u83B7\u53D6\u80DC\u5229\uFF0C\u53CC\u65B9\u5236\u9020\u51FA\u65E0\u6570\u7684\u6050\u6016\u6B66\u5668\uFF0C\u8FD9\u4E2A\u8981\u585E\u5C31\u662F\u5176\u4E2D\u7684\u4E00\u4E2A\u3002\u3002\u3002\u3002\r\n25\r\n\u81EA\u53E4\u6D41\u4F20\u7684\u300C\u5BA1\u5224\u4E4B\u65E5\u300D\u6218\u4E89\u5417\uFF1F#\u636E\u8BF4\u90A3\u573A\u6218\u4E89\u6BC1\u706D\u4E86\u5929\u7A7A\u4E0E\u5927\u5730\uFF0C\u76F4\u5230\u6570\u4E07\u5E74\u540E\u4E07\u7269\u624D\u518D\u6B21\u590D\u5174\u3002\u3002\u3002\u3002\r\n2\r\n\u662F\u7684\u3002\u53CC\u65B9\u4F7F\u7528\u6700\u7EC8\u6B66\u5668\u4E92\u76F8\u653B\u51FB\uFF0C\u6700\u540E\u53EA\u6709\u5C11\u6570\u53E4\u4EE3\u4EBA\u7684\u9886\u8896\u4E58\u7740\u98DE\u884C\u5668\u79BB\u5F00\u4E86\u8FD9\u4E2A\u661F\u7403\uFF0C\u5176\u4ED6\u7684\u90FD\u6B7B\u5728\u8FD9\u573A\u6218\u4E89\u4E2D\u3002\u3002\u3002\u3002#\u8FD9\u4E2A\u8981\u585E\u662F\u4E3A\u4E86\u5BF9\u5730\u538B\u5236\u653B\u51FB\u800C\u5EFA\u9020\u7684\uFF0C\u6211\u548C\u7A7A\u9B54\u795E\u8D1F\u8D23\u63A7\u5236\u8FD9\u8981\u585E\u7684\u4E2D\u67A2\uFF0C\u6211\u63A7\u5236\u548C\u7EF4\u6301\u8981\u585E\u7684\u8FD0\u884C\uFF0C#\u7A7A\u9B54\u795E\u4E0D\uFF0CASR-06\u5219\u8D1F\u8D23\u5BF9\u5730\u9762\u7684\u76D1\u89C6\u548C\u6B66\u5668\u7684\u4F7F\u7528\uFF0C#\u6362\u8A00\u4E4B\uFF0C\u8FD9\u4E2A\u8981\u585E\u662F\u7531\u6211\u548C\u7A7A\u9B54\u547B\u6240\u4E00\u8D77\u6307\u6325\u7684\u3002
      \r\n21\r\n\u771F\u4EE4\u4EBA\u96BE\u4EE5\u60F3\u8C61\u3002\u3002\u3002\u3002\r\n2\r\n\u6211\u4EEC\u90FD\u4EE5\u4EBA\u7684\u8089\u4F53\u63A5\u53D7\u8FC7\u7279\u6B8A\u7684\u518D\u9020\u548C\u5F3A\u5316\u624B\u672F\uFF0C\u80FD\u591F\u76F4\u63A5\u4EE5\u610F\u5FD7\u548C\u7CFB\u7EDF\u8FDE\u63A5\u5E76\u4F20\u8FBE\u5404\u9879\u547D\u4EE4\uFF0C\u800C\u4E14\u80FD\u4EE5\u4F11\u7720\u7684\u9632\u6B62\u6765\u9632\u6B62\u8089\u4F53\u4E0A\u7684\u8870\u8001\uFF0C\u6240\u4EE5\uFF0C\u5728\u7406\u8BBA\u4E0A\u6211\u4EEC\u53EF\u4EE5\u6C38\u751F\u4E0D\u6B7B\uFF0C\u6C38\u8FDC\u62C5\u4EFB\u7A7A\u4E2D\u8981\u585E\u7684\u63A7\u5236\u5DE5\u4F5C\u3002#\u5C31\u5728\u6B8B\u4F59\u7684\u53E4\u4EE3\u4EBA\u8981\u64A4\u79BB\u6B64\u5730\u7684\u65F6\u5019\uFF0C\u6211\u4EEC\u6536\u5230\u653B\u51FB\u6307\u4EE4\uFF0C\u547D\u4EE4\u6211\u4EEC\u7528\u6700\u7EC8\u6B66\u5668\u300C\u9ED1\u6697\u4E4B\u7130\u300D\u8F70\u70B8\u5730\u8868\u3002#\u53EF\u662F\u5C31\u5728\u6267\u884C\u547D\u4EE4\u7684\u524D\u4E00\u523B\uFF0C\u5374\u53C8\u6536\u5230\u6A21\u7CCA\u7684\u8BAF\u53F7\uFF0C\u547D\u4EE4\u6211\u4EEC\u4E2D\u6B62\u653B\u51FB\u3002\u4E4B\u540E\u6211\u4EEC\u518D\u4E5F\u6CA1\u6709\u6536\u5230\u8FC7\u4EFB\u4F55\u8BAF\u53F7\uFF0C\u6211\u4EEC\u5C31\u8FD9\u6837\u7B49\u5F85\u7740\u6C38\u8FDC\u4E5F\u4E0D\u4F1A\u518D\u6709\u7684\u6218\u6597\u547D\u4EE4\uFF0C\u548C\u8FD9\u5EA7\u5B64\u4F36\u4F36\u7684\u8981\u585E\u5728\u63A7\u5236\u98D8\u8361\u4E86\u4E09\u4E07\u5E74\u7684\u65F6\u5149\u3002\r\n1\r\n\u4E09\u3002\u3002\u4E09\u4E07\u5E74\uFF01#\u4F60\u4E0D\u4F1A\u89C9\u7684\u5F88\u5BC2\u5BDE\u5417\uFF1F\r\n2\r\n\u4E0D\u3002\u6211\u4EEC\u90FD\u5904\u5728\u4F11\u7720\u72B6\u6001\uFF0C\u6709\u72B6\u51B5\u901A\u8BAF\u7CFB\u7EDF\u4F1A\u81EA\u52A8\u53EB\u9192\u6211\u4EEC\uFF0C\u6240\u4EE5\u4E09\u4E07\u5E74\u7684\u65F6\u95F4\u5E76\u4E0D\u7B97\u4E45\u3002#\u6211\u4EEC\u4E00\u76F4\u6C89\u7761\u5230\u4E0D\u4E45\u4E4B\u524D\u3002\u3002\u3002\u3002\r\n21\r\n\u539F\u672C\u5904\u5728\u6C89\u7761\u72B6\u51B5\u4E0B\u7684\u8981\u585E\u4E3A\u4F55\u4F1A\u518D\u6B21\u82CF\u9192\uFF1F\r\n2\r\n\u8981\u585E\u53D1\u751F\u4E86\u4E00\u6B21\u610F\u5916\uFF0C\u5B89\u5168\u7CFB\u7EDF\u8BEF\u62A5\u8981\u585E\u906D\u53D7\u653B\u51FB\u3002\u3002\u3002#ASR-06\u8BA4\u4E3A\u90A3\u662F\u6765\u81EA\u5730\u9762\u4E0A\u7684\u653B\u51FB\uFF0C\u575A\u6301\u8981\u7EE7\u7EED\u4EE5\u524D\u7684\u653B\u51FB\u547D\u4EE4\uFF0C\u6211\u548C\u4ED6\u53D1\u751F\u5F88\u5927\u7684\u4E89\u6267\u3002#\u7531\u4E8E\u6211\u9192\u6765\u540E\u66FE\u5BF9\u5730\u8868\u505A\u8FC7\u89C2\u5BDF\uFF0C\u53D1\u73B0\u9646\u5730\u4E0A\u5DF2\u518D\u6B21\u51FA\u73B0\u751F\u547D\u548C\u6587\u660E\uFF0C\u6240\u4EE5\u5C31\u628A\u653B\u51FB\u7535\u8111\u6240\u4E0D\u53EF\u6216\u7F3A\u7684\u5355\u5143\u8BA1\u7B97\u6676\u7247\u62FF\u51FA\u6765\uFF0C\u4ECE\u8981\u585E\u4E0A\u4E22\u4E86\u4E0B\u53BB\u3002#\u4E09\u4E07\u5E74\u524D\u7684\u6218\u4E89\u5DF2\u7ECF\u591F\u4E86\uFF0C\u6211\u4E0D\u60F3\u770B\u5230\u518D\u4E00\u6B21\u7684\u60E8\u5267\u3002\u3002\u3002#\u7ED3\u679CASR-06\u53D1\u73B0\u4E86\u6211\u7684\u610F\u56FE\uFF0C\u5728\u4E89\u53D6\u6676\u7247\u7684\u9014\u4E2D\uFF0C\u6211\u5931\u8DB3\u8DCC\u4E86\u4E0B\u53BB\u3002\u3002\u3002\r\n3\r\n\u7ED3\u679C\u3002\u3002\u4F60\u5C31\u6389\u5230\u7F57\u7279\u5E1D\u4E9A\u6765\u4E86\u3002\r\n2\r\n\u521A\u9192\u6765\u7684\u65F6\u5019\uFF0C\u6211\u7684\u7CFB\u7EDF\u53D7\u5230\u4E25\u91CD\u51B2\u51FB\uFF0C\u90E8\u5206\u8BB0\u5FC6\u65E0\u6CD5\u5B58\u53D6\uFF0C\u6240\u4EE5\u6211\u5FD8\u8BB0\u4E86\u4EE5\u5F80\u7684\u4E00\u5207\u3002#\u90A3\u65F6\u65E0\u5FC3\u7684\u8BF4\u51FA\u60F3\u56DE\u5BB6\u7684\u8BDD\uFF0C\u7D22\u5C14\u4F60\u4EEC\u624D\u548C\u6211\u4E00\u8DEF\u6765\u5230\u8FD9\u91CC\uFF0C\u3002\u3002#\u8FD9\u662F\u547D\u8FD0\u4E4B\u795E\u7684\u5B89\u6392\u5427\uFF01\r\n21\r\n\u771F\u662F\u4EE4\u4EBA\u96BE\u4EE5\u7F6E\u4FE1\u3002\u3002\u3002#\u6211\u60F3\uFF0C\u8FD9\u4E00\u5207\u90FD\u662F\u795E\u7684\u65E8\u610F\uFF0C\u73B0\u5728\u6211\u4EEC\u5DF2\u6253\u5012\u4E86\u6700\u540E\u7684\u654C\u4EBA\uFF0C\u60A0\u59AE\u5C0F\u59D0\uFF0C\u5F80\u540E\u3002\u3002\u3002#\u4F60\u6253\u7B97\u600E\u4E48\u529E\u5462\uFF1F\r\n2\r\n\u6211\u4F1A\u7528\u7A7A\u95F4\u4F20\u9001\u88C5\u7F6E\u9001\u4F60\u4EEC\u56DE\u9A6C\u62C9\u5927\u9646\uFF0C\u7136\u540E\u6211\u4F1A\u628A\u8981\u585E\u5E26\u5230\u8D85\u7A7A\u95F4\u4E2D\uFF0C\u8BA9\u5B83\u6C38\u8FDC\u6C38\u8FDC\u7684\u4ECE\u8FD9\u4E2A\u4E16\u754C\u4E0A\u6D88\u5931\u3002\u3002#\u4E00\u5207\u5C31\u8BA9\u5B83\u5C31\u5C31\u6B64\u7ED3\u675F\u5427\uFF01\r\n1\r\n\u60A0\u59AE\uFF0C\u4F60\u4E0D\u548C\u6211\u4EEC\u4E00\u8D77\u8D70\u5417\uFF1F\r\n2\r\n\u4E0D\u3002\u6211\u672C\u6765\u5C31\u662F\u8FD9\u4E2A\u8981\u585E\u7684\u4E00\u90E8\u5206\uFF0C\u800C\u4E3A\u4E86\u4FDD\u8BC1\u8FD9\u79CD\u4E8B\u4E0D\u4F1A\u518D\u53D1\u751F\uFF0C\u6211\u4E5F\u5FC5\u987B\u5F85\u5728\u8FD9\u4E2A\u8981\u585E\u4E0A\u3002\u3002#\u6211\u60F3\u8FD9\u662F\u548C\u5927\u5BB6\u8BF4\u518D\u89C1\u7684\u65F6\u523B\u4E86\uFF0C\u8FD9\u4E9B\u65E5\u5B50\u4EE5\u6765\u7684\u5192\u9669\u4E0E\u79CD\u79CD\u56DE\u5FC6\u3002\u3002\u3002#\u6211\u4F1A\u6C38\u8FDC\u8BB0\u5728\u5FC3\u91CC\u3002\u3002\u3002\r\n1\r\n\u60A0\u59AE\uFF01\u4F60\u771F\u7684\u8981\u7559\u5728\u8FD9\u513F\uFF1F\u3002\u3002\u3002\r\n2\r\n\u7D22\u5C14\uFF0C\u6211\u771F\u7684\u5F88\u611F\u8C22\u4F60\uFF0C\u4F60\u5DF2\u7ECF\u5B9E\u73B0\u4E86\u8BFA\u8A00\uFF0C\u5C06\u6211\u9001\u56DE\u5BB6\u4E86\u3002#\u4F60\u5BF9\u6211\u6765\u8BF4\u662F\u5F88\u7279\u522B\u7684\uFF0C\u5728\u8BB0\u5FC6\u82CF\u9192\u7684\u5239\u90A3\uFF0C\u6211\u4E3A\u4E86\u81EA\u5DF1\u5C06\u9009\u62E9\u54EA\u4E00\u65B9\u9762\u800C\u8FF7\u4E71\uFF0C\u7136\u800C\u3002\u3002\u662F\u4F60\u8BA9\u6211\u505A\u4E86\u6700\u540E\u7684\u51B3\u5B9A\u3002\r\n1\r\n\u3002\u3002\u4E0D\u80FD\u4E3A\u4E86\u6211\u3002\u3002\u3002\r\n2\r\n\u7D22\u5C14\uFF0C\u6211\u4E86\u89E3\u4F60\u7684\u5FC3\u60C5\uFF0C\u4F46\u662F\u3002\u3002#\u6211\u5E76\u4E0D\u662F\u4E00\u822C\u7684\u5973\u5B50\uFF0C\u4E5F\u4E0D\u5C5E\u4E8E\u8FD9\u4E2A\u65B0\u7684\u4E16\u754C\u3002\u3002\u3002#\u5C31\u8BA9\u6211\u7559\u5728\u8