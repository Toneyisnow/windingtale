    characterSetSelectionMode: 8
    characterSequence: "16\r\n\u8FD9\u662F\u9A6C\u62C9\u5927\u9646\u7684\u571F\u5730\uFF01\u6211\u4EEC\u7EC8\u4E8E\u53C8\u56DE\u5230\u5BB6\u56ED\u4E86\u3002\u54C8\uFF0C\u591A\u8E29\u51E0\u4E0B\u8FD9\u575A\u5B9E\u7684\u571F\u5730\uFF01\r\n11\r\n\u554A~\u51C9\u723D\u7684\u5FAE\u98CE\uFF0C\u548C\u7166\u7684\u9633\u5149\uFF01\u8FD8\u662F\u8FD9\u4E2A\u4E16\u754C\u6BD4\u8F83\u7F8E\u597D\uFF01\r\n21\r\n\u5F88\u9AD8\u5174\u6211\u4EEC\u89E3\u51B3\u4E86\u4E00\u5207\u7684\u4E8B\u7AEF\uFF0C\u5E76\u4E14\u4FDD\u4F4F\u4E86\u8FD9\u4E2A\u4E16\u754C\u3002\u5927\u5BB6\u505A\u5F97\u5F88\u597D\uFF01\r\n6\r\n\u6211\u4F1A\u53EB\u7236\u738B\u529E\u4E2A\u76DB\u5927\u7684\u5E86\u529F\u5BB4\uFF0C\u6211\u4EEC\u5927\u5BB6\u597D\u597D\u5E86\u795D\u5E86\u795D\uFF01\u8FD9\u53EF\u662F\u8FDE\u738B\u56FD\u7981\u536B\u519B\u90FD\u505A\u4E0D\u5230\u7684\u4F1F\u5927\u6210\u5C31\u54E6\uFF01\r\n11\r\n\u4E9A\u96F7\u65AF\uFF0C\u5230\u65F6\u5019\u6211\u4EEC\u75DB\u5FEB\u7684\u559D\u4E00\u676F\uFF01\u4F60\u4F1A\u966A\u6211\u7684\u5427\uFF1F\r\n3\r\n\u8FD9\u4E2A\u3002\u3002\u6211\u8D1F\u8D23\u5728\u65C5\u9014\u4E2D\u4F8D\u536B\u7D22\u5C14\u738B\u5B50\uFF0C\u5982\u4ECA\u4E8B\u60C5\u5DF2\u7ECF\u5706\u6EE1\u89E3\u51B3\uFF0C\u4E3A\u4E86\u907F\u514D\u965B\u4E0B\u548C\u7687\u540E\u62C5\u5FE7\uFF0C\u6211\u60F3\u8FD8\u662F\u65E9\u70B9\u56DE\u7F57\u7279\u5E1D\u4E9A\u6BD4\u8F83\u597D\u3002\u3002\u3002\u3002\r\n11\r\n\u8FD9\u6837\u5417\u3002\u3002\u53EF\u662F\uFF0C\u53EF\u662F\u3002\u3002\u3002\u3002\u3002\u3002\u7559\u4E0B\u6765\u73A9\u4E2A\u51E0\u5929\u4E0D\u884C\u5417\uFF1F\r\n6\r\n\u6D1B\u5A1C\uFF0C\u65E2\u7136\u4F60\u820D\u4E0D\u5F97\u4E9A\u96F7\u65AF\u53EF\u4EE5\u548C\u4ED6\u4E00\u8D77\u56DE\u7F57\u7279\u5E1D\u4E9A\u554A\uFF0C\u8FC7\u51E0\u5929\u6211\u4E5F\u8981\u4EE5\u6B63\u5F0F\u8EAB\u4EFD\u524D\u5F80\u7F57\u7279\u5E1D\u4E9A\u62DC\u8BBF\uFF0C\u90A3\u65F6\u5019\u4F60\u518D\u548C\u6211\u4E00\u8D77\u53BB\u4E0D\u5C31\u597D\u4E86\u3002\r\n11\r\n\u6069\uFF0C\u8FD9\u6837\u7684\u8BDD\uFF0C\u90A3\u3002\u3002\u3002\u3002\u3002\u3002\u3002\u3002\u4E9A\u96F7\u65AF\uFF0C\u90A3\u6211\u4EEC\u5230\u65F6\u5019\u89C1\u4E86\uFF01\r\n3\r\n\u563F\uFF0C\u597D\u3002\u3002\u597D\u554A\uFF01(\u5509\uFF01\u8FD9\u4E0B\u5934\u5927\u4E86\u3002\u3002\u3002\u3002)\r\n21\r\n\u770B\u5230\u8FD9\u4E9B\u5E74\u8F7B\u4EBA\u7684\u6837\u5B50\uFF0C\u771F\u8BA9\u6211\u60F3\u8D77\u81EA\u5DF1\u5E74\u8F7B\u7684\u65F6\u5019\u3002\u5475\u5475\u5475\u3002\u3002\u3002\u3002\r\n12\r\n\u662F\u554A\uFF01\u6253\u8D62\u4E86\u8FD9\u4E48\u4E00\u573A\u4ED7\uFF0C\u8F7B\u677E\u8F7B\u677E\u4E5F\u662F\u5E94\u8BE5\u7684\u3002\u3002\u54A6\uFF1F\u7D22\u5C14\u5462\uFF1F\r\n25\r\n\u602A\u4E86\uFF0C\u521A\u521A\u8FD8\u5728\u8FD9\u91CC\u7684\u3002\u3002\u3002\u3002\u554A\uFF0C\u5728\u90A3\u8FB9\uFF01\r\n3\r\n\u7D22\u5C14\uFF0C\u600E\u4E48\u4E86\uFF1F\r\n1\r\n\u60A0\u59AE\u3002\u3002\u60A0\u59AE\u5728\u90A3\u91CC\uFF0C\u5728\u5929\u7A7A\u4E4B\u4E2D\u3002\u3002\u3002\u3002\r\n6\r\n\u6709\u5417\uFF1F\u6211\u4EC0\u4E48\u90FD\u6CA1\u770B\u5230\u3002\u3002\r\n11\r\n\u90A3\u662F\u3002\u3002\u90A3\u662F\u9EC4\u91D1\u57CE\uFF01\r\n21\r\n\u8FD9\u5C31\u662F\u51E0\u767E\u5E74\u6765\uFF0C\u4ECE\u672A\u6709\u4EBA\u89C1\u5230\u8FC7\u8D77\u5E90\u5C71\u771F\u9762\u76EE\u7684\u9EC4\u91D1\u57CE\u5417\uFF1F\r\n30\r\n\u3002\u3002\u3002\u3002\u6709\u7740\u795E\u4E0E\u5929\u7A7A\u7684\u5A01\u4E25\uFF0C\u5374\u53EA\u80FD\u5E26\u6765\u6B7B\u4EA1\u548C\u6BC1\u706D\u7684\u4F20\u8BF4\u4E4B\u57CE\u3002\u3002\u3002\u3002\r\n2\r\n\u3002\u3002\u3002\u3002\u7D22\u5C14\u3002\u3002\u3002\u3002\u6C38\u8FDC\u518D\u89C1\u4E86\uFF0C\u4F60\u8981\u597D\u597D\u4FDD\u91CD\u3002\u3002\u3002\u3002\r\n1\r\n\u662F\u60A0\u59AE\u7684\u58F0\u97F3\uFF01\u60A0\u59AE\u3002\u3002\u3002\u3002\r\n9\r\n\u90A3\u662F\u3002\u3002\u3002\u3002\u60A0\u59AE\u6700\u540E\u7684\u9053\u522B\u5427\uFF1F\r\n1\r\n\u3002\u3002\u3002\u3002\u8C22\u8C22\u4F60\uFF0C\u60A0\u59AE\uFF01\u5728\u5F80\u540E\u7684\u5C81\u6708\u4E2D\uFF0C\u6211\u4ECD\u4F1A\u6C38\u8FDC\u8BB0\u5F97\u4F60\u3002\u3002\u3002\u3002\u548C\u8FD9\u