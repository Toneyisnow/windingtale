    characterSetSelectionMode: 8
    characterSequence: "\u7B2C\u4E8C\u5341\u4E8C\u7AE0  \u8FDC\u53E4\u7684\u547C\u5524\r\n\u7D22\u5C14\u6216\u5E0C\u5C14\u6CD5\u6B7B\u4EA1\r\n\u654C\u5168\u706D\r\n1\r\n\u4E00\u8DEF\u6765\u5230\u4E86\u5854\u9876\uFF0C\u5C45\u7136\u90FD\u6CA1\u6709\u9047\u5230\u654C\u4EBA\uFF0C\u771F\u662F\u5947\u602A\uFF01\r\n3\r\n\u7D22\u5C14\uFF0C\u4E0D\u8981\u6389\u4EE5\u8F7B\u5FC3\uFF01\u8BF4\u4E0D\u5B9A\u654C\u4EBA\u90FD\u96C6\u4E2D\u5728\u5854\u9876\u7B49\u6211\u4EEC\u5462\uFF01\r\n1\r\n\u4E9A\u96F7\u65AF\uFF0C\u4F60\u597D\u8C61\u8BF4\u5BF9\u4E86\uFF01\u5854\u9876\u4E0A\u6709\u4E00\u5927\u7FA4\u4EBA\u8036\uFF01\r\n3\r\n\u54E6\uFF1F\r\n199\r\n\u547C\u547C\u547C\uFF0C\u4F60\u4EEC\u6765\u5F97\u6BD4\u6211\u9884\u671F\u7684\u8FD8\u65E9\u4E9B\uFF0C\u4E0D\u8FC7\u4E5F\u6CA1\u5173\u7CFB\uFF0C\u7B49\u6211\u628A\u4F60\u4EEC\u90FD\u89E3\u51B3\u540E\u518D\u6765\u529E\u4E8B\u5C31\u597D\u4E86\u3002\u3002\u3002\u3002\r\n25\r\n\u4F60\u4EEC\u6267\u610F\u8981\u5360\u9886\u8FD9\u5723\u7075\u4E4B\u5854\u7684\u7406\u7531\uFF0C\u60F3\u5FC5\u548C\u4F60\u4EEC\u5728\u6B64\u8FDB\u884C\u7684\u52FE\u5F53\u6709\u5173\u5427\uFF01\r\n199\r\n\u54C8\u54C8\u54C8\uFF0C\u53CD\u6B63\u4F60\u4EEC\u522B\u60F3\u6D3B\u7740\u79BB\u5F00\u5854\u9876\uFF0C\u6240\u4EE5\u544A\u8BC9\u4F60\u4EEC\u4E5F\u65E0\u59A8\u3002#\u8FD9\u5EA7\u5854\u662F\u5927\u9646\u4E0A\u6700\u63A5\u8FD1\u5929\u7A7A\u7684\u5730\u65B9\uFF0C\u6211\u7684\u4E3B\u4EBA\u8981\u5728\u6B64\u5EFA\u7ACB\u4E00\u4E2A\u4F20\u9001\u70B9\uFF0C\u5982\u6B64\u4ED6\u624D\u80FD\u628A\u9EBE\u4E0B\u7684\u519B\u961F\u4ECE\u5C45\u57CE\u9001\u5230\u8FD9\u5927\u9646\u4E0A\u3002\u3002\u3002\r\n25\r\n\u5C45\u57CE\uFF1F\u4F60\u4EEC\u7A76\u7ADF\u662F\u6765\u81EA\u4F55\u5904\uFF1F\u4F60\u7684\u4E3B\u4EBA\u53C8\u662F\u8C01\uFF1F\r\n199\r\n\u6211\u7684\u4E3B\u4EBA\u662F\u652F\u914D\u8005\uFF0C\u662F\u521B\u9020\u8005\uFF0C\u4E5F\u662F\u6BC1\u706D\u8005\u3002\u3002\u3002\u3002#\u5176\u4ED6\u7684\u4F60\u4EEC\u5C31\u4E0D\u7528\u77E5\u9053\u4E86\uFF0C\u51C6\u5907\u53D7\u6B7B\u5427\uFF01\r\n1\r\n\u51C6\u5907\u8981\u53D7\u6B7B\u7684\u662F\u4F60\u5427\uFF01\u770B\u5251\uFF01\r\n25\r\n\u5BF9\u624B\u7684\u5E95\u7EC6\u4E0D\u660E\uFF0C\u5927\u5BB6\u8981\u5C0F\u5FC3\u4E3A\u6218\uFF01\r\n201\r\n\u560E\u560E\u3002\u3002\u3002\u3002\u3002\u3002\uFF01\r\n199\r\n\u6765\u4E86\u5417\uFF0C\u5BB0\u4E86\u8FD9\u4E9B\u5BB6\u4F19\uFF01\r\n201\r\n\u560E\u560E\u560E\u3002\u3002\u3002\uFF01\r\n27\r\n\u54A6\uFF1F\u8FD9\u662F\u600E\u4E48\u56DE\u4E8B\uFF1F\u5854\u9876\u6253\u6210\u4E00\u7247\uFF1F\r\n1\r\n\u5582\uEF0C\u8FD9\u91CC\u6253\u7684\u6B63\u8D77\u52B2\uFF0C\u5982\u679C\u4E0D\u60F3\u53D7\u4F24\u5C31\u522B\u8FC7\u6765\uFF01\r\n27\r\n\u522B\u628A\u4EBA\u770B\u6241\u4E86\uFF01\u6211\u8D77\u7801\u4E5F\u662F\u4E2A\u9F99\u9A91\u58EB\u8036\uFF01\r\n25\r\n\u9F99\u9A91\u58EB\uFF1F\u597D\u4E45\u6CA1\u542C\u5230\u8FD9\u4E2A\u5D07\u9AD8\u7684\u540D\u53F7\u4E86\u3002\u3002\u3002\u3002\u4F60\u600E\u4E48\u4F1A\u6070\u597D\u6765\u5230\u8FD9\u91CC\u5462\uFF1F\r\n27\r\n\u8BF4\u6765\u8BDD\u957F\uFF0C\u6211\u81EA\u4ECE\u4E0D\u5C0F\u5FC3\u88AB\u6293\u4E4B\u540E\u5C31\u4E00\u76F4\u88AB\u5173\u5728\u6240\u5728\u4E0D\u660E\u7684\u7262\u623F\u4E2D\uFF0C\u51E0\u5929\u524D\u624D\u88AB\u8F6C\u9001\u5230\u8FD9\u5854\u91CC\u3002#\u521A\u624D\u6211\u542C\u5230\u5854\u9876\u6709\u6253\u6597\u58F0\uFF0C\u770B\u5B88\u7684\u4EBA\u53C8\u4E0D\u5728\uFF0C\u5C31\u8BBE\u6CD5\u6253\u7834\u7262\u95E8\u51FA\u6765\u770B\u770B\u3002\r\n3\r\n\u539F\u6765\u5982\u6B64\uFF0C\u73B0\u5728\u4F60\u6253\u7B97\u600E\u4E48\u529E\uFF1F\r\n27\r\n\u5F53\u7136\u662F\u52A0\u5165\u4F60\u4EEC\u4E00\u884C\uFF0C\u4FEE\u7406\u90A3\u4E2A\u5927\u5BB6\u4F19\u554A\uFF01\u6211\u8981\u597D\u597D\u548C\u6E05\u7B97\u8FD9\u7B14\u5E10\uFF01\r\n199\r\n\u624B\u4E0B\u8D25\u5C06\uFF0C\u8FD8\u4E0D\u8BA4\u8F93\u5417\uFF1F\u8FD9\u6B21\u6211\u4E0D\u4F1A\u518D\u5BA2\u6C14\u4E86\uFF01\r\n1\r\n\u5C11\u7F57\u55E6\uFF01\u5148\u5E94\u4ED8\u5B8C\u6211\u8FD9\u4E00\u5251\u518D\u8BF4\uFF01\r\n199\r\n\u3002\u3002\u8FD9\u4E9B\u5351\u8D31\u7684\u866B\u8681\u3002\u3002\u4E3A\u4F55\u4F1A\u5982\u6B64\u5389\u5BB3\u3002\u3002\u3002\u3002\u4E3B\u4EBA\u3002\u3002\u3002\u3002\r\n1\r\n\u54CE\uFF01\u53C8\u5931\u624B\u4E86\uFF0C\u672C\u6765\u8FD9\u56DE\u6211\u6709\u66F4\u591A\u8BDD\u60F3\u95EE\u4ED6\u3002\u3002\u3002\r\n25\r\n\u6CA1\u5173\u7CFB\uFF0C\u6211\u4EEC\u5F97\u5230\u4E86\u8FD9\u4F20\u9001\u6CD5\u6756\uFF0C\u53EA\u8981\u542F\u52A8\u4ED6\u4EEC\u5E03\u4E0B\u7684\u8FD9\u4E2A\u9B54\u6CD5\u9635\uFF0C\u5C31\u53EF\u4EE5\u76F4\u63A5\u4F20\u9001\u5230\u4ED6\u4EEC\u7684\u6839\u636E\u5730\u4E86\u3002\r\n21\r\n\u5E0C\u5C14\u6CD5\uFF0C\u8FD9\u79CD\u5355\u7A0B\u4F20\u9001\u5F88\u53EF\u80FD\u4E00\u53BB\u4E0D\u56DE\uFF0C\u4F60\u4E0D\u89C9\u5F97\u592A\u5192\u9669\u4E86\u5417\uFF1F\r\n25\r\n\u6CA1\u529E\u6CD5\uFF0C\u773C\u770B\u7740\u654C\u4EBA\u5C31\u8981\u5927\u4E3E\u8FDB\u653B\u4E86\uFF0C\u53EA\u6709\u524D\u5F80\u4ED6\u4EEC\u7684\u6839\u636E\u5730\u505A\u4E2A\u5F7B\u5E95\u89E3\u51B3\uFF0C\u624D\u6709\u53EF\u80FD\u963B\u6B62\u4ED6\u4EEC\u3002\u4E3A\u4E86\u4FDD\u62A4\u7CBE\u7075\u65CF\u548C\u6574\u4E2A\u9A6C\u62C9\u5927\u9646\uFF0C\u6211\u5DF2\u6709\u727A\u7272\u7684\u51B3\u5FC3\u3002\r\n21\r\n\u8FD9\u6837\u5417\u3002\u3002\u3002\r\n25\r\n\u7B49\u4E00\u4E0B\u6211\u5C31\u542F\u52A8\u4F20\u9001\u573A\uFF0C\u60F3\u53BB\u7684\u5C31\u81EA\u884C\u8D70\u8FDB\u8FD9\u9B54\u6CD5\u9635\u4E2D\uFF0C\u6211\u7EDD\u4E0D\u5F3A\u8FEB\u3002\r\n25\r\n\u4F60\u3002\u3002\u4F60\u4EEC\u3002\u3002\u3002\r\n21\r\n\u5E0C\u5C14\u6CD5\uFF0C\u5982\u679C\u5C31\u8FD9\u6837\u8BA9\u4F60\u4E00\u4E2A\u4EBA\u8D70\uFF0C\u6211\u7EA6\u62FF\u7684\u540D\u5B57\u4F1A\u88AB\u4ECA\u540E\u7684\u4E16\u4EBA\u6240\u803B\u7B11\u3002\u6211\u53EF\u4E0D\u662F\u4E2A\u8D2A\u751F\u6015\u6B7B\u7684\u4EBA\uFF0C\u66F4\u4E0D\u4F1A\u5728\u5371\u96BE\u65F6\u629B\u5F03\u670B\u53CB\uFF01\r\n3\r\n\u65E2\u7136\u90FD\u5230\u4E86\u8FD9\u91CC\uFF0C\u90A3\u8FD8\u6709\u4EC0\u4E48\u597D\u6015\u7684\uFF01\u6211\u4EEC\u76F8\u4FE1\uFF0C\u51E0\u4F4D\u524D\u8F88\u7684\u6307\u6325\u548C\u77E5\u8BC6\uFF0C\u4E00\u5B9A\u80FD\u5E26\u9886\u6211\u4EEC\u5EA6\u8FC7\u96BE\u5173\u7684\u3002\r\n1\r\n\u5C31\u662F\u8BF4\u554A\uFF01\u9A6C\u62C9\u5927\u9646\u4E0A\u7684\u5F3A\u8005\u5728\u6B64\u6D4E\u6D4E\u4E00\u5802\uFF0C\u8981\u51FB\u6E83\u654C\u4EBA\u6839\u636E\u5730\u6709\u4EC0\u4E48\u95EE\u9898\uFF01\u5E0C\u5C14\u6CD5\u5927\u5E08\uFF0C\u4F60\u8981\u5BF9\u6211\u4EEC\u81EA\u5DF1\u6709\u4FE1\u5FC3\u624D\u5BF9\uFF01\r\n25\r\n\u8C22\u8C22\u3002\u3002\u8C22\u8C22\u5927\u5BB6\u8FD9\u4E48\u76F8\u4FE1\u6211\uFF01\u65E2\u7136\u5982\u6B64\uFF0C\u6211\u8FD9\u5C31\u542F\u52A8\u4F20\u9001\u9B54\u6CD5\uFF01\r\n6\r\n\u54CE\uFF0C\u6211\u7B49\u4E0D\u53CA\u60F3\u770B\u770B\u6211\u4EEC\u4F1A\u53BB\u7684\u662F\u4E2A\u600E\u4E48\u6837\u7684\u5730\u65B9\uFF01\r\n25\r\n\u9A6C\u90A3\u5F97\u62C9\u3001\u4E9A\u5E03\u5229\u52A0\u3001\u827E\u7C73\u897F\u5F97\u62C9\u3001\u4F0A\u591A\u5361\u90A3\u74E6\uFF01\r\n"
