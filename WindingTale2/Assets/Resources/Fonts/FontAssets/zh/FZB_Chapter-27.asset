    characterSetSelectionMode: 8
    characterSequence: "\u7B2C\u4E8C\u5341\u4E03\u7AE0\u3000\u547D\u8FD0\u7684\u4EA4\u4F1A\u70B9\r\n\u7D22\u5C14\u6216\u4F18\u59AE\u6B7B\u4EA1\r\n\u51FB\u6BC1\u673A\u7532\u961F\u957F\r\n1\r\n\u8FD9\u91CC\u5C31\u662F\u9057\u8FF9\u4E86\u5417\uFF1F\u679C\u7136\u662F\u4E2A\u5F88\u8BE1\u5F02\u7684\u5730\u65B9\uFF01\r\n3\r\n\u6B64\u5730\u4E0D\u4EC5\u8BE1\u5F02\uFF0C\u8FD8\u6709\u5927\u6279\u654C\u4EBA\u5462\uFF1F\u51C6\u5907\u8FCE\u654C\u5427\uFF01\r\n25\r\n\u4E2D\u592E\u7684\u5E73\u53F0\u4F3C\u4E4E\u5C31\u662F\u4F20\u9001\u5730\u70B9\uFF0C\u5C31\u770B\u300C\u5929\u7A7A\u4E4B\u94A5\u300D\u80FD\u5426\u53D1\u751F\u4F5C\u7528\u4E86\uFF01\r\n201\r\n\u54D4\uFF1A\u654C\u4EBA\u53CA\u76EE\u6807\u51FA\u73B0\uFF0C\u51C6\u5907\u8FDB\u884C6\u53F7\u6218\u6597\u6307\u4EE4\u3002\r\n202\r\n\u547D\u4EE4\u786E\u8BA4\u3002\u76EE\u6807\u4F4D\u7F6E\u6807\u5B9A\uFF0C\u7CFB\u7EDF\u4F5C\u7528\u529F\u7387\u5168\u5F00\u30022\u79D2\u540E\u52A8\u4F5C\u5F00\u59CB\u3002\r\n2\r\n\u5440\r\n1\r\n\u60A0\u59AE\uFF01\u53EF\u6076\u3002\u3002\u7ADF\u6562\u5BF9\u5979\u4E0B\u624B\uFF01\u6211\u9976\u4E0D\u4E86\u4F60\u4EEC\uFF01\r\n201\r\n\u5236\u5FA1\u53CA\u7BA1\u7406\u4E2D\u67A2ASR-07\uFF0C\u5B8C\u6210\u8BB0\u5FC6\u5E93\u8FDE\u63A5\u3002\u8FDB\u884C\u63A7\u5236\u7A0B\u5F0F\u66F4\u65B0\u53CA\u635F\u574F\u8D44\u6599\u6392\u9664\u3002\r\n2\r\n\u554A\uFF01\u6211\u7684\u5934\uFF01\u3002\u3002\u6211\u7684\u5934\u597D\u8C61\u8981\u70B8\u5F00\u4E86\u3002\u3002\u3002\r\n1\r\n\u60A0\u59AE\uFF01\r\n201\r\n\u6545\u969C\u6392\u9664\u5B8C\u6210\uFF0C\u521D\u6B65\u68C0\u67E5\u5BF9\u5E94\uFF1A\u5404\u7CFB\u7EDF\u5B8C\u597D\u65E0\u635F\u3002ASR-07\uFF0C\u7EE7\u7EED\u6267\u884C\u4F60\u7684\u4EFB\u52A1\u3002\u5B8C\u6BD5\u3002\r\n2\r\n\u6211\u3002\u3002\u6211\u3002\u3002\u4E3A\u4EC0\u4E48\u3002\u3002\u3002\u3002\r\n1\r\n\u60A0\u59AE\uFF01\u60A0\u59AE\uFF01\u4F60\u8FD8\u597D\u5427\uFF01\u3002\u3002\u3002\u3002\u54A6\uFF0C\u4F60\u3002\u3002\u4F60\u4E3A\u4EC0\u4E48\u54ED\u4E86\uFF1F\r\n2\r\n\u7D22\u5C14\uFF0C\u522B\u7BA1\u6211\uFF0C\u3002\u3002\u4E0D\u7BA1\u600E\u6837\uFF0C\u5148\u6253\u5012\u8FD9\u4E9B\u5BB6\u4F19\uFF0C\u522B\u7684\u4EE5\u540E\u518D\u8BF4\u3002\u3002\u3002\u3002\r\n201\r\nASR-07\uFF0C\u4F60\u6709\u654C\u5BF9\u53CD\u5E94\uFF01\u4F60\u662F\u6211\u4EEC\u7684\u4E2D\u67A2\u4E4B\u4E00\uFF0C\u4E0D\u8BE5\u5BF9\u6211\u4EEC\u6709\u654C\u5BF9\u610F\u5FD7\uFF01\r\n202\r\n\u7D27\u6025\u72B6\u51B5\uFF0CASR-07\u51FA\u73B0\u9884\u671F\u5916\u73B0\u8C61\uFF0C\u5FEB\u901A\u77E5\u6700\u9AD8\u63A7\u5236\u4E2D\u67A2\u3002\u3002\u3002\u3002\r\n2\r\n\u654C\u4EBA\u5C31\u5728\u773C\u524D\u4E86\uFF0C\u8D76\u5FEB\u53D1\u52A8\u653B\u51FB\u554A\uFF01\r\n1\r\n\u5BF9\u554A\uFF01\u6211\u5728\u53D1\u4EC0\u4E48\u5446\uFF0C\u5927\u5BB6\u4E0A\uFF01\r\n3\r\n\u4E00\u5207\u7684\u8C1C\u5E95\u5C31\u5728\u773C\u524D\u4E86\uFF01\r\n201\r\n\u54D4\uFF01\u7D27\u6025\u72B6\u51B5\uFF0C\u8BF7\u6C42\u652F\u63F4\uFF01\r\n202\r\n\u54D4\uFF01\u7D27\u6025\u72B6\u51B5\uFF0C\u8BF7\u6C42\u652F\u63F4\uFF01\r\n203\r\n\u3002\u3002\u8B66\u544A\uFF0C\u4EFB\u52A1\u4E2D\u6B62\u3002\u3002ASR-07\u51FA\u73B0\u5F02\u5E38\u73B0\u8C61\uFF0C\u539F\u56E0\u65E0\u6CD5\u89E3\u6790\u3002\u3002\u3002\u3002\r\n2\r\n\u5C31\u662F\u8FD9\u4E2A\u4E86\uFF0C\u4F20\u9001\u7AD9\u3002\u3002\u597D\u4E45\u6CA1\u770B\u5230\u8FD9\u79CD\u4E1C\u897F\u4E86\u3002\u3002\u3002\r\n1\r\n\u60A0\u59AE\uFF1F\u4F60\u8FD8\u597D\u5427\uFF1F\r\n2\r\n\u7D22\u5C14\uFF0C\u6240\u6709\u8FC7\u53BB\u7684\u4E8B\uFF0C\u6211\u90FD\u60F3\u8D77\u6765\u4E86\u3002#\u8BF7\u539F\u8C05\u6211\u9A97\u4E86\u4F60\uFF0C\u53EF\u90A3\u65F6\u6211\u771F\u7684\u4E0D\u77E5\u9053\u3002\u3002\u3002\u3002\r\n1\r\n\u60A0\u59AE\uFF0C\u4E0D\u7BA1\u662F\u4E3A\u4E86\u4EC0\u4E48\u4E8B\uFF0C\u6211\u90FD\u4E0D\u4F1A\u602A\u4F60\u3002#\u6211\u53EA\u662F\u60F3\u9001\u4F60\u56DE\u5BB6\u3002\u3002\u5C31\u8FD9\u6837\u800C\u5DF2\uFF0C\u76F8\u4FE1\u6211\u5427\uFF01\r\n2\r\n\u597D\uFF0C\u90A3\u4E48\u3002\u3002\u6211\u7684\u5BB6\u5C31\u5728\u8FD9\u4E0A\u9762\uFF0C\u4F60\u613F\u610F\u9001\u6211\u56DE\u5BB6\u5417\uFF1F\r\n1\r\n\u5F53\u7136\uFF01\u8FD9\u4E0D\u662F\u6211\u4EEC\u7684\u7EA6\u5B9A\u5417\uFF1F\r\n25\r\n\u7D22\u5C14\uFF0C\u4F60\u8981\u5C0F\u5FC3\uFF01#\u8FD9\u5973\u5B69\u53D8\u5F97\u5F88\u5947\u602A\uFF0C\u8BF4\u4E0D\u5B9A\u5979\u539F\u672C\u662F\u654C\u65B9\u7684\u4EBA\u3002\u3002\u3002\u3002\r\n2\r\n\u7EA6\u62FF\u5148\u751F\uFF0C\u5E0C\u5C14\u6CD5\u5927\u5E08\uFF0C\u4F60\u4EEC\u6240\u8C13\u7684\u654C\u4EBA\u5C31\u5728\u8FD9\u8F6C\u9001\u7AD9\u4E4B\u540E\uFF0C\u88AB\u4F60\u4EEC\u79F0\u4E3A\u300C\u9EC4\u91D1\u57CE\u300D\u7684\u7B2C\u4E00\u7A7A\u4E2D\u8981\u585E\u4E0A\u3002\u3002\u3002\u3002#\u5982\u679C\u4F60\u4EEC\u60F3\u6253\u5012\u4ED6\uFF0C\u5C31\u8DDF\u7740\u6211\u6765\uFF0C\u4E0D\u7136\u7684\u8BDD\uFF0C\u5C31\u6211\u548C\u7D22\u5C14\u4E0A\u53BB\u4E5F\u53EF\u4EE5\u3002\u3002\u3002\u3002\u4F60\u4EEC\u610F\u4E0B\u5982\u4F55\u5462\uFF1F\r\n21\r\n\u3002\u3002\u3002\u3002\u60A0\u59AE\u5C0F\u59D0\uFF0C\u4F60\u7684\u8BB0\u5FC6\u5168\u90E8\u82CF\u9192\u4E86\u5417\uFF1F\r\n2\r\n\u662F\u7684\u3002\u6211\u5728\u53D7\u5230\u521A\u624D\u90A3\u4E2A\u673A\u5175\u7684\u4F20\u5BFC\u51B2\u51FB\u4E4B\u540E\uFF0C\u53D7\u635F\u7684\u8BB0\u5FC6\u90E8\u5206\u5F3A\u5236\u8FD8\u539F\u4E86\uFF0C\u5B83\u4EEC\u8BA4\u4E3A\u6211\u4F1A\u56DE\u5230\u5B83\u4EEC\u90A3\u4E00\u65B9\u3002#\u53EF\u60DC\u7684\u662F\uFF0C\u6211\u8FD9\u6BB5\u65E5\u5B50\u4EE5\u6765\u7684\u8BB0\u5FC6\u5E76\u6CA1\u6709\u56E0\u6B64\u6D88\u5931\u3002\u3002\u3002\u3002\u6211\u5DF2\u7ECF\u4E0D\u662F\u4EE5\u524D\u7684\u6211\u4E86\u3002\r\n21\r\n\u4E3A\u4EC0\u4E48\uFF1F\u3002\u3002\u6211\u77E5\u9053\u4F60\u5E76\u4E0D\u662F\u8FD9\u4E2A\u4E16\u754C\u7684\u4EBA\uFF0C\u4F46\u4E3A\u4F55\u4F60\u4F1A\u4E3A\u4E86\u6211\u4EEC\u3002\u3002\u3002\u3002\r\n2\r\n\u3002\u3002\u81EA\u79C1\u4E00\u70B9\u6765\u8BF4\uFF0C\u6211\u5E76\u4E0D\u662F\u4E3A\u4E86\u4F60\u4EEC\uFF0C\u6211\u662F\u4E3A\u4E86\u4E00\u4E2A\u4E00\u76F4\u4FDD\u62A4\u6211\u3001\u7167\u987E\u6211\u7684\u4EBA\u3002\u3002\u3002\u3002\u50CF\u6211\u8FD9\u6837\u7684\u4EBA\u662F\u5F88\u60B2\u54C0\u7684\uFF0C\u6211\u4EEC\u62E5\u6709\u4EBA\u7684\u4E00\u5207\uFF0C\u5374\u4E0D\u80FD\u505A\u4EFB\u4F55\u5E73\u51E1\u4EBA\u6240\u80FD\u505A\u7684\u4E8B\u60C5\uFF0C\u6240\u4EE5\uFF0C\u6211\u5F88\u73CD\u60DC\u8FD9\u6B21\u7684\u7ECF\u5386\u3002\u3002\u3002\u3002\u6211\u4E0D\u5BB9\u8BB8\u90A3\u4E2A\u65E0\u89C6\u8FD9\u4E00\u5207\u7684\u5BB6\u4F19\u4F24\u5BB3\u4ED6\u548C\u4ED6\u6240\u7231\u7684\u8FD9\u4E2A\u4E16\u754C\u3002\r\n21\r\n\u3002\u3002\u6211\u660E\u767D\u4E86\u3002\u60A0\u59AE\u5C0F\u59D0\uFF0C\u6211\u5F88\u9AD8\u5174\u4F60\u81EA\u59CB\u81F3\u7EC8\u90FD\u4F1A\u662F\u6211\u4EEC\u7684\u4F19\u4F34\u3002\u3002\u8981\u5BF9\u4ED8\u90A3\u4E2A\u5BB6\u4F19\uFF0C\u5149\u4F60\u548C\u7D22\u5C14\u662F\u4E0D\u884C\u7684\uFF0C\u5C31\u8BA9\u6211\u4EEC\u5927\u5BB6\u4E00\u8D77\u6765\u5427\uFF01\r\n2\r\n\u7EA6\u62FF\u5148\u751F\uFF0C\u8C22\u8C22\u4F60\u3002\u3002\u3002\u3002\r\n1\r\n\u60A0\u59AE\uFF0C\u4F60\u4EEC\u5728\u8BF4\u4EC0\u4E48\u554A\uFF01\u6211\u600E\u4E48\u542C\u4E0D\u592A\u61C2\u3002\u3002\r\n2\r\n\u3002\u3002\u7D22\u5C14\uFF0C\u7B49\u5230\u4E0A\u4E86\u9EC4\u91D1\u4E4B\u57CE\uFF0C\u6211\u4F1A\u8BA9\u4F60\u77E5\u9053\u6240\u6709\u4F60\u60F3\u77E5\u9053\u7684\uFF0C\u5728\u6B64\u4E4B\u524D\u5C31\u4E0D\u8981\u518D\u95EE\u8D77\u8FD9\u4E9B\u4E8B\u60C5\u4E86\u3002\u3002\u7B54\u5E94\u6211\u597D\u5417\uFF1F\r\n1\r\n\u5F53\u3002\u3002\u5F53\u7136\uFF01\u6211\u4E5F\u53EA\u662F\u968F\u53E3\u95EE\u95EE\u800C\u5DF2\uFF0C\u5C31\u5F53\u6211\u6CA1\u8BF4\u597D\u5566\uFF01\r\n21\r\n\u597D\u5566\uFF01\u5927\u5BB6\u53EF\u4EE5\u6574\u88C5\u5F85\u53D1\u4E86\uFF0C\u51C6\u5907\u8FCE\u5411\u6700\u540E\u7684\u654C\u4EBA\uFF01\u60A0\u59AE\u5C0F\u59D0\uFF0C\u8BF7\u4F60\u542F\u52A8\u8F6C\u9001\u88C5\u7F6E\u5427\uFF01\r\n2\r\n\u597D\u7684\uFF0C\u8BF7\u5927\u5BB6\u5728\u8FD9\u5E73\u53F0\u4E0A\u7AD9\u597D\uFF0C\u7D22\u5C14\uFF0C\u8BF7\u628A\u300C\u5929\u7A7A\u4E4B\u94A5\u300D\u7ED9\u6211\u3002\r\n1\r\n\u662F\u8FD9\u4E2A\u5427\uFF01\r\n2\r\n\u8C22\u8C22\u3002\u5927\u5BB6\u7AD9\u597D\u4E86\u3002\u3002\r\n2\r\n\u3002\u300201327344621073\u3002\u8BC6\u522B\u7801\u8FA8\u8BC6\u5B8C\u6210\u3002\u3002\u7B2C\u4E00\u63A7\u5236\u8981\u585E\uFF0C\u8BF7\u89E3\u9664\u51FA\u5165\u533A\u9632\u62A4\u969C\u58C1\uFF0C\u9884\u5B9A\u4E94\u79D2\u540E\u542F\u52A8\u8F6C\u9001\u7A0B\u5E8F\u3002\r\n1\r\n\u5514\u54C7\u554A\u554A\u554A\uFF01\r\n2\r\n\u7D22\u5C14\uFF0C\u8C22\u8C22\u4F60\u4E00\u8DEF\u4E0A\u4ECE\u7F57\u7279\u5E1D\u4E9A\u5230\u8FD9\u91CC\uFF0C\u4F60\u4E00\u76F4\u90FD\u90A3\u4E48\u7167\u987E\u6211\u3001\u4FDD\u62A4\u6211\u3002\u3002\u3002\u3002\r\n1\r\n\u8FD9\u662F\u6211\u8BE5\u505A\u7684\uFF0C\u4F60\u77E5\u9053\u3002\u3002\u6211\u4E00\u76F4\u5BF9\u4F60\u3002\u3002\u5BF9\u4F60\u3002\u3002\u3002\u3002\r\n2\r\n\u6211\u660E\u767D\u3002\u7D22\u5C14\uFF0C\u4F46\u73B0\u5728\u662F\u6211\u4EEC\u5206\u79BB\u7684\u65F6\u523B\u4E86\uFF0C\u5982\u679C\u6211\u73B0\u5728\u4E0D\u8D70\uFF0C\u5C31\u4F1A\u592A\u8FDF\u4E86\u3002\u3002\u3002\u3002\r\n1\r\n\u4E3A\u4EC0\u4E48\uFF1F\u4E0D\u662F\u7EA6\u597D\u8981\u6211\u9001\u4F60\u56DE\u5BB6\u7684\u5417\uFF1F\r\n2\r\n\u6CA1\u6709\u5929\u7A7A\u4E4B\u94A5\uFF0C\u53EA\u6709\u6211\u80FD\u76F4\u63A5\u4ECE\u6B64\u5730\u524D\u5F80\u9EC4\u91D1\u57CE\uFF0C\u7D22\u5C14\uFF0C\u8BF7\u5FD8\u4E86\u6211\u5427\uFF0C\u6211\u5E76\u4E0D\u662F\u4E00\u822C\u7684\u4EBA\u7C7B\uFF0C\u65E2\u4E0D\u80FD\u4E5F\u6CA1\u6709\u8D44\u683C\u63A5\u53D7\u4F60\u7684\u611F\u60C5\uFF0C\u8FD9\u662F\u547D\u8FD0\u7684\u5B89\u6392\u5427\u3002\u3002\u3002\u3002\r\n2\r\n\u7CFB\u7EDF\u6743\u9650\u5F3A\u5236\u63D2\u5165\uFF0CA1\u578B\u5206\u89E3\u4F20\u9001\u542F\u52A8\u5F85\u547D\uFF0C\u5750\u68071-1-72\u3002\u3002\r\n1\r\n\u60A0\u59AE\uFF01\u4E0D\u8981\u505A\u50BB\u4E8B\uFF01\r\n2\r\n\u7D22\u5C14\uFF0C\u4E0D\u8981\u8FC7\u6765\uFF01\u4E3A\u4E86\u4F60\uFF0C\u4E5F\u4E3A\u4E86\u8FD9\u4E2A\u4E16\u754C\u3002\u3002\u3002\u3002\u8BA9\u6211\u4E3A\u4F60\u505A\u8FD9\u6700\u540E\u7684\u4E00\u4EF6\u4E8B\u5427\uFF01\r\n21\r\n\u60A0\u59AE\u5C0F\u59D0\uFF01\u6709\u5173\u8FD9\u4E00\u5207\u4E8B\u4EF6\u7684\u6765\u9F99\u