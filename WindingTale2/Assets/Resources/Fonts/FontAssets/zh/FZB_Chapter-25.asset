    characterSetSelectionMode: 8
    characterSequence: "\u7B2C\u4E8C\u5341\u4E94\u7AE0  \u706B\u7130\u7684\u5BA1\u5224\r\n\u7D22\u5C14\u6216\u5723\u5BC7\u62C9\u65AF\u6B7B\u4EA1\r\n\u654C\u5168\u706D\r\n199\r\n\u679C\u7136\u4E0D\u6127\u662F\u9F99\u4EBA\u65CF\u4E4B\u957F\uFF0C\u7EC8\u4E8E\u8BA9\u4F60\u627E\u5230\u8FD9\u91CC\u4E86\uFF01\r\n30\r\n\u4F60\u7ADF\u6562\u5229\u7528\u6076\u9B54\u654F\u6765\u901E\u4E00\u5DF1\u7684\u91CE\u5FC3\u79C1\u6B32\uFF0C\u5B9E\u5728\u662F\u4E0D\u53EF\u539F\u8C05\r\n199\r\n\u6076\u9B54\u65CF\u672C\u6765\u5C31\u662F\u6211\u4EEC\u521B\u9020\u3684\u8981\u5982\u4F55\u4F7F\u7528\u4ED6\u4EEC\u662F\u6211\u4EEC\u7684\u4E8B\uFF01#\u800C\u4E14\uFF0C\u4F60\u65E2\u7136\u77E5\u9053\u4E86\u8FD9\u4E9B\u4E8B\uFF0C\u6211\u5C31\u4E0D\u4F1A\u8BA9\u4F60\u6D3B\u7740\u79BB\u5F00\u8FD9\u91CC\u3002\u3002\u3002\u3002\r\n30\r\n\u6211\u624B\u4E0B\u7684\u63F4\u519B\u9A6C\u4E0A\u5C31\u8D76\u5230\u4E86\uFF0C\u4ECA\u5929\u8981\u8BA9\u4F60\u770B\u770B\u9F99\u4EBA\u65CF\u6218\u58EB\u7684\u529B\u91CF\uFF01\r\n199\r\n\u771F\u60CA\u4EBA\u7684\u58F0\u52BF\uFF0C\u4F60\u5230\u5E95\u6D3E\u6765\u4E86\u4EC0\u4E48\u63F4\u519B\uFF1F\r\n30\r\n\u8FD9\u3002\u3002\u597D\u8C61\u4E0D\u662F\u3002\u3002\r\n1\r\n\u7EC8\u4E8E\u505C\u4E86\uFF01\r\n5\r\n\u545C\u3002\u3002\u771F\u70C2\u7684\u7740\u9646\u6CD5\uFF01\u8FD8\u6CA1\u548C\u654C\u4EBA\u4EA4\u6218\u5C31\u6454\u6389\u534A\u6761\u547D\u4E86\u3002\u3002\u3002\u3002\r\n1\r\n\u60A0\u59AE\uFF0C\u60A0\u59AE\uFF01\u4F60\u6CA1\u6709\u53D7\u4F24\u5427\uFF1F\r\n2\r\n\u8FD8\u597D\uFF0C\u4E00\u70B9\u4F24\u90FD\u6CA1\u6709\u3002\u3002\u7D22\u5C14\u4F60\u4E5F\u8FD8\u597D\u5427\uFF1F\r\n6\r\n\u54FC\u3002\u3002\u3002\u3002\u5DEE\u522B\u5F85\u9047\u5594\uFF01\r\n21\r\n\u522B\u5435\u4E86\uFF0C\u5927\u5BB6\u90FD\u6CA1\u4E8B\u5427\uFF01\u8FD9\u91CC\u597D\u8C61\u5C31\u662F\u654C\u65B9\u7684\u6839\u636E\u5730\u4E4B\u4E00\uFF0C\u6211\u4EEC\u8981\u7279\u522B\u5C0F\u5FC3\u3002\u3002\u3002\u3002\r\n19\r\n\u54A6\uFF01\u90A3\u8FB9\u6709\u4EBA\u5728\u5BF9\u5CD9\u7740\u3002\u3002\u597D\u8C61\u6709\u6211\u4EEC\u4E00\u65CF\u7684\u9F99\u4EBA\u5462\uFF01\r\n22\r\n\u771F\u7684\uFF1F\u90A3\u965B\u4E0B\u4EBA\u4E00\u5B9A\u5728\u91CC\u9762\uFF01\u5723\u5BC7\u62C9\u65AF\u965B\u4E0B\uFF01\r\n30\r\n\u6709\u4EBA\u8BA4\u8BC6\u6211\u5417\uFF1F\u554A\uFF01\u662F\u5DF4\u62FF\u7F57\u897F\u4E9A\u548C\u51EF\u62C9\u65AF\uFF01\r\n19\r\n\u965B\u4E0B\uFF0C\u6211\u4EEC\u603B\u7B97\u627E\u5230\u60A8\u4E86\uFF01\r\n21\r\n\u5723\u5BC7\u62C9\u65AF\uFF0C\u597D\u4E45\u4E0D\u89C1\u4E86\uFF0C\u6CA1\u60F3\u5230\u4F1A\u548C\u4F60\u5728\u8FD9\u91CC\u4F1A\u5E08\uFF01\r\n30\r\n\u554A\uFF01\u539F\u6765\u662F\u7EA6\u62FF\u5148\u751F\uFF0C\u597D\u6781\u5566\uFF0C\u6709\u4F60\u624B\u4E0B\u8FD9\u6279\u751F\u529B\u519B\uFF0C\u8FD9\u4E0B\u5B50\u5C31\u6CA1\u95EE\u9898\u4E86\uFF01\r\n199\r\n\u54FC\uFF0C\u679C\u7136\u662F\u4F60\u627E\u6765\u7684\u63F4\u519B\u6CA1\u9519\uFF0C\u4F60\u4EEC\u90FD\u51C6\u5907\u6B7B\u5728\u8FD9\u91CC\u5427\uFF01\r\n1\r\n\u8FD9\u602A\u5BB6\u4F19\u8FD8\u771F\u56A3\u5F20\uFF0C\u4E9A\u96F7\u65AF\uFF0C\u6211\u4EEC\u5408\u529B\u5BB0\u4E86\u4ED6\uFF01\r\n3\r\n\u5BF9\uFF01\u9001\u4ED6\u53BB\u548C\u4ED6\u7684\u524D\u4E09\u4E2A\u4F19\u4F34\u76F8\u4F1A\uFF01\r\n199\r\n\u4EC0\u4E48\uFF01\u96BE\u9053\u3002\u3002\u96BE\u9053\u5730\u6C34\u98CE\u4E09\u4E2A\u9B54\u795E\u90FD\u5DF2\u7ECF\u88AB\u4F60\u4EEC\u6253\u8D25\u4E86\uFF1F\u53EF\u6076\uFF01#\u6211\u706B\u9B54\u795E\u8981\u66FF\u4ED6\u4EEC\u4E00\u5E76\u628A\u8FD9\u7B14\u8840\u503A\u8BA8\u56DE\u6765\uFF01\r\n1\r\n\u5C11\u7F57\u55E6\uFF01\u6709\u79CD\u5C31\u653E\u9A6C\u8FC7\u6765\u5427\uFF01\r\n211\r\n\u5723\u5BC7\u62C9\u65AF\u965B\u4E0B\uFF0C\u6211\u4EEC\u6765\u8FDF\u4E86\uFF01\r\n30\r\n\u8FD8\u4E0D\u665A\uFF0C\u5148\u628A\u706B\u9B54\u795E\u6253\u5012\u518D\u8BF4\u5427\uFF01\r\n199\r\n\u3002\u3002\u53EF\u6076\uFF0C#\u4E3B\u4EBA\u4E0D\u4F1A\u653E\u8FC7\u4F60\u4EEC\u7684\u3002\u554A\u3002\u3002#\u5230\u65F6\u5019\u4F60\u4EEC\u5C31\u4F1A\u548C\u8FD9\u4E16\u754C\u4E00\u8D77\u6BC1\u706D\u3002\u3002\u3002\r\n30\r\n\u771F\u662F\u60CA\u9669\u7684\u4E00\u6218\uFF01\u7EA6\u8001\u5934\uFF0C\u4F60\u4ECE\u54EA\u91CC\u642C\u6765\u8FD9\u4E9B\u751F\u529B\u519B\uFF1F\u5982\u679C\u6CA1\u6709\u4ED6\u4EEC\uFF0C\u8FD9\u4E00\u6218\u7684\u7ED3\u679C\u5C31\u4F1A\u6539\u89C2\u4E86\u3002\r\n21\r\n\u4ED6\u4EEC\u662F\u4E00\u7FA4\u5BCC\u6B63\u4E49\u611F\u7684\u5E74\u8F7B\u52C7\u58EB\uFF0C\u56E0\u4E3A\u673A\u7F18\u5DE7\u5408\u540C\u805A\u4E00\u5802\uFF0C\u4E4B\u540E\u4E3A\u4E86\u6253\u5012\u6697\u4E2D\u5A01\u80C1\u8FD9\u6574\u4E2A\u5927\u9646\u7684\u654C\u4EBA\u800C\u548C\u6211\u4E00\u8D77\u594B\u6218\u81F3\u4ECA\u3002\r\n30\r\n\u597D\u6781\u4E86\uFF0C\u6211\u6B63\u6101\u6765\u4E0D\u53CA\u53EC\u96C6\u4E00\u652F\u591F\u5F3A\u7684\u519B\u961F\uFF01\u636E\u6211\u8C03\u67E5\u7684\u7ED3\u679C\uFF0C\u8FD9\u7194\u5CA9\u6D1E\u7A9F\u4E2D\u6709\u901A\u9053\u901A\u5F80\u4E00\u4E2A\u53E4\u4EE3\u4EBA\u7684\u9057\u8FF9\uFF0C\u636E\u8BF4\u4ECE\u90A3\u91CC\u53EF\u4EE5\u76F4\u8FBE\u9EC4\u91D1\u7784\u57CE\u5821\u3002\r\n1\r\n\u6240\u8C13\u7684\u9EC4\u91D1\u7684\u57CE\u5821\uFF0C\u5C31\u662F\u6307\u654C\u4EBA\u7684\u6839\u636E\u5730\u5417\uFF1F\r\n21\r\n\u5F88\u96BE\u8BF4\uFF0C\u6211\u4EEC\u8981\u53BB\u786E\u8BA4\u4E4B\u540E\u624D\u77E5\u9053\u3002\r\n30\r\n\u654C\u4EBA\u4F3C\u4E4E\u6015\u6211\u4EEC\u53D1\u73B0\u8FD9\u4E00\u70B9\uFF0C\u7240\u4EE5\u521A\u624D\u90A3\u5BB6\u4F19\u4F01\u56FE\u65BD\u7528\u9B54\u6CD5\u8BA9\u706B\u5C71\u7206\u53D1\uFF0C\u5F7B\u5E95\u6BC1\u706D\u8FD9\u6761\u901A\u9053\uFF0C\u4F46\u8FD9\u6837\u4E5F\u4F1A\u6BC1\u4E86\u6076\u9B54\u65CF\u7684\u6816\u606F\u4E4B\u5730\u3002\u3002\u5E78\u597D\u4F60\u4EEC\u53CA\u65F6\u62B5\u8FBE\uFF0C\u624D\u6CA1\u6709\u8BA9\u90A3\u5BB6\u4F19\u5F97\u901E\u3002\r\n3\r\n\u597D\u6781\u4E86\uFF0C\u54B1\u4EEC\u8D76\u5FEB\u524D\u5F80\u9057\u8FF9\u5427\uFF0C\u8FD9\u6B21\u7EDD\u4E0D\u80FD\u518D\u8BA9\u654C\u4EBA\u62A2\u5148\u4E86\uFF01\r\n31\r\n\u7B49\u7B49\uFF01\r\n1\r\n\u54A6\uFF0C\u654C\u65B9\u8FD8\u6709\u6F0F\u7F51\u4E4B\u9C7C\u5417\uFF1F\r\n31\r\n\u522B\u8BEF\u4F1A\uFF0C\u6211\u662F\u6765\u52A0\u5165\u4F60\u4EEC\u4E00\u884C\u7684\u3002\r\n21\r\n\u4F60\u4F1A\u8BF4\u4EBA\u7C7B\u7684\u8BED\u8A00\uFF1F\u8FD9\u53EF\u6709\u8DA3\u4E86\u3002\r\n31\r\n\u6211\u662F\u5F53\u4ECA\u6076\u9B54\u65CF\u4E4B\u738B\u5361\u5C14\u6839\u7684\u5F1F\u5F1F\uFF0C\u738B\u5BB6\u9B54\u6CD5\u5E08\u4E9A\u9F50\u6885\u5409\u3002\u6211\u5E73\u65E5\u5BF9\u4EBA\u7C7B\u548C\u5927\u9646\u4E0A\u7684\u5176\u4ED6\u79CD\u65CF\u6709\u5F88\u6DF1\u7684\u7814\u7A76\uFF0C\u6240\u4EE5\u901A\u6653\u4F60\u4EEC\u7684\u8BED\u8A00\u3002\r\n21\r\n\u4F60\u7684\u79CD\u65CF\u521A\u521A\u624D\u8054\u5408\u706B\u9B54\u795E\u4E0E\u6211\u4EEC\u4E3A\u654C\uFF0C\u4E3A\u4F55\u73B0\u5728\u4F60\u53C8\u8981\u52A0\u5165\u6211\u4EEC\uFF1F\r\n31\r\n\u6211\u65CF\u5E76\u4E0D\u662F\u6545\u610F\u8981\u4E0E\u4F60\u4EEC\u4E3A\u654C\uFF0C\u56E0\u4E3A\u654C\u4EBA\u4EE5\u90AA\u6CD5\u63A7\u5236\u4E86\u738B\u5144\u7684\u795E\u667A\uFF0C\u7C4D\u4EE5\u547D\u4EE4\u6211\u65CF\u7684\u6218\u58EB\u6765\u62B5\u6321\u4F60\u4EEC\u7684\u653B\u52BF\u3002\u6211\u770B\u7A7F\u8FD9\u4E00\u70B9\u4E4B\u540E\uFF0C\u654C\u4EBA\u4FBF\u5047\u738B\u5144\u4E4B\u624B\u5C06\u6211\u76D1\u7981\u8D77\u6765\uFF0C\u8FD8\u597D\u4F60\u4EEC\u963B\u6B62\u4E86\u4ED6\u4EEC\uFF0C\u4E0D\u7136\u6574\u4E2A\u6076\u9B54\u65CF\u53EF\u80FD\u4F1A\u5C31\u6B64\u706D\u4EA1\u3002\r\n21\r\n\u539F\u6765\u5982\u6B64\uFF0C\u4F60\u5BF9\u654C\u4EBA\u7684\u6240\u77E5\u6709\u591A\u5C11\uFF1F\r\n31\r\n\u6211\u76F8\u4FE1\u4ED6\u4EEC\u548C\u53E4\u4EE3\u4EBA\u7684\u9057\u8FF9\u4EE5\u53CA\u9EC4\u91D1\u57CE\u7EDD\u5BF9\u6709\u5173\u8FDE\uFF0C\u4ED6\u4EEC\u53EF\u80FD\u662F\u4ECE\u9644\u8FD1\u7684\u9057\u8FF9\u6765\u5230\u8FD9\u4E2A\u4E16\u754C\u7684\uFF0C\u6240\u4EE5\u5F53\u52A1\u4E4B\u6025\u662F\u7ECF\u7531\u672C\u5730\u7684\u901A\u9053\u524D\u5F80\u9057\u8FF9\uFF0C\u4EE5\u514D\u4ED6\u4EEC\u518D\u5EA6\u589E\u63F4\u3002\r\n19\r\n\u597D\u6781\u4E86\uFF0C\u90A3\u63A5\u4E0B\u6765\u4FBF\u7531\u4F60\u6765\u5E26\u8DEF\u4E86\u3002\r\n31\r\n\u4E50\u610F\u4E4B\u81F3\uFF01\u6211\u4EEC\u8FD9\u5C31\u8D70\u5427\uFF01\r\n"
