    characterSetSelectionMode: 8
    characterSequence: "\u7B2C\u4E8C\u5341\u516D\u7AE0\u3000\u672A\u77E5\u7684\u56DE\u5ECA\r\n\u7D22\u5C14\u6216\u60A0\u59AE\u6216\u4E9A\u9F50\u6885\u5409\u6B7B\u4EA1\r\n\u654C\u5168\u706D\r\n3\r\n\u563F\uFF0C\u8FD9\u662F\u4EC0\u4E48\u602A\u5730\u65B9\uFF1F\u3002\u3002\u8FD9\u79CD\u666F\u8272\u4EE5\u524D\u4ECE\u6CA1\u770B\u8FC7\uFF01\r\n31\r\n\u8FD9\u6761\u901A\u9053\u636E\u8BF4\u662F\u53E4\u4EE3\u4EBA\u6240\u5EFA\u9020\u7684\uFF0C\u5386\u4EE3\u7684\u6076\u9B54\u65CF\u4E4B\u738B\u90FD\u7981\u6B62\u65CF\u4EBA\u8FDB\u5165\u6B64\u5730\uFF0C\u4F3C\u4E4E\u8E0F\u8FDB\u8FD9\u901A\u9053\u4F1A\u62DB\u5F95\u53EF\u6015\u7684\u707E\u7978\u3002\u3002\u3002\r\n30\r\n\u6211\u611F\u5230\u707E\u7978\u597D\u8C61\u5DF2\u7ECF\u5728\u773C\u524D\u4E86\uFF0C\u90A3\u4E9B\u770B\u8D77\u6765\u50CF\u73A9\u5076\u7684\u4E1C\u897F\u662F\u4EC0\u4E48\uFF1F\r\n139\r\n\u5165\u4FB5\u8005\u53D1\u73B0\uFF01#\u6307\u4EE4\uFF1A\u9632\u536B\u53CA\u6D88\u9664\u5A01\u80C1\u7684\u5B58\u5728#\u65B9\u6CD5\uFF1A\u653B\u51FB\u5E76\u6D88\u706D\u3002\r\n101\r\n\u547D\u4EE4\u786E\u8BA4\uFF01\u76EE\u6807\u5206\u6790\u5B8C\u6BD5\uFF01\u542F\u52A8\uFF01\u6267\u884C\u63A5\u6218\u6307\u4EE4\uFF01\r\n30\r\n\u90A3\u662F\u4EC0\u4E48\uFF1F\r\n1\r\n\u7B80\u5355\u6765\u8BF4\uFF0C\u90A3\u662F\u53E4\u4EE3\u4EBA\u5EFA\u9020\u7684\u673A\u5668\u5B88\u536B\uFF0C\u7528\u6765\u9632\u5B88\u4ED6\u4EEC\u7684\u9057\u8FF9\u548C\u636E\u70B9\u3002\u3002\u6CA1\u65F6\u95F4\u89E3\u91CA\u4E86\uFF0C\u6211\u4EEC\u51C6\u5907\u52A8\u624B\u5427\uFF01\r\n6\r\n\u5C0F\u5FC3\uFF01\u4ED6\u4EEC\u8981\u51B2\u8FC7\u6765\u4E86\uFF01\r\n21\r\n\u654C\u4EBA\u7684\u6570\u91CF\u6BD4\u4E0A\u6B21\u66F4\u591A\u4E86\uFF0C\u5927\u5BB6\u5C0F\u5FC3\u5E94\u6218\uFF01\r\n2\r\n\u8FD9\u673A\u5175\u7684\u5934\u90E8\u600E\u4E48\u5F00\u7740\uFF1F\u8FD9\u4E2A\u91D1\u5C5E\u76D2\u5B50\u3002\u3002\u597D\u8C61\u6EE1\u9002\u5408\u7684\uFF0C\u5E94\u8BE5\u662F\u8FD9\u6837\u653E\u8FDB\u53BB\u3002\u3002\u3002\u3002\u54A6\uFF01\r\n32\r\n\u7CFB\u7EDF\u542F\u59CB\uFF0C\u8BF7\u6307\u793A\u64CD\u4F5C\u7801\u53CA\u884C\u52A8\u6A21\u5F0F\u3002\r\n2\r\n\u8FD9\u3002\u3002#\u597D\u8C61\u662F01EC244#-FE2C51932\r\n\r\n\u786E\u8BA4\u3002#\u4E3B\u4EBA\uFF0C01279943\u6E25\u5FB7\uFF0C\u56DE\u590D\u5230\u6B63\u5E38\u64CD\u4F5C\u72B6\u6001\uFF0C\u8BF7\u6307\u793A\u3002\r\n\r\n\u6211\u4E3A\u4EC0\u4E48\u8BB0\u5F97\u8FD9\u4E9B\u4E1C\u897F\uFF1F\u3002\u3002\u597D\u5427\uFF0C\u5E2E\u6211\u4EEC\u6253\u5012\u90A3\u4E9B\u673A\u5175\uFF01\u80FD\u7406\u89E3\u5417\uFF1F\r\n32\r\n\u7406\u89E3\uFF0C\u6307\u4EE4\u5185\u5BB9\u786E\u8BA4\uFF0C\u7CFB\u7EDF\u8D44\u6599\u8BBE\u5B9A\u3002\u3002\u5F85\u547D\u72B6\u6001\u5B8C\u6210\u3002#\u5B8C\u6BD5\u3002\r\n2\r\n\u76EE\u6807\u6E05\u695A\u540E\u5373\u89E3\u9664\u4E00\u7EA7\u6218\u6597\u72B6\u6001\uFF0C\u5E76\u786E\u8BA4\u6240\u6709\u6211\u65B9\u76EE\u6807\u3002\u7B49\u5F85\u4E0B\u4E00\u6B21\u6218\u6597\u6307\u793A\u7801\u3002\r\n32\r\n\u4E86\u89E3\r\n1\r\n\u60A0\u59AE\uFF0C\u4F60\u5728\u90A3\u8FB9\u505A\u4EC0\u4E48\uFF1F\r\n2\r\n\u6CA1\u3002\u3002\u6CA1\u4EC0\u4E48\uFF0C\u6211\u8BF4\u670D\u4E86\u8FD9\u4E2A\u673A\u7532\u5175\u5E2E\u6211\u4EEC\u4F5C\u6218\u3002\r\n3\r\n\u54C7\u585E\uFF0C\u60A0\u59AE\u4F60\u771F\u5389\u5BB3\uFF01\r\n2\r\n\u90A3\u662F\u4EC0\u4E48\u5947\u602A\u7684\u4E1C\u897F\uFF1F\u5934\u90E8\u8FD8\u5F00\u7740\uFF1F\r\n139\r\n\u3002\u3002\u4E25\u91CD\u53D7\u635F\uFF0C\u6307\u6325\u63A7\u5236\u4E0D\u80FD\u3002\u3002\u7CFB\u7EDF\u5173\u95ED\u3002\u3002\u3002\u3002\r\n31\r\n\u597D\u6781\u4E86\uFF0C\u6211\u4EEC\u8FC5\u901F\u51FB\u6E83\u4E86\u654C\u65B9\u673A\u7532\u5175\uFF0C\u73B0\u5728\u53EF\u4EE5\u9A6C\u4E0A\u524D\u5F80\u9057\u8FF9\u3002\u3002\u563F\uFF0C\u961F\u4F0D\u91CC\u600E\u4E48\u6709\u4E2A\u654C\u65B9\u7684\u673A\u7532\u5175\uFF1F\r\n1\r\n\u90A3\u662F\u60A0\u59AE\u5E2E\u6211\u4EEC\u62C9\u8FDB\u4F19\u7684\uFF0C\u5979\u548C\u673A\u7532\u5175\u4E00\u76F4\u5F88\u6709\u7F18\u3002\r\n3\r\n\u662F\u554A\uFF0C\u5979\u521D\u6B21\u548C\u6211\u4EEC\u76F8\u9047\u65F6\u5C31\u5E26\u7740\u76D6\u4E9A\u3002\r\n31\r\n\u662F\u8FD9\u6837\u5417\uFF1F\u3002\u3002\u60A0\u59AE\u5C0F\u59D0\uFF0C\u6211\u770B\u4F60\u597D\u8C61\u77E5\u9053\u673A\u7532\u5175\u7684\u542F\u52A8\u7801\uFF0C\u662F\u5427\uFF1F\r\n2\r\n\u554A\uFF1F\u542F\u52A8\u7801\u3002\u3002\u90A3\u662F\u4EC0\u4E48\u4E1C\u897F\uFF1F\u6211\u4E0D\u77E5\u9053\uFF01\r\n31\r\n\u662F\u5417\uFF1F\u60A0\u59AE\u5C0F\u59D0\uFF0C\u6211\u770B\u4F60\u4E00\u5B9A\u77E5\u9053\uFF01\u4F60\u5230\u5E95\u662F\u4ECE\u54EA\u91CC\u6765\u7684\uFF1F\u4F60\u7EDD\u4E0D\u662F\u4E00\u822C\u4EBA\u7C7B\uFF01\u4E3A\u4E86\u6211\u4EEC\u5927\u5BB6\uFF0C\u628A\u8BDD\u8BF4\u4E2A\u6E05\u695A\u5427\uFF01\r\n2\r\n\u3002\u3002\u4E0D\u3002\u3002\u4E0D\u8981\u518D\u8BF4\u4E86\uFF01\u3002\u3002\u6211\u4EC0\u4E48\u90FD\u4E0D\u77E5\u9053\u3002\u3002\u3002\u3002\r\n1\r\n\u4E9A\u9F50\u6885\u5409\uFF0C\u591F\u4E86\uFF01\u4F60\u8981\u662F\u628A\u5979\u5F04\u54ED\u4E86\uFF0C\u6211\u7EDD\u4E0D\u9976\u4F60\uFF01\r\n21\r\n\u3002\u3002\u7B97\u5566\uFF0C\u4E0D\u8981\u903C\u95EE\u5979\u4E86\uFF0C\u95EE\u8FD9\u4E2A\u673A\u7532\u5175\u4E5F\u662F\u4E00\u6837\u3002\u3002\u3002\u3002\u5582\uFF0C\u90A3\u4E2A\u673A\u7532\u5175\u3002\r\n32\r\n01279943\u6E25\u5FB7\uFF0C\u547D\u4EE4\u786E\u8BA4\u3002\r\n21\r\n\u4F60\u53EB\u6E25\u5FB7\u5417\uFF1F\u8BF7\u56DE\u7B54\u6211\u7684\u95EE\u9898\u3002\r\n32\r\n\u4E86\u89E3\uFF0C\u8BB0\u5FC6\u5E93\u8FDE\u63A5\uFF0C\u8D44\u6599\u8F7D\u5165\u5F85\u547D\u3002\u8BF7\u6307\u793A\u3002\r\n21\r\n\u4F60\u4EEC\u7684\u79CD\u65CF\u6765\u81EA\u4F55\u65B9\uFF1F\u9886\u5BFC\u8005\u53C8\u662F\u8C01\uFF1F\r\n32\r\n\u8BB0\u5FC6\u5E93\u641C\u5BFB\uFF0C\u8D44\u6599#73324\uFF1A01279943\u6E25\u5FB7\u96B6\u5C5E\u7B2C\u516D\u673A\u7532\u6218\u6597\u56E2\u7B2C\u4E09\u6218\u6597\u4E2D\u961F\uFF0C\u5168\u5E08\u56E2\u7531\u7B2C\u4E00\u7A7A\u4E2D\u8981\u585E\u5EFA\u9020\uFF0C\u5728\u6267\u884C\u7B2C\u4E03\u53F7\u6218\u6597\u9632\u536B\u6307\u4EE4\u65F6\uFF0C\u7ECF\u7531\u4F20\u9001\u7AD9\u9001\u5230\u5730\u8868\u3002#\u6211\u4EEC\u7684\u9886\u5BFC\u8005\u662F\u5168\u80FD\u7684\u521B\u9020\u8005\uFF0C\u4ED6\u53EF\u4EE5\u4EFB\u610F\u5E8A\u5728\u673A\u68B0\u548C\u751F\u547D\uFF0C\u662F\u8FD9\u4E2A\u5927\u5730\u7684\u4E3B\u5BB0\u8005\uFF0C\u6211\u4EEC\u5E76\u4E0D\u77E5\u9053\u9886\u5BFC\u8005\u7684\u540D\u5B57\uFF0C\u90A3\u4E0D\u5728\u6211\u4EEC\u7684\u8BB0\u5FC6\u5E93\u9886\u57DF\u4E4B\u5185\u3002\r\n21\r\n\u3002\u4ECE\u672A\u542C\u8BF4\u8FD9\u79CD\u4E8B\u3002\u3002\u597D\u5427\uFF0C\u90A3\u4F60\u4EEC\u4E3A\u4F55\u8981\u653B\u51FB\u8FD9\u4E2A\u5927\u9646\uFF1F\r\n32\r\n\u8BB0\u5FC6\u5E93\u641C\u5BFB\uFF0C\u8D44\u6599#2074213\uFF1A\u7B2C\u516D\u673A\u7532\u6218\u6597\u56E2\u1949\u547D\u6267\u884C\u7B2C\u4E03\u53F7\u6318\u6597\u9632\u536B\u547D\u4EE4\uFF0C#\u4E3B\u8981\u76EE\u6807\uFF1A\u6D88\u706DX-07\u5730\u533A\u7684\u654C\u65B9\u751F\u547D\u4F53\uFF0C\u9632\u6B62\u4EFB\u4F55\u654C\u65B9\u5355\u4F4D\u8FDB\u5165\u8F6C\u9001\u7AD9\uFF1A\u4F46\u5C31\u6700\u540E\u7684\u8BB0\u5F55\uFF0C\u672C\u6B21\u4F5C\u6218\u5DF2\u7ECF\u4E2D\u6B62\uFF0C\u800C01279943\u6E25\u5FB7\u5728\u906D\u53D7\u654C\u65B9\u653B\u51FB\u4E4B\u540E\uFF0C\u8BEF\u52A8\u5B89\u5168\u88C5\u7F6E\u5BFC\u81F4\u80FD\u6E90\u5355\u4F4D\u5F39\u51FA\uFF0C\u7CFB\u7EDF\u4E2D\u65AD\u81F3\u4ECA\uFF0C\u5E76\u672A\u518D\u63A5\u5230\u4EFB\u4F55\u66F4\u65B0\u7684\u4F5C\u6218\u547D\u4EE4\u3002\r\n25\r\n\u8FD9\u5BB6\u4F19\u7684\u8BDD\u8FD8\u771F\u662F\u96BE\u61C2\u3002\u3002\u7EA6\u62FF\u8001\u5934\uFF0C\u4F40\u542C\u61C2\u4E86\u591A\u5C11\uFF1F\r\n21\r\n\u6211\u53EA\u77E5\u9053\u8FD9\u4F4D\u6E25\u5FB7\u8001\u5144\u597D\u8C61\u5E76\u672A\u53C2\u4E0E\u8FD9\u6B21\u7684\u653B\u51FB\uFF0C\u4E0D\u8FC7\u4E00\u5207\u9EBB\u70E6\u7684\u6839\u6E90\u4F3C\u4E4E\u90FD\u6765\u81EA\u6240\u8C13\u7684\u300C\u7B2C\u4E00\u7A7A\u4E2D\u8981\u585E\u300D\uFF0C\u5B83\u4E5F\u53EF\u80FD\u5C31\u662F\u300C\u9EC4\u91D1\u7684\u57CE\u5821\u300D\uFF0C\u7531\u53E4\u4EE3\u4EBA\u6240\u5EFA\u9020\u7684\u98DE\u884C\u5821\u5792\uFF0C\u517C\u5177\u5EFA\u9020\u673A\u7532\u5175\u7684\u80FD\u529B\u3002\u3002\u3002\u3002\r\n30\r\n\u53E4\u4EE3\u4EBA\u4E0D\u662F\u65E9\u5728\u6570\u4E07\u5E74\u524D\u7684\u6700\u7EC8\u6218\u4E89\u4E2D\u5C31\u706D\u7EDD\u4E86\u5417\uFF1F\u4E3A\u4EC0\u4E48\u8FD9\u4E2A\u8981\u585E\u8FD8\u80FD\u53D1\u52A8\u653B\u51FB\uFF1F\r\n1\r\n\u8FD9\u4E2A\u300C\u9EC4\u91D1\u57CE\u300D\u4F1A\u4E0D\u4F1A\u662F\u7531\u7C7B\u4F3C\u7684\u673A\u7532\u5175\u6240\u63A7\u5236\uFF0C\u7531\u4E8E\u6CA1\u6709\u6536\u5230\u6240\u8C13\u7684\u4E2D\u6B62\u4F5C\u6218\u6307\u4EE4\uFF0C\u6240\u4EE5\u4ECD\u5728\u6267\u884C\u4EE5\u524D\u7684\u4F5C\u6218\u884C\u52A8\uFF1F\r\n13\r\n\u5F88\u6709\u53EF\u80FD\uFF0C\u53E4\u4EE3\u4EBA\u5EFA\u9020\u8FD9\u79CD\u98DE\u884C\u8981\u585E\uFF0C\u4E3B\u8981\u76EE\u7684\u5E94\u8BE5\u5C31\u662F\u63A7\u5236\u5236\u538B\u548C\u5BF9\u5730\u653B\u51FB\uFF0C\u4F46\u6700\u7EC8\u6218\u4E89\u65E9\u5728\u6570\u4E07\u5E74\u524D\u5C31\u5DF2\u7ECF\u7ED3\u675F\u4E86\uFF0C\u4E3A\u4F55\u5230\u73B0\u5728\u624D\u53C8\u5F00\u59CB\u884C\u52A8\uFF1F\r\n21\r\n\u770B\u6765\u53EA\u6709\u4E0A\u9EC4\u91D1\u57CE\u4E00\u8D9F\uFF0C\u8FD9\u4E00\u5207\u7684\u8C1C\u9898\u624D\u80FD\u591F\u89E3\u5F00\uFF01\u6E25\u5FB7\uFF0C\u4F60\u6240\u8BF4\u7684\u8F6C\u9001\u7AD9\u5728\u54EA\u91CC\uFF1F\r\n32\r\n\u5C31\u4F4D\u5728\u8FD9\u5730\u4E0B\u901A\u9053\u7684\u51FA\u53E3\u5904\u3002\r\n31\r\n\u597D\u6781\u4E86\uFF0C\u6211\u4EEC\u8FC5\u901F\u51FB\u6E83\u4E86\u654C\u65B9\u673A\u7532\u5175\uFF0C\u73B0\u5728\u53EF\u4EE5\u9A6C\u4E0A\u524D\u5F80\u9057\u8FF9\uFF0C\u4E0D\u8FC7\u6211\u4EEC\u8FD8\u662F\u5BF9\u654C\u4EBA\u7684\u5E95\u7EC6\u4E00\u65E0\u6240\u77E5\u3002\u3002\u3002\u3002\u60A0\u59AE\u5C0F\u59D0\uFF0C\u4F60\u7684\u62A4\u536B\u4E5F\u662F\u53E4\u4EE3\u4EBA\u6240\u9020\u7684\u673A\u7532\u5175\u5427\uFF1F\r\n3\r\n\u662F\u7684\uFF0C\u5979\u521D\u6B21\u548C\u6211\u4EEC\u76F8\u9047\u65F6\u5C31\u5E26\u7740\u76D6\u4E9A\u3002\r\n31\r\n\u662F\u8FD9\u6837\u5417\uFF1F\u3002\u3002\u60A0\u59AE\u5C0F\u59D0\uFF0C\u6211\u770B\u4F60\u4E00\u5B9A\u77E5\u9053\u4E9B\u4EC0\u4E48\uFF0C\u6709\u5173\u53E4\u4EE3\u4EBA\u548C\u8FD9\u6279\u673A\u7532\u5175\u7684\u79D8\u5BC6\u3002\u3002\u3002\u3002\u662F\u5427\uFF1F\r\n2\r\n\u53E4\u4EE3\u4EBA\uFF1F\u673A\u7532\u5175\uFF1F\u3002\u3002\u3002\u3002\u90A3\u662F\u4EC0\u4E48\u4E1C\u897F\uFF1F\u6211\u4E0D\u77E5\u9053\uFF01\r\n31\r\n\u662F\u5417\uFF1F\u60A0\u59AE\u5C0F\u59D0\uFF0C\u6211\u770B\u4F60\u4E00\u5B9A\u77E5\u9053\uFF01\u4F60\u5230\u5E95\u662F\u4ECE\u54EA\u91CC\u6765\u7684\uFF1F\u4F60\u7EDD\u4E0D\u662F\u4E00\u822C\u4EBA\u7C7B\uFF01\u4E3A\u4E86\u6211\u4EEC\u5927\u5BB6\uFF0C\u628A\u8BDD\u8BF4\u4E2A\u6E05\u695A\u5427\uFF01\r\n2\r\n\u3002\u3002\u4E0D\u3002\u3002\u4E0D\u8981\u518D\u8BF4\u4E86\uFF01\u3002\u3002\u6211\u4EC0\u4E48\u90FD\u4E0D\u77E5\u9053\u3002\u3002\u3002\u3002\r\n1\r\n\u4E9A\u9F50\u6885\u5409\uFF0C\u591F\u4E86\uFF01\u4F60\u8981\u662F\u628A\u5979\u5F04\u54ED\u4E86\uFF0C\u6211\u7EDD\u4E0D\u9976\u4F60\uFF01\r\n21\r\n\u3002\u3002\u7B97\u5566\uFF0C\u4E0D\u8981\u903C\u95EE\u5979\u4E86\uFF0C\u53CD\u6B63\u4E0A\u4E86\u9EC4\u91D1\u57CE\uFF0C\u76F8\u4FE1\u4E00\u5207\u7684\u8FF7\u9898\u81EA\u7136\u90FD\u4F1A\u89E3\u5F00\u7684\uFF01\r\n1\r\n\u597D\uFF0C\u90A3\u5C31\u4E00\u9F13\u4F5C\u6C14\u51B2\u8FC7\u53BB\uFF0C\u6211\u4EEC\u8FD9\u5C31\u8D70\u5427\uFF01\u60A0\u59AE\uFF0C\u8DDF\u7740\u6211\uFF01\r\n2\r\n\u3002\u3002\u3002\u3002\u3002\u3002\r\n1\r\n\u60A0\u59AE\uFF0C\u600E\u4E48\u4E86\uFF1F\u662F\u4E0D\u662F\u3002\u3002\u6211\u7684\u53E3\u6C14\u592A\u7C97\u9C81\u4E86\uFF1F\u5BF9\u4E0D\u8D77\uFF01\r\n2\r\n\u4E0D\u662F\u7684\uFF0C\u7D22\u5C14\uFF0C\u6211\u597D\u8FF7\u60D1\u3002\u3002\u3002\u3002\u6211\u5230\u5E95\u662F\u8C01\uFF1F\u8FD9\u4E00\u5207\u3002\u3002\u3002\u3002\u5230\u5E95\u548C\u6211\u6709\u4EC0\u4E48\u5173\u8FDE\uFF1F\u6211\u771F\u7684\u4E0D\u77E5\u9053\u3002\u3002\u6211\u597D\u6015\u6211\u4F1A\u7ED9\u4F60\u5E26\u6765\u707E\u7978\uFF0C\u4E5F\u8BB8\u4E00\u5F00\u59CB\u4F60\u5C31\u4E0D\u8BE5\u6551\u6211\u7684\u3002\u3002\u3002\r\n1\r\n\u60A0\u59AE\uFF0C\u6211\u6C38\u8FDC\u90FD\u4F1A\u76F8\u4FE1\u4F60\u7684\uFF01\u53EA\u8981\u6709\u4F60\u548C\u6211\u5728\u4E00\u8D77\uFF0