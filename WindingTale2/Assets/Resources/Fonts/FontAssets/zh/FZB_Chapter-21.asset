    characterSetSelectionMode: 8
    characterSequence: "\u7B2C\u4E8C\u5341\u4E00\u7AE0  \u4E9A\u8FF0\u68EE\u6797\r\n\u7D22\u5C14\u6216\u5E0C\u5C14\u6CD5\u6B7B\u4EA1\r\n\u654C\u5168\u706D\r\n1\r\n\u547C\uFF01\u4E00\u8DEF\u90FD\u6CA1\u4F11\u606F\u7684\u8D76\u8DEF\uFF0C\u771F\u662F\u7D2F\u6B7B\u4EBA\u4E86\u3002\r\n9\r\n\u5E0C\u671B\u6211\u4EEC\u8FD8\u6765\u5F97\u53CA\u3002\r\n14\r\n\u8FD9\u91CC\u597D\u8C61\u662F\u5E73\u65E5\u7684\u805A\u4F1A\u573A\u6240\uFF0C\u4E0D\u8FC7\u4E3A\u4F55\u5145\u6EE1\u4E86\u8840\u8165\u5473\u3002\r\n16\r\n\u554A\uFF01\u524D\u9762\u597D\u8C61\u662F\u654C\u65B9\u7684\u5927\u519B\uFF0C\u7CBE\u7075\u65CF\u4EBA\u88AB\u56F4\u5728\u4E2D\u95F4\uFF01\r\n25\r\n\u4E0D\u8981\u505A\u767D\u65E5\u68A6\u4E86\uFF01\u6211\u5B81\u53EF\u846C\u8EAB\u4E8E\u6B64\uFF0C\u4E5F\u4E0D\u539F\u4F5C\u4F60\u4EEC\u7684\u4FD8\u864F\uFF01\r\n199\r\n\u8001\u5934\u5B50\uFF0C\u8BC6\u65F6\u52A1\u8005\u4E3A\u4FCA\u6770\uFF0C\u6211\u7684\u96C7\u4E3B\u5F88\u9700\u8981\u50CF\u4F60\u8FD9\u6837\u6CD5\u529B\u9AD8\u5F3A\u53C8\u89C1\u8BC6\u5E7F\u535A\u7684\u5927\u6CD5\u5E08\uFF0C\u5982\u679C\u4F60\u613F\u610F\u6295\u964D\uFF0C\u6211\u4FDD\u8BC1\u4ED6\u4E0D\u4F1A\u4E8F\u5F85\u4F60\u7684\u3002\u5475\u5475\u5475\u3002\r\n25\r\n\u5C11\u7F57\u55E6\u4E86\uFF01\u7CBE\u7075\u65CF\u53EF\u4E0D\u662F\u8D2A\u751F\u6015\u6B7B\u7684\u79CD\u65CF\uFF0C\u6765\u4E00\u51B3\u80DC\u8D1F\u5427\uFF01\r\n26\r\n\u6709\u6211\u5728\u6B64\uFF0C\u4F60\u4EEC\u4F11\u60F3\u78B0\u957F\u8001\u4E00\u6839\u6C57\u6BDB\uFF01
      \r\n199\r\n\u65E2\u7136\u4F60\u4EEC\u4E0D\u80AF\u8DDF\u6211\u8D70\uFF0C\u6211\u5C31\u53EA\u597D\u628A\u4F60\u4EEC\u7684\u5C38\u4F53\u5E26\u56DE\u53BB\u4E86\uFF0C\u7ED9\u6211\u6740\uFF01\r\n3\r\n\u53EF\u6076\uFF01\u53C8\u662F\u300C\u6B7B\u4EA1\u9AB7\u9AC5\u300D\uFF01\r\n21\r\n\u770B\u6765\u5723\u7075\u4E4B\u5854\u5DF2\u7ECF\u843D\u5165\u654C\u624B\uFF0C\u5269\u4E0B\u7684\u7CBE\u7075\u65CF\u4EBA\u6B63\u5728\u505A\u6700\u540E\u7684\u987D\u6297\u3002#\u6CA1\u529E\u6CD5\uFF0C\u6211\u4EEC\u5148\u4FDD\u4F4F\u4ED6\u4EEC\u7684\u6027\u547D\uFF0C\u518D\u4F5C\u5176\u4ED6\u7684\u6253\u7B97\uFF01\r\n199\r\n\u53C8\u6709\u5176\u4ED6\u7684\u50BB\u74DC\u6765\u4E86\u5417\uFF1F#\u597D\u6781\u4E86\uFF0C\u6211\u6B63\u5ACC\u8FD9\u4E9B\u7CBE\u7075\u592A\u5C11\uFF0C\u6740\u8D77\u6765\u4E0D\u8FC7\u763E\u5462\uFF01\r\n13\r\n\u739B\u3002\u3002\u739B\u5C14\uFF01\u539F\u6765\u662F\u4F60\uFF01#\u6CA1\u60F3\u5230\u4F60\u8FD8\u6D3B\u7740..\r\n199\r\n\u54E6\uFF0C\u662F\u7981\u536B\u519B\u7684\u961F\u957F\u5927\u4EBA\u554A\uFF01#\u9057\u61BE\u7684\u5F88\uFF0C\u300C\u6B7B\u4EA1\u9AB7\u9AC5\u300D\u5F53\u5E74\u662F\u88AB\u4F60\u4EEC\u527F\u706D\u4E86\uFF0C\u4F46\u6211\u82B1\u4E86\u597D\u51E0\u5E74\u7684\u65F6\u95F4\u53C8\u628A\u4ED6\u91CD\u5EFA\u8D77\u6765\uFF0C\u73B0\u5728\u7684\u300C\u6B7B\u4EA1\u9AB7\u9AC5\u300D\u5DF2\u975E\u6614\u65E5\u6240\u80FD\u6BD4\u4E86..\r\n13\r\n\u65E9\u77E5\u5982\u6B64\uFF0C\u5F53\u65F6\u5C31\u4E0D\u8BE5\u597D\u5FC3\u653E\u4F60\u9003\u8D70\u7684...\r\n199\r\n\u662F\u5417\uFF1F#\u90A3\u65F6\u6CA1\u6709\u8FFD\u6740\u5230\u5E95\u662F\u4F60\u81EA\u5DF1\u7684\u758F\u5FFD\uFF0C\u4E5F\u597D\uFF0C\u6211\u4EEC\u987A\u4FBF\u6E05\u7B97\u4E00\u4E0B\u5F53\u5E74\u7684\u5E10....#\u4F60\u4EEC\u90FD\u522B\u60F3\u6D3B\u7740\u79BB\u5F00\u8FD9\u91CC\uFF01\r\n1\r\n\u8FD9\u79CD\u4E3A\u94B1\u5356\u547D\u7684\u6076\u68CD\uFF0C\u4F55\u5FC5\u548C\u4ED6\u4EEC\u7F57\u55E6\uFF01#\u6211\u4EEC\u4E0A\uFF01\r\n199\r\n\u7EC8\u4E8E\u6765\u4E86\u5417\uFF01\u5BB0\u4E86\u8FD9\u4E9B\u5BB6\u4F19\uFF01\r\n199\r\n\u3002\u3002\u54FC\uFF0C\u5C0F\u4F19\u5B50\u4EEC\u8FD8\u771F\u6709\u4E00\u624B\u554A....#\u8D25\u5728\u4F60\u4EEC\u624B\u91CC\uFF0C\u6211\u6CA1\u4EC0\u4E48\u8BDD\u597D\u8BF4\u4E86..
      \r\n13\r\n\u739B\u5C14\uFF01#..\u5982\u679C\u90A3\u65F6\u4F60\u6539\u8FC7\u5411\u5584\uFF0C\u5C31\u4E0D\u4F1A\u6709\u4ECA\u5929\u7684\u7ED3\u679C\uFF01#..\u4E3A\u4EC0\u4E48...\r\n199\r\n..\u83B1\u6C40\uFF0C\u6211\u5BF9\u4F60\u8BF4\u8FC7\uFF0C\u6211\u7684\u8EAB\u4E0A\u6D41\u7740\u7F6A\u72AF\u7684\u8840\u6DB2\uFF0C\u6211\u4EEC\u662F\u6CE8\u5B9A\u4E0D\u80FD\u5E76\u80A9\u4F5C\u6218\u7684..#\u4F60\u4EE5\u540E\u53EF\u4EE5\u653E\u5FC3\u4E86....\u5514...\r\n13\r\n\u739B\u5C14....\r\n25\r\n\u6211\u672C\u6765\u4EE5\u4E3A\u8FD9\u56DE\u6B7B\u5B9A\u4E86\uFF0C\u8FD8\u597D\u4F60\u4EEC\u524D\u6765\u652F\u63F4\uFF0C\u6211\u4EEC\u624D\u80FD\u6218\u80DC\u8FD9\u4E2A\u6740\u624B\u96C6\u56E2\uFF0C\u771F\u662F\u975E\u5E38\u611F\u6FC0\u3002\r\n21\r\n\u5E78\u597D\u6211\u4EEC\u8FD8\u8D76\u5F97\u53CA\uFF0C\u60F3\u5FC5\u8FD9\u662F\u795E\u7684\u65E8\u610F\u3002\u5723\u7075\u4E4B\u5854\u7684\u60C5\u5F62\u5982\u4F55\uFF1F\r\n25\r\n\u4E09\u5929\u524D\u5C31\u5DF2\u7ECF\u88AB\u654C\u4EBA\u653B\u5165\u4E86\uFF0C\u4E3A\u4E86\u51CF\u5C11\u65E0\u8C13\u7684\u6B7B\u4F24\uFF0C\u6211\u5C31\u547D\u4EE4\u6240\u6709\u7684\u5B88\u519B\u64A4\u9000\uFF0C\u6240\u4EE5\u90A3\u91CC\u7684\u60C5\u5F62\u73B0\u5728\u6211\u4E5F\u4E0D\u5F88\u6E05\u695A\u3002\r\n21\r\n\u6211\u660E\u767D\u4E86\u3002\u6B64\u5916\uFF0C\u6211\u5148\u524D\u8BF7\u4F60\u60C5\u5F62\u7684\u8C03\u67E5\u53EF\u6709\u7ED3\u679C\uFF1F\r\n25\r\n\u6211\u5728\u738B\u57CE\u7684\u5927\u56FE\u4E66\u9986\u4E2D\u82B1\u4E86\u4E09\u4E2A\u6708\u7814\u7A76\u53E4\u4EE3\u5178\u7C4D\uFF0C\u8FD8\u5728\u5404\u5730\u7684\u9057\u8FF9\u4E2D\u8FDB\u884C\u6316\u6398\uFF0C\u7ED3\u679C\u53EA\u5F97\u5230\u4E86\u8FD9\u53EA\u6CD5\u6756\u548C\u4E00\u70B9\u7ED3\u8BBA\u3002\r\n21\r\n\u6069\uFF0C\u771F\u662F\u652F\u5F88\u5947\u5F02\u7684\u6CD5\u6756....\u7ED3\u8BBA\u600E\u4E48\u8BF4\u5462\uFF1F\r\n25\r\n\u6839\u636E\u53E4\u5178\u7C4D\u7684\u8BB0\u8F7D\uFF0C\u6709\u5173\u4F60\u6240\u8BF4\u7684\u300C\u5929\u7A7A\u4E4B\u94A5\u300D\uFF0C\u4E8B\u5B9E\u4E0A\u662F\u7531\u4E00\u4E2A\u9EC4\u91D1\u5FBD\u7AE0\u548C\u4E94\u9897\u9B54\u6CD5\u5B9D\u77F3\u6240\u6784\u6210\u7684\uFF0C\u8FD9\u516D\u6837\u4E1C\u897F\u5FC5\u987B\u7ECF\u7531\u8BE5\u6CD5\u6756\u7684\u9B54\u529B\u624D\u80FD\u7ED3\u5408\u5728\u4E00\u8D77\uFF0C\u4ECE\u800C\u53D1\u50FA\u53CA\u5F3A\u5927\u7684\u529B\u91CF\uFF0C\u636E\u8BF4\u8FD9\u529B\u91CF\u53EF\u4EE5\u514B\u670D\u65F6\u95F4\u548C\u7A7A\u95F4\u7684\u9650\u5236\uFF0C\u5C06\u4F7F\u7528\u8005\u79FB\u52A8\u5230\u9065\u8FDC\u7684\u672A\u77E5\u5730\u65B9\u53BB\u3002\r\n21\r\n\u5F88\u6709\u8DA3\u7684\u8BF4\u6CD5\uFF01\u4F60\u7684\u7ED3\u8BBA\u5462\uFF1F\r\n25\r\n\u90A3\u6709\u4EC0\u4E48\u7ED3\u8BBA\uFF01\u8FD9\u516D\u4EF6\u4E1C\u897F\uFF0C\u65E9\u5728\u516B\u767E\u5E74\u524D\u5C31\u4E0D\u77E5\u9053\u90FD\u5931\u843D\u90FD\u54EA\u91CC\u53BB\u4E86\uFF0C\u800C\u5F53\u6211\u5F00\u59CB\u8BD5\u56FE\u8981\u5BFB\u627E\u5B83\u4EEC\u7684\u8E2A\u8FF9\u65F6\uFF0C\u9ED1\u6697\u519B\u5C31\u5BF9\u4E9A\u8FF0\u68EE\u6797\u53D1\u52A8\u4E86\u653B\u51FB\uFF0C\u6211\u53EA\u597D\u5148\u4E2D\u65AD\u4E86\u8FD9\u6BB5\u7814\u7A76\u3002\r\n21\r\n\u6211\u4E00\u76F4\u76F8\u4FE1\u5929\u7A7A\u4E4B\u94A5\u548C\u8FD9\u4E00\u8FDE\u4E32\u4E8B\u7AEF\u6709\u5173\uFF0C\u65E2\u7136\u4F60\u6682\u65F6\u65E0\u6CD5\u5B8C\u6210\u7814\u7A76\uFF0C\u8FD9\u4E2A\u63E3\u6D4B\u4E5F\u5C31\u53EA\u597D\u4F5C\u7F62\uFF0C\u6211\u4EEC\u5F97\u6362\u4E00\u4E2A\u65B0\u7684\u8C03\u67E5\u65B9\u5411....\r\n1\r\n\u7B49\u7B49\uFF01\u5E0C\u5C14\u6CD5\u5927\u5E08\uFF0C\u4F60\u6240\u8BF4\u7684\u5FBD\u7AE0\u548C\u5B9D\u77F3\uFF0C\u662F\u4E0D\u662F\u8FD9\u4E9B\uFF1F\r\n25\r\n\u554A\uFF01\u8574\u542B\u5149\u3001\u6697\u3001\u706B\u7130\u3001\u51B0\u548C\u661F\u661F\u4E4B\u529B\u7684\u4E94\u9897\u5B9D\u77F3....\u5C31\u662F\u8FD9\u4E2A\u6CA1\u9519\uFF01\u4F60\u4EEC\u600E\u4E48\u627E\u5230\u8FD9\u4E9B\u4E1C\u897F\u7684\uFF1F\r\n1\r\n\u4E00\u8DEF\u4E0A\u9010\u4E00\u5F97\u6765\u7684\uFF0C\u654C\u4EBA\u4F3C\u4E4E\u4E5F\u5BF9\u4ED6\u4EEC\u611F\u5174\u8DA3\uFF0C\u6240\u4EE5\u5176\u4E2D\u51E0\u4E2A\u8D39\u4E86\u597D